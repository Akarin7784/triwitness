diff --git a/tests/tw_repro/test_issue_tqdm_class_disable.py b/tests/tw_repro/test_issue_tqdm_class_disable.py
new file mode 100644
index 0000000..f59fe18
--- /dev/null
+++ b/tests/tw_repro/test_issue_tqdm_class_disable.py
@@ -0,0 +1,142 @@
+"""Repro for: custom `tqdm_class` silently disabled in non-TTY environments.
+
+`_get_progress_bar_context` used to forward `disable=None` to a user-provided
+`tqdm_class`, which lets tqdm auto-detect a non-TTY stderr and turn `update()`
+into a no-op. Passing a custom class must not be silently disabled.
+"""
+
+import io
+import logging
+import sys
+from contextlib import contextmanager
+from pathlib import Path
+from unittest.mock import Mock, patch
+
+from tqdm.auto import tqdm as base_tqdm
+
+from huggingface_hub import hf_hub_download
+from huggingface_hub.file_download import HfFileMetadata
+from huggingface_hub.utils import disable_progress_bars, enable_progress_bars
+from huggingface_hub.utils import tqdm as hf_tqdm
+from huggingface_hub.utils.tqdm import _get_progress_bar_context
+
+
+class NonTTYStderr(io.StringIO):
+    """A stderr replacement that reports itself as non-TTY (Docker, server, thread, ...)."""
+
+    def isatty(self) -> bool:
+        return False
+
+
+class RecordingTqdm(base_tqdm):
+    """Custom tqdm class as a user would provide it."""
+
+    def __init__(self, *args, **kwargs):
+        kwargs.pop("name", None)  # hf-specific kwarg
+        super().__init__(*args, **kwargs)
+        self.updates = []
+        # `tqdm.close()` flips `disable` to True, so record the state seen by `update()`.
+        self.disable_states = []
+
+    def update(self, n=1):
+        self.disable_states.append(self.disable)
+        super().update(n)
+        self.updates.append(n)
+
+
+def test_custom_tqdm_class_is_not_disabled_in_non_tty_env(monkeypatch):
+    """`tqdm_class` means "track progress my way" => must not be disabled by TTY detection."""
+    monkeypatch.setattr(sys, "stderr", NonTTYStderr())
+
+    with _get_progress_bar_context(
+        desc="file.bin",
+        log_level=logging.WARNING,
+        total=10,
+        tqdm_class=RecordingTqdm,
+    ) as pbar:
+        pbar.update(5)
+
+        assert pbar.disable is False
+        assert pbar.disable_states == [False]
+        assert pbar.updates == [5]
+        assert pbar.n == 5
+
+
+def test_default_tqdm_still_auto_disabled_in_non_tty_env(monkeypatch):
+    """Without a custom class, the TTY auto-detection behaviour must be preserved."""
+    monkeypatch.setattr(sys, "stderr", NonTTYStderr())
+
+    with _get_progress_bar_context(desc="file.bin", log_level=logging.WARNING, total=10) as pbar:
+        pbar.update(5)
+
+        assert pbar.disable is True
+        assert pbar.n == 0
+
+
+def test_hf_hub_download_with_custom_tqdm_class_in_non_tty_env(monkeypatch, tmp_path: Path):
+    """End-to-end: `hf_hub_download(tqdm_class=...)` must report real progress outside a TTY."""
+    monkeypatch.setattr(sys, "stderr", NonTTYStderr())
+
+    created_bars: list[RecordingTqdm] = []
+
+    class DownloadProgress(RecordingTqdm):
+        def __init__(self, *args, **kwargs):
+            super().__init__(*args, **kwargs)
+            created_bars.append(self)
+
+    response = Mock()
+    response.status_code = 200
+    response.headers = {"Content-Length": "10"}
+    response.iter_bytes.return_value = iter([b"0123456789"])
+
+    @contextmanager
+    def _mock_stream(*args, **kwargs):
+        yield response
+
+    metadata = HfFileMetadata(
+        commit_hash="a" * 40,
+        etag="etag",
+        location="https://cdn-lfs.hf.co/file.bin",
+        size=10,
+        xet_file_data=None,
+    )
+
+    with (
+        patch("huggingface_hub.file_download.get_hf_file_metadata", return_value=metadata),
+        patch("huggingface_hub.file_download.http_stream_backoff", _mock_stream),
+    ):
+        filepath = hf_hub_download("user/repo", "file.bin", cache_dir=tmp_path, tqdm_class=DownloadProgress)
+
+    assert Path(filepath).read_bytes() == b"0123456789"
+    assert created_bars, "custom tqdm_class was never instantiated"
+    assert any(bar.updates for bar in created_bars), f"update() was never called: {created_bars}"
+    assert all(state is False for bar in created_bars for state in bar.disable_states)
+    assert sum(n for bar in created_bars for n in bar.updates) == 10
+
+
+def test_custom_tqdm_class_inheriting_hf_tqdm_still_respects_global_disable(monkeypatch):
+    """A custom class based on `huggingface_hub.utils.tqdm` keeps honoring `disable_progress_bars()`."""
+    monkeypatch.setattr(sys, "stderr", NonTTYStderr())
+    disable_progress_bars()
+    try:
+
+        class MyProgress(hf_tqdm):
+            def __init__(self, *args, **kwargs):
+                super().__init__(*args, **kwargs)
+                self.disable_states = []
+
+            def update(self, n=1):
+                self.disable_states.append(self.disable)
+                super().update(n)
+
+        with _get_progress_bar_context(
+            desc="file.bin",
+            log_level=logging.WARNING,
+            total=10,
+            tqdm_class=MyProgress,
+        ) as pbar:
+            pbar.update(5)
+            assert pbar.disable is True
+            assert pbar.n == 0
+    finally:
+        enable_progress_bars()
