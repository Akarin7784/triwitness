+"""
+Reproduction for: "template_loader blocks on STATICFILES_DIRS if there are tuples"
+
+Django allows entries of `STATICFILES_DIRS` to be tuples/lists of `(prefix, path)`.
+`django_components.template_loader.Loader.get_dirs()` must use the *second* item
+(the path) of such entries instead of raising
+`TypeError: expected str, bytes or os.PathLike object, not tuple`.
+"""
+
+from pathlib import Path
+
+from django.template.engine import Engine
+from django.test import override_settings
+
+# isort: off
+from tests.django_test_setup import settings  # noqa: F401  (sets up Django settings)
+from tests.testutils import BaseTestCase
+
+# isort: on
+
+from django_components.template_loader import Loader
+
+TESTS_DIR = Path(__file__).parent.parent.resolve()
+COMPONENTS_DIR = TESTS_DIR / "components"
+
+
+class TestStaticfilesDirsTuples(BaseTestCase):
+    """`STATICFILES_DIRS` may contain (prefix, path) tuples or lists."""
+
+    def test_tuple_entry(self):
+        with override_settings(
+            BASE_DIR=TESTS_DIR,
+            STATICFILES_DIRS=[("downloads", "components")],
+        ):
+            dirs = Loader(Engine.get_default()).get_dirs()
+
+        self.assertEqual(sorted(dirs), sorted([COMPONENTS_DIR]))
+
+    def test_list_entry(self):
+        with override_settings(
+            BASE_DIR=TESTS_DIR,
+            STATICFILES_DIRS=[["downloads", "components"]],
+        ):
+            dirs = Loader(Engine.get_default()).get_dirs()
+
+        self.assertEqual(sorted(dirs), sorted([COMPONENTS_DIR]))
+
+    def test_tuple_entry_with_path(self):
+        """The path part of a tuple entry may also be a `Path` object."""
+        with override_settings(
+            BASE_DIR=TESTS_DIR,
+            STATICFILES_DIRS=[("downloads", Path("components"))],
+        ):
+            dirs = Loader(Engine.get_default()).get_dirs()
+
+        self.assertEqual(sorted(dirs), sorted([COMPONENTS_DIR]))
+
+    def test_tuple_entry_absolute_path(self):
+        """Absolute paths are supported too."""
+        with override_settings(
+            BASE_DIR=TESTS_DIR,
+            STATICFILES_DIRS=[("downloads", str(COMPONENTS_DIR))],
+        ):
+            dirs = Loader(Engine.get_default()).get_dirs()
+
+        self.assertEqual(sorted(dirs), sorted([COMPONENTS_DIR]))
+
+    def test_mixed_entries(self):
+        """String and tuple entries may be mixed together."""
+        with override_settings(
+            BASE_DIR=TESTS_DIR,
+            STATICFILES_DIRS=[
+                "components",
+                ("downloads", "components"),
+            ],
+        ):
+            dirs = Loader(Engine.get_default()).get_dirs()
+
+        self.assertEqual(sorted(dirs), sorted([COMPONENTS_DIR]))
+
+    def test_str_entry_still_works(self):
+        """Plain string entries keep working (regression check)."""
+        with override_settings(
+            BASE_DIR=TESTS_DIR,
+            STATICFILES_DIRS=["components"],
+        ):
+            dirs = Loader(Engine.get_default()).get_dirs()
+
+        self.assertEqual(sorted(dirs), sorted([COMPONENTS_DIR]))
