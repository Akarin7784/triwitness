+def format_record(precomputed_format, formatter_record):
+    try:
+        return precomputed_format.format_map(formatter_record)
+    except KeyError as error:
+        raise KeyError(_format_key_error_message(error, formatter_record)) from None
+
+
+def _format_key_error_message(error, formatter_record):
+    key = error.args[0] if error.args else None
+
+    available_keys = ", ".join(str(k) for k in formatter_record)
+
+    message = (
+        "Invalid format key: %r. The format string refers to a log record key which does not "
+        "exist. Available record keys are: %s. Extra values can be added to the record with "
+        "'logger.bind(key=value)' and then referenced as '{extra[key]}' in the format string"
+        % (key, available_keys)
+    )
+
+    if isinstance(key, str) and key.isidentifier():
+        message += (
+            " (for example: 'logger.bind(%s=...)' and then '{extra[%s]}')" % (key, key)
+        )
+
+    return message + "."
+
