diff --git a/tests/tw_repro/test_issue_invalid_format_key.py b/tests/tw_repro/test_issue_invalid_format_key.py
new file mode 100644
index 0000000..2f3d693
--- /dev/null
+++ b/tests/tw_repro/test_issue_invalid_format_key.py
@@ -0,0 +1,78 @@
+import pytest
+
+from loguru import logger
+
+
+def test_missing_format_key_raises_key_error_with_guidance(writer):
+    logger.add(writer, format="{nonexistent}", catch=False)
+
+    with pytest.raises(KeyError) as excinfo:
+        logger.info("Hello world")
+
+    message = str(excinfo.value)
+
+    assert "nonexistent" in message
+    assert "Invalid format key" in message
+    assert "logger.bind(key=value)" in message
+    assert "extra[key]" in message
+    assert writer.read() == ""
+
+
+def test_missing_format_key_diagnostic_with_catch(capsys, writer):
+    logger.add(writer, format="{nonexistent}", catch=True)
+
+    logger.info("Hello world")
+
+    out, err = capsys.readouterr()
+
+    assert out == ""
+    assert writer.read() == ""
+    assert "--- Logging error in Loguru Handler #0 ---" in err
+    assert "Invalid format key: 'nonexistent'" in err
+    assert "logger.bind(key=value)" in err
+    assert "extra[key]" in err
+
+    for key in ("elapsed", "exception", "extra", "file", "level", "message"):
+        assert key in err
+
+
+def test_available_keys_in_raised_error(writer):
+    logger.add(writer, format="{nonexistent}", catch=False)
+
+    with pytest.raises(KeyError) as excinfo:
+        logger.info("Hello world")
+
+    message = str(excinfo.value)
+
+    for key in ("elapsed", "exception", "extra", "file", "level", "message"):
+        assert key in message
+
+
+def test_missing_extra_key_gives_guidance(writer):
+    logger.add(writer, format="{extra[nonexistent]}", catch=False)
+
+    with pytest.raises(KeyError) as excinfo:
+        logger.info("Hello world")
+
+    message = str(excinfo.value)
+
+    assert "nonexistent" in message
+    assert "logger.bind" in message
+    assert "extra[key]" in message
+
+
+def test_format_key_added_by_patcher(writer):
+    def patcher(record):
+        record["custom"] = "patched"
+
+    logger.add(writer, format="{custom} {message}", catch=False)
+    logger.patch(patcher).info("Hello world")
+
+    assert writer.read() == "patched Hello world\n"
+
+
+def test_bind_value_can_be_referenced(writer):
+    logger.add(writer, format="{extra[nonexistent]} {message}", catch=False)
+    logger.bind(nonexistent="bound").info("Hello world")
+
+    assert writer.read() == "bound Hello world\n"
