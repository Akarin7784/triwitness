@@ -0,0 +1,59 @@
+"""Reproduction tests for FORCE_COLOR support (https://force-color.org/).
+
+The ``FORCE_COLOR`` environment variable must force colorization to be enabled
+even when the sink is not connected to a terminal (non-TTY environment).
+"""
+
+import os
+
+import pytest
+
+from loguru import logger
+from loguru._colorama import should_colorize
+
+from ..conftest import StreamIsattyFalse, StreamIsattyTrue, parse
+
+
+@pytest.mark.parametrize("stream", [StreamIsattyTrue(), StreamIsattyFalse()])
+def test_force_color_enables_colorization(monkeypatch, stream):
+    with monkeypatch.context() as context:
+        context.setitem(os.environ, "FORCE_COLOR", "1")
+        assert should_colorize(stream) is True
+
+
+def test_force_color_enables_colorization_for_non_tty(monkeypatch):
+    stream = StreamIsattyFalse()
+    with monkeypatch.context() as context:
+        context.setitem(os.environ, "FORCE_COLOR", "1")
+        logger.add(stream, format="<blue>{message}</blue>", colorize=None)
+        logger.debug("Message")
+        assert stream.getvalue() == parse("<blue>Message</blue>\n")
+
+
+def test_force_color_present_with_any_value(monkeypatch):
+    for value in ["", "1", "true", "0"]:
+        with monkeypatch.context() as context:
+            context.setitem(os.environ, "FORCE_COLOR", value)
+            assert should_colorize(StreamIsattyFalse()) is True
+
+
+def test_without_force_color_non_tty_is_not_colorized(monkeypatch):
+    with monkeypatch.context() as context:
+        context.delitem(os.environ, "FORCE_COLOR", raising=False)
+        assert should_colorize(StreamIsattyFalse()) is False
+
+
+def test_no_color_takes_precedence_over_force_color(monkeypatch):
+    with monkeypatch.context() as context:
+        context.setitem(os.environ, "FORCE_COLOR", "1")
+        context.setitem(os.environ, "NO_COLOR", "1")
+        assert should_colorize(StreamIsattyFalse()) is False
+
+
+def test_explicit_colorize_argument_overrides_force_color(monkeypatch):
+    stream = StreamIsattyFalse()
+    with monkeypatch.context() as context:
+        context.setitem(os.environ, "FORCE_COLOR", "1")
+        logger.add(stream, format="<blue>{message}</blue>", colorize=False)
+        logger.debug("Message")
+        assert stream.getvalue() == "Message\n"
