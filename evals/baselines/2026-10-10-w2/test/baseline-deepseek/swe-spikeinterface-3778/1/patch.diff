+def _get_promoted_dtype(dtype_1, dtype_2):
+    """
+    Find a common dtype for two properties of different sortings.
+
+    Some dtypes are not strictly equal but can still be safely merged, the typical example being strings
+    of different lengths ("<U2" vs "<U4"), which are both unicode strings (kind "U").
+
+    Returns None when the two dtypes cannot be merged.
+    """
+    if dtype_1 == dtype_2:
+        return dtype_1
+
+    # only dtypes of the same kind can be merged (e.g. we don't want to mix strings and numbers)
+    if dtype_1.kind != dtype_2.kind:
+        return None
+
+    try:
+        return np.promote_types(dtype_1, dtype_2)
+    except TypeError:
+        return None
+
