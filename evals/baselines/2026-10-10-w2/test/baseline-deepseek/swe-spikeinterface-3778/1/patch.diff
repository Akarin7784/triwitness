@@ -0,0 +1,74 @@
+"""
+Repro for the issue: `aggregate_units` doesn't propagate properties when string lengths don't match.
+
+The dtype of a string property is f"U{n}" where n is the max length of the strings of the property.
+When two sortings have the same property whose strings have different lengths, the two dtypes are
+different ("<U4" vs "<U2") and the property was silently dropped during the aggregation.
+"""
+
+import numpy as np
+
+from spikeinterface.core import aggregate_units, generate_sorting
+
+
+def test_aggregate_units_propagates_string_property_with_different_lengths():
+    sorting1 = generate_sorting(num_units=2, seed=1205)
+    sorting1.set_property("chris_label", ["good"] * sorting1.get_num_units())
+
+    sorting2 = generate_sorting(num_units=3, seed=1205)
+    sorting2.set_property("chris_label", ["ok"] * sorting2.get_num_units())
+
+    # the dtypes are different because the strings have different lengths
+    assert sorting1.get_property("chris_label").dtype == np.dtype("<U4")
+    assert sorting2.get_property("chris_label").dtype == np.dtype("<U2")
+
+    aggregated_sorting = aggregate_units([sorting1, sorting2])
+
+    assert "chris_label" in aggregated_sorting.get_property_keys()
+    values = aggregated_sorting.get_property("chris_label")
+    assert values.dtype == np.dtype("<U4")
+    assert list(values) == ["good", "good", "ok", "ok", "ok"]
+
+
+def test_aggregate_units_propagates_string_property_issue_example():
+    """Same as above but with the exact snippet from the issue."""
+    import spikeinterface.full as si
+
+    rec, sort1 = si.generate_ground_truth_recording(
+        num_channels=4,
+        num_units=2,
+        seed=1205,
+    )
+    sort1.set_property("chris_label", ["good"] * sort1.get_num_units())
+
+    _, sort2 = si.generate_ground_truth_recording(
+        num_channels=4,
+        num_units=3,
+        seed=1205,
+    )
+    sort2.set_property("chris_label", ["ok"] * sort2.get_num_units())
+
+    sort = si.aggregate_units([sort1, sort2])
+
+    assert "chris_label" in sort.get_property_keys()
+    assert list(sort.get_property("chris_label")) == ["good", "good", "ok", "ok", "ok"]
+
+
+def test_aggregate_units_promotes_string_dtype_when_longest_string_comes_last():
+    sorting1 = generate_sorting(num_units=2, seed=1205)
+    sorting1.set_property("chris_label", ["ok"] * sorting1.get_num_units())
+
+    sorting2 = generate_sorting(num_units=3, seed=1205)
+    sorting2.set_property("chris_label", ["good"] * sorting2.get_num_units())
+
+    aggregated_sorting = aggregate_units([sorting1, sorting2])
+
+    values = aggregated_sorting.get_property("chris_label")
+    assert values.dtype == np.dtype("<U4")
+    assert list(values) == ["ok", "ok", "good", "good", "good"]
+
+
+if __name__ == "__main__":
+    test_aggregate_units_propagates_string_property_with_different_lengths()
+    test_aggregate_units_propagates_string_property_issue_example()
+    test_aggregate_units_promotes_string_dtype_when_longest_string_comes_last()
