+# limitations under the License.
+
+"""
+Reproduction for the ``allowed_host_paths`` symlink bypass.
+
+A symlink created inside a whitelisted host path can point at the host root
+``/``; the lexical validation in ``ensure_valid_host_path`` used to accept it
+because the requested path starts with the whitelisted prefix, while Docker
+resolves the link when performing the bind mount.  Both the validator and the
+Docker-specific host volume validation must reject such a request.
+"""
+
+import os
+
+import pytest
+from fastapi import HTTPException
+
+from opensandbox_server.api.schema import Host, Volume
+from opensandbox_server.services.constants import SandboxErrorCodes
+from opensandbox_server.services.docker import DockerSandboxService
+from opensandbox_server.services.validators import ensure_valid_host_path
+
+
+def _make_escape_symlink(tmp_path):
+    """Create ``<allowed>/escape -> /`` and return (allowed, symlink path)."""
+    allowed = tmp_path / "allowed"
+    allowed.mkdir()
+    escape = allowed / "escape"
+    os.symlink("/", escape)
+    return allowed, escape
+
+
+def test_ensure_valid_host_path_rejects_symlink_in_allowed_prefix(tmp_path):
+    """A symlink inside a whitelisted prefix must be rejected."""
+    allowed, escape = _make_escape_symlink(tmp_path)
+
+    with pytest.raises(HTTPException) as exc_info:
+        ensure_valid_host_path(str(escape), [str(allowed)])
+
+    assert exc_info.value.status_code == 400
+    assert "symlink" in exc_info.value.detail["message"]
+    assert "symbolic link" in exc_info.value.detail["message"]
+
+
+def test_ensure_valid_host_path_rejects_intermediate_symlink(tmp_path):
+    """A symlink in an intermediate component must be rejected too."""
+    allowed, escape = _make_escape_symlink(tmp_path)
+
+    with pytest.raises(HTTPException) as exc_info:
+        ensure_valid_host_path(str(escape / "etc"), [str(allowed)])
+
+    assert exc_info.value.status_code == 400
+    assert exc_info.value.detail["code"] == SandboxErrorCodes.INVALID_HOST_PATH
+
+
+def test_ensure_valid_host_path_rejects_symlink_without_allowlist(tmp_path):
+    """Symbolic links are rejected even when no allowlist is configured."""
+    _, escape = _make_escape_symlink(tmp_path)
+
+    with pytest.raises(HTTPException) as exc_info:
+        ensure_valid_host_path(str(escape))
+
+    assert exc_info.value.status_code == 400
+    assert exc_info.value.detail["code"] == SandboxErrorCodes.INVALID_HOST_PATH
+
+
+def test_ensure_valid_host_path_still_accepts_real_paths(tmp_path):
+    """Regular (non-symlink) paths under an allowed prefix keep working."""
+    allowed = tmp_path / "allowed"
+    (allowed / "user-a").mkdir(parents=True)
+
+    assert ensure_valid_host_path(str(allowed / "user-a"), [str(allowed)]) is None
+    # Not-yet-existing directories are allowed as well
+    assert ensure_valid_host_path(str(allowed / "to-be-created"), [str(allowed)]) is None
+
+
+def test_validate_host_volume_rejects_symlink_escape(tmp_path):
+    """``_validate_host_volume`` must not accept a symlink escaping the allowlist."""
+    allowed, escape = _make_escape_symlink(tmp_path)
+
+    volume = Volume(
+        name="workdir",
+        host=Host(path=str(escape)),
+        mount_path="/mnt/work",
+        read_only=False,
+    )
+
+    with pytest.raises(HTTPException) as exc_info:
+        DockerSandboxService._validate_host_volume(volume, [str(allowed)])
+
+    assert exc_info.value.status_code == 400
+    assert exc_info.value.detail["code"] == SandboxErrorCodes.HOST_PATH_NOT_ALLOWED
+
+
+def test_validate_host_volume_accepts_real_path(tmp_path):
+    """A real host directory under an allowed prefix stays valid."""
+    allowed = tmp_path / "allowed"
+    allowed.mkdir()
+
+    volume = Volume(
+        name="workdir",
+        host=Host(path=str(allowed)),
+        mount_path="/mnt/work",
+        read_only=False,
+    )
+
+    assert DockerSandboxService._validate_host_volume(volume, [str(allowed)]) is None
+
+
+@pytest.mark.asyncio
+async def test_create_sandbox_rejects_symlink_mount(tmp_path, monkeypatch):
+    """End-to-end: a mount request going through a symlink is rejected."""
+    from unittest.mock import MagicMock
+
+    from opensandbox_server.api.schema import (
+        CreateSandboxRequest,
+        ImageSpec,
+        ResourceLimits,
+    )
+    from opensandbox_server.config import AppConfig, RuntimeConfig, ServerConfig, StorageConfig
+    from opensandbox_server.services import docker as docker_module
+
+    mock_client = MagicMock()
+    mock_client.containers.list.return_value = []
+    monkeypatch.setattr(docker_module.docker, "from_env", lambda: mock_client)
+
+    _, escape = _make_escape_symlink(tmp_path)
+
+    cfg = AppConfig(
+        server=ServerConfig(),
+        runtime=RuntimeConfig(type="docker", execd_image="ghcr.io/opensandbox/platform:latest"),
+    )
+    cfg.storage = StorageConfig(allowed_host_paths=[str(tmp_path / "allowed")])
+    service = DockerSandboxService(config=cfg)
+
+    request = CreateSandboxRequest(
+        image=ImageSpec(uri="python:3.11"),
+        timeout=120,
+        resourceLimits=ResourceLimits(root={}),
+        env={},
+        metadata={},
+        entrypoint=["python"],
+        volumes=[
+            Volume(
+                name="workdir",
+                host=Host(path=str(escape)),
+                mount_path="/mnt/work",
+                read_only=False,
+            )
+        ],
+    )
+
+    with pytest.raises(HTTPException) as exc_info:
+        await service.create_sandbox(request)
+
+    assert exc_info.value.status_code == 400
