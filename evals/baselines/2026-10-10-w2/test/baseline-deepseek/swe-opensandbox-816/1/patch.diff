+def _path_prefixes(path: str) -> List[str]:
+    """
+    Return every non-empty path prefix of ``path``, from the root downwards.
+
+    The returned list contains each intermediate component path plus the full
+    path itself, e.g. ``/a/b/c`` -> ``["/a", "/a/b", "/a/b/c"]``.  Windows
+    drive prefixes are preserved (``D:/a/b`` -> ``["D:/a", "D:/a/b"]``) so the
+    helper behaves consistently regardless of the OS the server runs on.
+    """
+    separator = "\\" if os.sep == "\\" else "/"
+    # Normalize separators for the current platform so Windows-style request
+    # paths can be walked on Windows (and vice versa; on POSIX a Windows-style
+    # path simply never matches a real symlink, which is the safe default).
+    normalized = os.path.normpath(path.replace("\\" if separator == "/" else "/", separator))
+    drive, tail = os.path.splitdrive(normalized)
+    prefix = drive
+    if tail.startswith(separator):
+        prefix = f"{prefix}{separator}"
+        tail = tail[len(separator):]
+
+    prefixes: List[str] = []
+    for part in tail.split(separator):
+        if not part or part == ".":
+            continue
+        prefix = os.path.join(prefix, part)
+        prefixes.append(prefix)
+    return prefixes
+
+
+def _first_symlink_component(path: str) -> Optional[str]:
+    """
+    Return the first path component of ``path`` that is a symbolic link.
+
+    Every intermediate component is inspected (not only the final one) because
+    a symlink anywhere in the path is followed by the container runtime when a
+    bind mount is created.  Components that do not exist yet are not symlinks
+    and are therefore accepted — host paths may legitimately be created on
+    demand.
+
+    Args:
+        path: Host path to inspect.
+
+    Returns:
+        The offending component path, or ``None`` when no symlink is present.
+    """
+    for prefix in _path_prefixes(path):
+        try:
+            if os.path.islink(prefix):
+                return prefix
+        except OSError:
+            # Unreadable component: treat as non-symlink; the caller's other
+            # checks (and the runtime's own errors) still apply.
+            continue
+    return None
+
+
