+++ b/tests/tw_repro/test_issue_2612.py
@@ -0,0 +1,196 @@
+"""Reproduction tests for the issue "`/tmp/copier._vcs.clone...` directories are
+not being deleted after a failed update".
+
+Two distinct leaks are covered:
+
+1. When cloning a template fails halfway through (invalid ref, network error,
+   ...), the temporary clone created by `copier.vcs.clone` used to be left
+   behind forever.
+2. When Copier is terminated by a signal such as `SIGTERM` (e.g. a CI job being
+   cancelled), none of the temporary directories created during an update were
+   removed.
+"""
+
+from __future__ import annotations
+
+import os
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+import pytest
+
+from copier.vcs import clone
+
+GIT_ENV = {
+    "GIT_AUTHOR_NAME": "Copier",
+    "GIT_AUTHOR_EMAIL": "copier@example.com",
+    "GIT_COMMITTER_NAME": "Copier",
+    "GIT_COMMITTER_EMAIL": "copier@example.com",
+}
+
+
+def _git(*args: str, cwd: Path) -> None:
+    subprocess.run(["git", *args], cwd=cwd, env={**os.environ, **GIT_ENV}, check=True)
+
+
+def _init_repo(path: Path) -> None:
+    _git("init", "--initial-branch=main", cwd=path)
+    _git("add", "-A", cwd=path)
+    _git("commit", "-m", "commit", cwd=path)
+
+
+def _leftovers(tmp: Path) -> list[Path]:
+    return sorted(tmp.iterdir())
+
+
+def test_failed_clone_removes_temp_dir(
+    tmp_path_factory: pytest.TempPathFactory,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """A failing clone must not leave `/tmp/copier._vcs.clone.*` behind."""
+    tmp = tmp_path_factory.mktemp("tmp")
+    template = tmp_path_factory.mktemp("template")
+    (template / "copier.yml").write_text("favorite_app: Copier\n")
+    _init_repo(template)
+
+    # Isolate the system temporary directory so we can assert it stays clean.
+    monkeypatch.setattr("tempfile.tempdir", str(tmp))
+
+    with pytest.raises(Exception):
+        # `v2` doesn't exist: the clone succeeds but the checkout fails.
+        clone(str(template), "v2")
+
+    assert _leftovers(tmp) == []
+
+
+@pytest.mark.skipif(sys.platform == "win32", reason="needs POSIX signals & sleep")
+def test_sigterm_during_update_removes_temp_dirs(
+    tmp_path_factory: pytest.TempPathFactory,
+) -> None:
+    """Temporary directories must disappear when the process is killed."""
+    root = tmp_path_factory.mktemp("sigterm")
+    tmp = root / "tmp"
+    tmp.mkdir()
+    template = root / "template"
+    dst = root / "dst"
+    template.mkdir()
+    dst.mkdir()
+
+    # v1: a plain template.
+    (template / "copier.yml").write_text("favorite_app: Copier\n")
+    (template / "fav.txt.jinja").write_text("{{ favorite_app }}\n")
+    (template / "{{ _copier_conf.answers_file }}.jinja").write_text(
+        "{{ _copier_answers|to_nice_yaml }}\n"
+    )
+    _init_repo(template)
+    _git("tag", "v1", cwd=template)
+
+    env = {**os.environ, "TMPDIR": str(tmp)}
+    subprocess.run(
+        [
+            sys.executable,
+            "-m",
+            "copier",
+            "copy",
+            "--defaults",
+            "--quiet",
+            "--vcs-ref=v1",
+            "--trust",
+            "--unsafe",
+            str(template),
+            str(dst),
+        ],
+        env=env,
+        check=True,
+    )
+    _init_repo(dst)
+
+    # v2: the running task gives us time to kill Copier mid-update.
+    (template / "copier.yml").write_text("favorite_app: Copier\n_tasks:\n  - sleep 30\n")
+    (template / "v2").write_text("true\n")
+    _git("add", "-A", cwd=template)
+    _git("commit", "-m", "v2", cwd=template)
+    _git("tag", "v2", cwd=template)
+
+    process = subprocess.Popen(
+        [
+            sys.executable,
+            "-m",
+            "copier",
+            "update",
+            "--defaults",
+            "--quiet",
+            "--trust",
+            "--unsafe",
+            str(dst),
+        ],
+        env=env,
+    )
+    try:
+        # Wait until the update created its temporary directories.
+        deadline = time.monotonic() + 30
+        while time.monotonic() < deadline:
+            if any(tmp.glob("copier._vcs.clone.*")):
+                break
+            if process.poll() is not None:
+                msg = "Copier exited before we could interrupt it"
+                raise AssertionError(msg)
+            time.sleep(0.05)
+        else:
+            raise AssertionError("Copier never created a temporary clone")
+        process.send_signal(signal.SIGTERM)
+        process.wait(timeout=30)
+    finally:
+        if process.poll() is None:  # pragma: no cover
+            process.kill()
+            process.wait()
+
+    assert _leftovers(tmp) == []
+
+
+def test_temp_dir_cleaned_on_normal_exit(tmp_path_factory: pytest.TempPathFactory) -> None:
+    """Registered temporary directories are removed on interpreter exit."""
+    tmp = tmp_path_factory.mktemp("tmp")
+    script = (
+        "import sys\n"
+        "from pathlib import Path\n"
+        "from copier import vcs\n"
+        f"directory = vcs.clone({str(tmp)!r})" if False else ""
+    )
+    # Sanity check that the helper is importable and usable from a script.
+    script = (
+        "import subprocess, sys\n"
+        "from pathlib import Path\n"
+        "from copier._tools import cleanup_temp_dirs, register_temp_dir\n"
+        f"tmp = Path({str(tmp)!r})\n"
+        "path = tmp / 'leaked'\n"
+        "path.mkdir()\n"
+        "register_temp_dir(path)\n"
+        "assert path.exists()\n"
+    )
+    subprocess.run([sys.executable, "-c", script], check=True)
+    assert not (tmp / "leaked").exists()
+
+
+def test_temp_dir_signal_signature() -> None:
+    """The signal handler must clean up and re-raise the signal."""
+    # Just make sure the public helpers exist with a stable name.
+    from copier._tools import (  # noqa: PLC0415
+        cleanup_temp_dirs,
+        register_temp_dir,
+        remove_temp_dir,
+        temp_dir,
+    )
+
+    assert callable(cleanup_temp_dirs)
+    assert callable(register_temp_dir)
+    assert callable(remove_temp_dir)
+    assert callable(temp_dir)
+
+
+def test_tempfile_module_still_isolated() -> None:
+    assert tempfile.gettempdir()
