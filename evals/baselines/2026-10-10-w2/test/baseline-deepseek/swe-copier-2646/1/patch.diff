+_temp_dirs: set[Path] = set()
+"""Temporary directories that Copier must always remove."""
+
+_temp_dirs_lock = threading.Lock()
+
+_previous_signal_handlers: dict[int, Any] = {}
+
+_atexit_registered = False
+
+_signal_handlers_installed = False
+
+
+def _remove_temp_dir(path: Path) -> None:
+    """Remove a temporary directory, ignoring any error."""
+    with suppress(OSError):
+        if sys.version_info >= (3, 12):
+            rmtree(path, ignore_errors=False, onexc=handle_remove_readonly)
+        else:
+            rmtree(path, ignore_errors=False, onerror=handle_remove_readonly)
+
+
+def _signal_handler(signum: int, frame: FrameType | None) -> None:
+    """Remove temporary directories before the process dies from a signal."""
+    cleanup_temp_dirs()
+    previous = _previous_signal_handlers.get(signum)
+    if callable(previous):
+        previous(signum, frame)
+        return
+    # Restore the default handler and re-send the signal so that the process
+    # exits with the expected status code.
+    signal.signal(signum, signal.SIG_DFL)
+    os.kill(os.getpid(), signum)
+
+
+def _install_cleanup_handlers() -> None:
+    """Make sure registered temporary directories are always removed.
+
+    This registers an `atexit` hook and, when running in the main thread,
+    handlers for the termination signals that would otherwise kill the process
+    before `atexit` hooks get a chance to run.
+    """
+    global _atexit_registered, _signal_handlers_installed
+    if not _atexit_registered:
+        atexit.register(cleanup_temp_dirs)
+        _atexit_registered = True
+    if _signal_handlers_installed or (
+        threading.current_thread() is not threading.main_thread()
+    ):
+        return
+    _signal_handlers_installed = True
+    for name in ("SIGTERM", "SIGHUP"):
+        signum = getattr(signal, name, None)
+        if not isinstance(signum, int):
+            # Signal not available on this platform (e.g. SIGHUP on Windows).
+            continue
+        previous = signal.getsignal(signum)
+        if previous is not signal.SIG_DFL:
+            # Never hijack a handler installed by the host process.
+            continue
+        _previous_signal_handlers[signum] = previous
+        with suppress(OSError, ValueError):
+            signal.signal(signum, _signal_handler)
+
+
+def register_temp_dir(path: str | Path) -> Path:
+    """Register a temporary directory so Copier always removes it.
+
+    Registered directories are removed on normal interpreter exit, and also when
+    the process is interrupted by a termination signal such as `SIGTERM`, so
+    that Copier never leaves garbage behind in the system temporary directory.
+
+    Args:
+        path: The temporary directory to register.
+
+    Returns:
+        The registered path, as a [Path][pathlib.Path].
+    """
+    result = Path(path)
+    with _temp_dirs_lock:
+        _temp_dirs.add(result)
+    _install_cleanup_handlers()
+    return result
+
+
+def remove_temp_dir(path: str | Path) -> None:
+    """Unregister a temporary directory and remove it from disk."""
+    result = Path(path)
+    with _temp_dirs_lock:
+        _temp_dirs.discard(result)
+    _remove_temp_dir(result)
+
+
+def cleanup_temp_dirs() -> None:
+    """Remove all registered temporary directories."""
+    with _temp_dirs_lock:
+        paths = list(_temp_dirs)
+        _temp_dirs.clear()
+    for path in paths:
+        _remove_temp_dir(path)
+
+
+@contextmanager
+def temp_dir(prefix: str | None = None) -> Iterator[Path]:
+    """Create a temporary directory that is always cleaned up.
+
+    Unlike [TemporaryDirectory][tempfile.TemporaryDirectory], this also works
+    when the process is killed by a termination signal.
+
+    Args:
+        prefix: Prefix used to create the temporary directory.
+
+    Yields:
+        The temporary directory, as a [Path][pathlib.Path].
+    """
+    path = register_temp_dir(mkdtemp(prefix=prefix))
+    try:
+        yield path
+    finally:
+        remove_temp_dir(path)
+
