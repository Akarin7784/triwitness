diff --git a/wip_repro/drive_fail.py b/wip_repro/drive_fail.py
new file mode 100644
index 0000000..63950c1
--- /dev/null
+++ b/wip_repro/drive_fail.py
@@ -0,0 +1,20 @@
+import marimo._ast.transformers as T
+
+_orig_init = T.CacheExtractWithBlock.__init__
+def patched_init(self, line, *a, **kw):
+    print("CacheExtractWithBlock target_line=", line)
+    return _orig_init(self, line, *a, **kw)
+T.CacheExtractWithBlock.__init__ = patched_init
+
+_orig_gv = T.ExtractWithBlock.generic_visit
+def gv(self, node):
+    print("generic_visit node types:", [type(n).__name__ + f"(L{n.lineno})" for n in node])
+    try:
+        return _orig_gv(self, node)
+    except T.BlockException as e:
+        print("  -> BlockException:", e)
+        raise
+T.ExtractWithBlock.generic_visit = gv
+
+import runpy
+runpy.run_path("cache_stuff.py", run_name="__main__")
