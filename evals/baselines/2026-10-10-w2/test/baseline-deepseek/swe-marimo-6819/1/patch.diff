+import marimo
+from marimo._ast.app import App
+
+def plain():
+    app = App()
+    app._anonymous_file = True
+    @app.cell
+    def one():
+        from marimo._save.save import persistent_cache
+        from tests._save.loaders.mocks import MockLoader
+        with persistent_cache(name="one", _loader=MockLoader()) as cache:
+            Y = 8
+        return
+    try:
+        app.run()
+        print("OK plain")
+    except Exception as e:
+        print("FAIL plain", type(e).__name__, e)
+
+def trailing():
+    app = App()
+    app._anonymous_file = True
+    @app.cell
+    def one():
+        from marimo._save.save import persistent_cache
+        from tests._save.loaders.mocks import MockLoader
+        with persistent_cache(name="one", _loader=MockLoader()) as cache:
+            Y = 8
+        Z = 3
+        return
+    try:
+        app.run()
+        print("OK trailing")
+    except Exception as e:
+        print("FAIL trailing", type(e).__name__, e)
+
+plain()
+trailing()
