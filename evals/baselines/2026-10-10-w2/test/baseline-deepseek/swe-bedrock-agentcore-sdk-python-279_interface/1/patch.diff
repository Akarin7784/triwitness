+class TestConfigurableContextTag:
+    """Tests for the configurable retrieved-memory context tag."""
+
+    def _run_retrieval(self, config, mock_memory_client, query="What are my preferences?"):
+        mock_memory_client.retrieve_memories.return_value = [{"content": {"text": "User likes sushi"}}]
+        manager = _create_session_manager(config, mock_memory_client)
+        mock_agent = Mock()
+        mock_agent.messages = [{"role": "user", "content": [{"text": query}]}]
+        event = MessageAddedEvent(agent=mock_agent, message={"role": "user", "content": [{"text": query}]})
+        manager.retrieve_customer_context(event)
+        return mock_agent
+
+    def test_default_tag_is_user_context(self, agentcore_config_with_retrieval, mock_memory_client):
+        """Retrieved memory is wrapped in <user_context> by default."""
+        mock_agent = self._run_retrieval(agentcore_config_with_retrieval, mock_memory_client)
+
+        injected = mock_agent.messages[-1]["content"][0]["text"]
+        assert injected.startswith("<user_context>User likes sushi")
+        assert injected.endswith("User likes sushi</user_context>")
+        assert "<retrieved_memory>" not in injected
+
+    def test_custom_tag(self, mock_memory_client):
+        """Retrieved memory uses the configured context_tag."""
+        config = AgentCoreMemoryConfig(
+            memory_id="test-memory-123",
+            session_id="test-session-456",
+            actor_id="test-actor-789",
+            retrieval_config={"user_preferences/{actorId}/": RetrievalConfig(top_k=5, relevance_score=0.3)},
+            context_tag="retrieved_memory",
+        )
+        mock_agent = self._run_retrieval(config, mock_memory_client)
+
+        injected = mock_agent.messages[-1]["content"][0]["text"]
+        assert injected == "<retrieved_memory>User likes sushi</retrieved_memory>"
+
+    def test_custom_tag_keeps_user_query_last(self, mock_memory_client):
+        """The user query remains the last content block when a custom tag is used."""
+        config = AgentCoreMemoryConfig(
+            memory_id="test-memory-123",
+            session_id="test-session-456",
+            actor_id="test-actor-789",
+            retrieval_config={"user_preferences/{actorId}/": RetrievalConfig(top_k=5, relevance_score=0.3)},
+            context_tag="my_memory",
+        )
+        mock_agent = self._run_retrieval(config, mock_memory_client, query="What do I like to eat?")
+
+        content = mock_agent.messages[-1]["content"]
+        assert len(content) == 2
+        assert content[0]["text"].startswith("<my_memory>")
+        assert content[0]["text"].endswith("</my_memory>")
+        assert content[1]["text"] == "What do I like to eat?"
