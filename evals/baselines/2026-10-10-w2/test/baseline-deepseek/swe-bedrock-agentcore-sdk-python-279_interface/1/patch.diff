new file mode 100644
index 0000000..a66abd3
--- /dev/null
+++ b/tests/tw_repro/test_issue_191.py
@@ -0,0 +1,84 @@
+"""Repro tests for the configurable memory context tag in AgentCoreMemorySessionManager.
+
+Issue: the `<user_context>` XML tag must remain the default (backwards compatibility)
+while users can opt in to another tag such as `<retrieved_memory>` via the new
+`context_tag` field on `AgentCoreMemoryConfig`.
+"""
+
+from unittest.mock import Mock, patch
+
+from strands.hooks import MessageAddedEvent
+
+from bedrock_agentcore.memory.integrations.strands.config import AgentCoreMemoryConfig, RetrievalConfig
+from bedrock_agentcore.memory.integrations.strands.session_manager import AgentCoreMemorySessionManager
+
+NAMESPACE = "user_preferences/{actorId}/"
+
+
+def _config(**kwargs):
+    params = {
+        "memory_id": "mem-123",
+        "session_id": "sess-456",
+        "actor_id": "actor-789",
+        "retrieval_config": {NAMESPACE: RetrievalConfig(top_k=5, relevance_score=0.3)},
+    }
+    params.update(kwargs)
+    return AgentCoreMemoryConfig(**params)
+
+
+def _run_retrieval(config, mock_memory_client, query="What are my preferences?"):
+    mock_memory_client.retrieve_memories.return_value = [{"content": {"text": "User likes sushi"}}]
+    with (
+        patch(
+            "bedrock_agentcore.memory.integrations.strands.session_manager.MemoryClient",
+            return_value=mock_memory_client,
+        ),
+        patch("boto3.Session") as mock_boto_session,
+        patch("strands.session.repository_session_manager.RepositorySessionManager.__init__", return_value=None),
+    ):
+        mock_session = Mock()
+        mock_session.region_name = "us-west-2"
+        mock_session.client.return_value = Mock()
+        mock_boto_session.return_value = mock_session
+
+        manager = AgentCoreMemorySessionManager(config)
+        agent = Mock()
+        agent.messages = [{"role": "user", "content": [{"text": query}]}]
+        event = MessageAddedEvent(agent=agent, message={"role": "user", "content": [{"text": query}]})
+        manager.retrieve_customer_context(event)
+        return agent
+
+
+def test_context_tag_default_value():
+    """AgentCoreMemoryConfig exposes context_tag defaulting to user_context."""
+    assert _config().context_tag == "user_context"
+
+
+def test_context_tag_can_be_overridden():
+    """AgentCoreMemoryConfig accepts a custom context_tag."""
+    assert _config(context_tag="retrieved_memory").context_tag == "retrieved_memory"
+
+
+def test_retrieved_memory_wrapped_in_default_user_context_tag():
+    """Injected memory uses <user_context> unless configured otherwise."""
+    mock_memory_client = Mock()
+    mock_memory_client.retrieve_memories.return_value = []
+
+    agent = _run_retrieval(_config(), mock_memory_client)
+
+    content = agent.messages[-1]["content"]
+    assert content[0]["text"] == "<user_context>User likes sushi</user_context>"
+    assert content[1]["text"] == "What are my preferences?"
+    assert "<retrieved_memory>" not in content[0]["text"]
+
+
+def test_retrieved_memory_wrapped_in_custom_context_tag():
+    """Injected memory uses the configured context_tag."""
+    mock_memory_client = Mock()
+    mock_memory_client.retrieve_memories.return_value = []
+
+    agent = _run_retrieval(_config(context_tag="retrieved_memory"), mock_memory_client)
+
+    content = agent.messages[-1]["content"]
+    assert content[0]["text"] == "<retrieved_memory>User likes sushi</retrieved_memory>"
+    assert content[1]["text"] == "What are my preferences?"
