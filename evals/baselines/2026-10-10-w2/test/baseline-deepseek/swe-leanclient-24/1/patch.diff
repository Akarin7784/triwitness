+def diagnostic_line_span(diagnostic: dict) -> tuple[int, int]:
+    """Return the (start_line, end_line) span a diagnostic covers.
+
+    Lean diagnostics carry two range fields:
+
+    - ``range``: the display range, which Lean may truncate.
+    - ``fullRange``: the semantic span of the error.
+
+    Only looking at ``range`` can exclude a diagnostic whose display range was
+    truncated away from the actual error location. Both fields are therefore
+    taken into account (the union of their line spans).
+
+    Args:
+        diagnostic (dict): A single LSP diagnostic.
+
+    Returns:
+        tuple[int, int]: Inclusive start and end line of the diagnostic.
+    """
+    starts: list[int] = []
+    ends: list[int] = []
+
+    for key in ("range", "fullRange", "full_range"):
+        rng = diagnostic.get(key) if isinstance(diagnostic, dict) else None
+        if not isinstance(rng, dict):
+            continue
+
+        start = rng.get("start")
+        if isinstance(start, dict):
+            starts.append(start.get("line", 0))
+        end = rng.get("end")
+        if isinstance(end, dict):
+            ends.append(end.get("line", 0))
+
+    if not starts or not ends:
+        return (0, 0)
+
+    return (min(starts), max(ends))
+
+
+def diagnostic_overlaps_range(
+    diagnostic: dict, start_line: int, end_line: int
+) -> bool:
+    """Check whether a diagnostic overlaps the given inclusive line range.
+
+    Considers both ``range`` (display) and ``fullRange`` (semantic span) so that
+    truncated display ranges cannot hide diagnostics. See
+    :func:`diagnostic_line_span`.
+
+    Args:
+        diagnostic (dict): A single LSP diagnostic.
+        start_line (int): Start line of the queried range (inclusive).
+        end_line (int): End line of the queried range (inclusive).
+
+    Returns:
+        bool: True if the diagnostic overlaps the queried range.
+    """
+    diag_start, diag_end = diagnostic_line_span(diagnostic)
+    return diag_start <= end_line and diag_end >= start_line
+
+
