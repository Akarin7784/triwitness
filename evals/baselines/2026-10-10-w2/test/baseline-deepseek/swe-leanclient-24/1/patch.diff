diff --git a/tests/tw_repro/test_issue_fullrange_line_filtering.py b/tests/tw_repro/test_issue_fullrange_line_filtering.py
new file mode 100644
index 0000000..6271bab
--- /dev/null
+++ b/tests/tw_repro/test_issue_fullrange_line_filtering.py
@@ -0,0 +1,171 @@
+"""Reproduction test: line range filtering must consider `fullRange`.
+
+Issue: `get_diagnostics(path, start_line=X, end_line=Y)` can miss errors because
+filtering only uses the `range` field, which Lean may truncate for display
+purposes. Lean diagnostics carry two range fields:
+
+- `range`: display range (may be truncated)
+- `fullRange`: semantic span of the error
+
+Affected functions:
+- `FileState.filter_diagnostics_by_range()` in `file_manager.py`
+- `get_diagnostics_in_range()` in `utils.py`
+
+These tests are pure-Python (no Lean server required).
+"""
+
+import pytest
+
+from leanclient.file_manager import FileState
+from leanclient.utils import get_diagnostics_in_range
+
+
+def _diag(range_lines, message, full_range_lines=None):
+    """Build a diagnostic with a display range and optional fullRange."""
+    diag = {
+        "range": {
+            "start": {"line": range_lines[0], "character": 0},
+            "end": {"line": range_lines[1], "character": 10},
+        },
+        "message": message,
+    }
+    if full_range_lines is not None:
+        diag["fullRange"] = {
+            "start": {"line": full_range_lines[0], "character": 0},
+            "end": {"line": full_range_lines[1], "character": 10},
+        }
+    return diag
+
+
+# ============================================================================
+# FileState.filter_diagnostics_by_range
+# ============================================================================
+
+
+def test_filter_uses_full_range_when_range_is_truncated():
+    """A truncated display range must not hide a diagnostic."""
+    diagnostics = [
+        # Display range truncated to line 0, actual error at lines 15-16.
+        _diag([0, 0], "truncated_display_range", full_range_lines=[15, 16]),
+    ]
+    state = FileState(uri="file:///test.lean", content="test", diagnostics=diagnostics)
+
+    filtered = state.filter_diagnostics_by_range(10, 20)
+
+    assert [d["message"] for d in filtered] == ["truncated_display_range"]
+
+
+def test_filter_excludes_diagnostics_outside_both_ranges():
+    """Diagnostics outside both `range` and `fullRange` stay excluded."""
+    diagnostics = [
+        _diag([0, 2], "before", full_range_lines=[1, 3]),
+        _diag([30, 32], "after", full_range_lines=[35, 40]),
+        _diag([50, 50], "truncated", full_range_lines=[60, 62]),
+    ]
+    state = FileState(uri="file:///test.lean", content="test", diagnostics=diagnostics)
+
+    assert state.filter_diagnostics_by_range(10, 20) == []
+
+
+def test_filter_falls_back_to_range_without_full_range():
+    """Diagnostics without `fullRange` keep working via `range`."""
+    diagnostics = [
+        _diag([5, 5], "before"),
+        _diag([15, 15], "inside"),
+        _diag([25, 25], "after"),
+    ]
+    state = FileState(uri="file:///test.lean", content="test", diagnostics=diagnostics)
+
+    filtered = state.filter_diagnostics_by_range(10, 20)
+
+    assert [d["message"] for d in filtered] == ["inside"]
+
+
+def test_filter_open_ended_ranges_use_full_range():
+    """Open-ended ranges also take `fullRange` into account."""
+    # start_line only: range alone (line 0) would be excluded, fullRange overlaps.
+    state = FileState(
+        uri="file:///test.lean",
+        content="test",
+        diagnostics=[
+            _diag([0, 0], "truncated", full_range_lines=[40, 41]),
+            _diag([0, 0], "irrelevant", full_range_lines=[5, 6]),
+        ],
+    )
+    filtered = state.filter_diagnostics_by_range(30, None)
+    assert [d["message"] for d in filtered] == ["truncated"]
+
+    # end_line only: range alone (line 90) would be excluded, fullRange overlaps.
+    state = FileState(
+        uri="file:///test.lean",
+        content="test",
+        diagnostics=[
+            _diag([90, 90], "truncated", full_range_lines=[5, 6]),
+            _diag([90, 90], "irrelevant", full_range_lines=[80, 81]),
+        ],
+    )
+    filtered = state.filter_diagnostics_by_range(None, 20)
+    assert [d["message"] for d in filtered] == ["truncated"]
+
+
+def test_get_diagnostics_with_range_uses_full_range():
+    """`get_diagnostics` range filtering must not miss truncated diagnostics."""
+    import threading
+
+    from leanclient.file_manager import LSPFileManager
+
+    diagnostics = [
+        _diag([0, 0], "truncated", full_range_lines=[15, 15]),
+        _diag([50, 50], "far_away", full_range_lines=[60, 60]),
+    ]
+    state = FileState(
+        uri="file:///test.lean",
+        content="test",
+        diagnostics=diagnostics,
+        complete=True,
+        current_processing=[],
+        diagnostics_version=0,
+    )
+
+    class _StubManager:
+        def __init__(self):
+            self.opened_files = {"test.lean": state}
+            self._opened_files_lock = threading.Lock()
+
+    result = LSPFileManager.get_diagnostics(
+        _StubManager(), "test.lean", start_line=10, end_line=20
+    )
+
+    assert [d["message"] for d in result] == ["truncated"]
+
+
+# ============================================================================
+# utils.get_diagnostics_in_range
+# ============================================================================
+
+
+def test_get_diagnostics_in_range_uses_full_range():
+    """`get_diagnostics_in_range` must consider `fullRange` too."""
+    diagnostics = [
+        _diag([0, 0], "truncated", full_range_lines=[15, 15]),
+        _diag([50, 50], "far_away", full_range_lines=[60, 60]),
+        _diag([12, 12], "plain_display_range"),
+    ]
+
+    result = get_diagnostics_in_range(diagnostics, 10, 20)
+
+    assert {d["message"] for d in result} == {"truncated", "plain_display_range"}
+
+
+def test_get_diagnostics_in_range_no_overlap():
+    """Nothing overlapping means an empty result."""
+    diagnostics = [
+        _diag([0, 1], "before", full_range_lines=[0, 2]),
+        _diag([50, 51], "after", full_range_lines=[55, 56]),
+    ]
+
+    assert get_diagnostics_in_range(diagnostics, 10, 20) == []
+
+
+if __name__ == "__main__":  # pragma: no cover
+    pytest.main([__file__, "-v"])
