diff --git a/tests/tw_repro/test_issue_295.py b/tests/tw_repro/test_issue_295.py
new file mode 100644
index 0000000..b40f0f6
--- /dev/null
+++ b/tests/tw_repro/test_issue_295.py
@@ -0,0 +1,146 @@
+# pylint: disable=missing-docstring
+# pylint: disable=invalid-name
+import textwrap
+import unittest
+from typing import Optional
+
+import icontract
+import tests.error
+
+
+class TestInvariantOfSubclassDoesNotApplyToBase(unittest.TestCase):
+    """
+    Reproduce https://github.com/Parquery/icontract/issues/295.
+
+    The invariants of a derived class must not be checked on the instances of its base
+    class, and they must not leak into the sibling classes.
+
+    The original example from the issue:
+
+    .. code-block:: python
+
+        from icontract import invariant
+
+        @invariant(lambda: True)
+        class Base:
+            pass
+
+        @invariant(lambda: False)
+        class Derived(Base):
+            pass
+
+        Base()  # ViolationError
+    """
+
+    def test_base_class_is_not_affected(self) -> None:
+        # NOTE: this is the exact example from the issue.
+        @icontract.invariant(lambda: True)
+        class Base:
+            pass
+
+        # pylint: disable=unused-variable
+        @icontract.invariant(lambda: False)
+        class Derived(Base):
+            pass
+
+        # The base class must not violate the invariant of the derived class.
+        _ = Base()
+
+        # The derived class has to satisfy its own invariant, though.
+        violation_error = None  # type: Optional[icontract.ViolationError]
+        try:
+            _ = Derived()
+        except icontract.ViolationError as err:
+            violation_error = err
+
+        self.assertIsNotNone(violation_error)
+        self.assertIn("False", str(violation_error))
+        self.assertIn("Derived", str(violation_error))
+
+    def test_sibling_class_is_not_affected(self) -> None:
+        @icontract.invariant(lambda self: self.x > 0)
+        class Base:
+            def __init__(self) -> None:
+                self.x = 10
+
+            def func(self) -> None:
+                self.x = 100
+
+            def __repr__(self) -> str:
+                return "instance of Base"
+
+        # pylint: disable=unused-variable
+        @icontract.invariant(lambda self: self.x < 50)
+        class Derived(Base):
+            def __repr__(self) -> str:
+                return "instance of Derived"
+
+        @icontract.invariant(lambda self: self.x < 1000)
+        class Sibling(Base):
+            def __repr__(self) -> str:
+                return "instance of Sibling"
+
+        # No invariant of the derived class may leak into the base class.
+        base = Base()
+        base.func()
+
+        # Nor may it leak into the sibling class.
+        sibling = Sibling()
+        sibling.func()
+
+        # The derived class needs to satisfy both the invariant of the base class
+        # and its own invariant.
+        derived = Derived()
+        violation_error = None  # type: Optional[icontract.ViolationError]
+        try:
+            derived.func()
+        except icontract.ViolationError as err:
+            violation_error = err
+
+        self.assertIsNotNone(violation_error)
+        self.assertEqual(
+            textwrap.dedent(
+                """\
+                self.x < 50:
+                self was instance of Derived
+                self.x was 100"""
+            ),
+            tests.error.wo_mandatory_location(str(violation_error)),
+        )
+
+    def test_base_class_with_metaclass_is_not_affected(self) -> None:
+        # The invariants are collapsed in ``icontract.DBCMeta``. Make sure that
+        # the invariants of the base class are not messed up there either.
+        @icontract.invariant(lambda: True)
+        class Base(icontract.DBC):
+            def method(self) -> None:
+                pass
+
+            def __repr__(self) -> str:
+                return "instance of {}".format(self.__class__.__name__)
+
+        # pylint: disable=unused-variable
+        @icontract.invariant(lambda: False)
+        class Derived(Base):
+            pass
+
+        # Neither the initialization nor the method calls of the base class
+        # must be affected by the invariant of the derived class.
+        base = Base()
+        base.method()
+
+        violation_error = None  # type: Optional[icontract.ViolationError]
+        try:
+            Derived().method()
+        except icontract.ViolationError as err:
+            violation_error = err
+
+        self.assertIsNotNone(violation_error)
+        self.assertEqual(
+            "False: self was instance of Derived",
+            tests.error.wo_mandatory_location(str(violation_error)),
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
