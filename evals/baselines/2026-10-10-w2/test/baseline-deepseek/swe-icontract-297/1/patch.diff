+    def test_subclass_does_not_affect_the_base_class(self) -> None:
+        # NOTE (mristin):
+        # Regression test for:
+        # https://github.com/Parquery/icontract/issues/295
+        #
+        # The invariants of the derived class must not be checked on the instances
+        # of the base class, and they must not leak into the sibling classes.
+        @icontract.invariant(lambda self: self.x > 0)
+        class A(icontract.DBC):
+            def __init__(self) -> None:
+                self.x = 10
+
+            def func(self) -> None:
+                self.x = 100
+
+            def __repr__(self) -> str:
+                return "instance of A"
+
+        @icontract.invariant(lambda self: self.x < 50)
+        class B(A):
+            def __repr__(self) -> str:
+                return "instance of B"
+
+        @icontract.invariant(lambda self: self.x < 1000)
+        class C(A):
+            def __repr__(self) -> str:
+                return "instance of C"
+
+        # No ``ViolationError`` is expected on the base class, although the derived
+        # classes introduced new invariants.
+        a = A()
+        a.func()
+
+        # The sibling class ``C`` must not be affected by the invariants of ``B``.
+        c = C()
+        c.func()
+
+        # The derived class ``B`` has to satisfy its own invariants, though.
+        b = B()
+        violation_error = None  # type: Optional[icontract.ViolationError]
+        try:
+            b.func()
+        except icontract.ViolationError as err:
+            violation_error = err
+
+        self.assertIsNotNone(violation_error)
+        self.assertEqual(
+            textwrap.dedent(
+                """\
+                self.x < 50:
+                self was instance of B
+                self.x was 100"""
+            ),
+            tests.error.wo_mandatory_location(str(violation_error)),
+        )
+
 
