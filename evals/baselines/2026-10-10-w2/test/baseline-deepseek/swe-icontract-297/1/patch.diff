+def _collect_inherited_invariants(
+    cls: type,
+) -> Tuple[List[Invariant], List[Invariant], List[Invariant]]:
+    """
+    Collect the invariants inherited from the direct bases of ``cls`` as new lists.
+
+    The lists are newly created so that adding an invariant to a derived class
+    does not modify the invariants of its base classes (and, consequently,
+    of its sibling classes).
+
+    :param cls: class whose inherited invariants we want to collect
+    :return: tuple of
+        (all inherited invariants, inherited invariants on call, inherited invariants on setting attributes)
+    """
+    invariants = []  # type: List[Invariant]
+    invariants_on_call = []  # type: List[Invariant]
+    invariants_on_setattr = []  # type: List[Invariant]
+
+    for base in cls.__bases__:
+        if not hasattr(base, "__invariants__"):
+            continue
+
+        invariants.extend(getattr(base, "__invariants__"))
+        invariants_on_call.extend(getattr(base, "__invariants_on_call__", []))
+        invariants_on_setattr.extend(getattr(base, "__invariants_on_setattr__", []))
+
+    return invariants, invariants_on_call, invariants_on_setattr
+
