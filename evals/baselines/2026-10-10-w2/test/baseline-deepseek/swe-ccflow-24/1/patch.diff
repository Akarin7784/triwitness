+def _resolve_context(model: "_CallableModel", fn, context: Any = Signature.empty, kwargs: Optional[Dict[str, Any]] = None) -> ContextBase:
+    """Resolve the context for a `Flow`-decorated function from its arguments.
+
+    The context can be specified in one of three ways:
+
+    * As a positional/keyword argument named ``context`` (as before), which is coerced to the model's
+      ``context_type`` if necessary.
+    * As the keyword arguments of the context itself, i.e. ``model(a="foo")`` is equivalent to
+      ``model(model.context_type(a="foo"))``. This avoids having to explicitly construct the context.
+    * Omitted entirely, in which case the default value defined in the function signature is used (if any).
+
+    Args:
+        model: The model the function is being called on.
+        fn: The (undecorated) function being called, used to look up the default context.
+        context: The value passed as ``context``, or ``Signature.empty`` if none was passed.
+        kwargs: The keyword arguments passed to the function other than ``context``.
+
+    Raises:
+        TypeError: If both a context and context keyword arguments are passed, or if no context can be
+            resolved.
+    """
+    kwargs = kwargs or {}
+    if kwargs:
+        if context is not Signature.empty:
+            raise TypeError("Cannot pass both a context and context keyword arguments")
+        # Let the context type validate its fields from the keyword arguments
+        return model.context_type(**kwargs)
+
+    if context is Signature.empty:
+        context = _cached_signature(fn).parameters["context"].default
+        if context is Signature.empty:
+            raise TypeError(f"{fn.__name__}() missing 1 required positional argument: 'context'")
+
+    # Type coercion on input  TODO: Move to ModelEvaluationContext
+    if not isinstance(context, model.context_type):
+        context = model.context_type.model_validate(context)
+    return context
+
+
