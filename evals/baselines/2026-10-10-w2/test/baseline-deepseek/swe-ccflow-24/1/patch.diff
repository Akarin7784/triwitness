index 0000000..34cf5d0
--- /dev/null
+++ b/tests/tw_repro/test_issue_kwargs.py
@@ -0,0 +1,81 @@
+"""Repro test for the feature request: "Ability to pass kwargs to CallableModel".
+
+A `CallableModel` should be callable by passing the fields of its context directly as
+keyword arguments, e.g. `model(a="foo")` instead of `model(MyContext(a="foo"))`.
+"""
+
+from unittest import TestCase
+
+from pydantic import ValidationError
+
+from ccflow import CallableModel, Flow, GenericResult, ResultBase
+from ccflow.tests.test_callable import MyCallable, MyContext, MyResult
+
+
+class MyKwargResult(ResultBase):
+    y: str
+
+
+class KwargModel(CallableModel):
+    i: int = 1
+
+    @Flow.call
+    def __call__(self, context: MyContext) -> MyKwargResult:
+        return MyKwargResult(y=context.a)
+
+
+class TestCallableModelKwargs(TestCase):
+    def test_kwargs_equivalent_to_context(self):
+        m = MyCallable(i=5)
+        self.assertEqual(m(a="foo"), m(MyContext(a="foo")))
+        self.assertEqual(m(a="foo"), MyResult(x=5, y="foo"))
+
+    def test_dict_context_still_works(self):
+        m = MyCallable(i=5)
+        self.assertEqual(m({"a": "foo"}), MyResult(x=5, y="foo"))
+
+    def test_context_kwarg_still_works(self):
+        m = MyCallable(i=5)
+        self.assertEqual(m(context=MyContext(a="foo")), MyResult(x=5, y="foo"))
+
+    def test_positional_context_still_works(self):
+        m = MyCallable(i=5)
+        self.assertEqual(m(MyContext(a="foo")), MyResult(x=5, y="foo"))
+
+    def test_kwargs_validate(self):
+        m = KwargModel()
+        # Valid kwargs are coerced/validated into the context type
+        self.assertEqual(m(a="foo"), MyKwargResult(y="foo"))
+
+    def test_missing_context_error(self):
+        m = MyCallable(i=5)
+        with self.assertRaisesRegex(
+            TypeError,
+            r"__call__\(\) missing 1 required positional argument: 'context'",
+        ):
+            m()
+
+    def test_context_and_kwargs_error(self):
+        m = MyCallable(i=5)
+        with self.assertRaises(TypeError):
+            m(MyContext(a="foo"), a="foo")
+
+    def test_bad_kwargs(self):
+        m = MyCallable(i=5)
+        self.assertRaises(ValidationError, m, b="foo")
+
+
+class DefaultModel(CallableModel):
+    @Flow.call
+    def __call__(self, context: MyContext = "bar") -> GenericResult:
+        return GenericResult(value=context.a)
+
+
+class TestDefaultContextKwargs(TestCase):
+    def test_default_still_works(self):
+        m = DefaultModel()
+        self.assertEqual(m(), GenericResult(value="bar"))
+
+    def test_kwargs_override_default(self):
+        m = DefaultModel()
+        self.assertEqual(m(a="foo"), GenericResult(value="foo"))
