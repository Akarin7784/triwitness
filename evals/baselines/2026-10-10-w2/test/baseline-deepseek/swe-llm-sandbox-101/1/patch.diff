diff --git a/tests/tw_repro/test_issue_81.py b/tests/tw_repro/test_issue_81.py
new file mode 100644
index 0000000..06540d3
--- /dev/null
+++ b/tests/tw_repro/test_issue_81.py
@@ -0,0 +1,181 @@
+# ruff: noqa: SLF001
+"""Reproduction test for the ArtifactSandboxSession timeout bug.
+
+Issue: `ArtifactSandboxSession` does not allow timeouts greater than 30 seconds.
+`ArtifactSandboxSession.run()` used to hardcode `timeout: int = 30` and always
+forwarded that value to the language handler, so the session level
+`default_timeout` / `execution_timeout` configuration (and any value greater
+than 30 seconds) was silently ignored. Plain `SandboxSession` (i.e.
+`BaseSession.run`) resolves the effective timeout from the session config when
+no explicit timeout is given.
+
+The tests below lock down the expected behaviour:
+* `ArtifactSandboxSession.run` defaults `timeout` to `None`;
+* with `default_timeout` / `execution_timeout` > 30 the resolved execution
+  timeout equals the configured value (not 30);
+* an explicit `timeout` is still honoured.
+"""
+
+from __future__ import annotations
+
+import inspect
+from typing import Any
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from llm_sandbox.core.config import SessionConfig
+from llm_sandbox.core.session_base import BaseSession
+from llm_sandbox.data import ConsoleOutput, ExecutionResult
+from llm_sandbox.session import ArtifactSandboxSession
+
+
+class _DummySession(BaseSession):
+    """Minimal concrete `BaseSession` used to observe the resolved timeout."""
+
+    def _handle_timeout(self) -> None:  # pragma: no cover - not exercised
+        pass
+
+    def _connect_to_existing_container(self, container_id: str) -> None:  # pragma: no cover
+        self.is_open = True
+
+    def open(self) -> None:
+        self._start_session_timer()
+        self.is_open = True
+
+    def close(self) -> None:
+        self._stop_session_timer()
+        self.is_open = False
+
+    def _process_non_stream_output(self, output: Any) -> tuple[str, str]:  # pragma: no cover
+        return "", ""
+
+    def _process_stream_output(self, output: Any) -> tuple[str, str]:  # pragma: no cover
+        return "", ""
+
+    def _ensure_directory_exists(self, path: str) -> None:  # pragma: no cover
+        pass
+
+    def _ensure_ownership(self, paths: list[str]) -> None:  # pragma: no cover
+        pass
+
+
+def _make_session(**config_kwargs: Any) -> tuple[_DummySession, dict[str, Any]]:
+    """Create a dummy session with execute_with_timeout patched to record the timeout."""
+    config = SessionConfig(lang="python", **config_kwargs)
+    session = _DummySession(config)
+    session.container = object()
+    session.is_open = True
+
+    captured: dict[str, Any] = {}
+
+    def fake_execute_with_timeout(func: Any, *args: Any, timeout: float | None = None, **kwargs: Any) -> ConsoleOutput:
+        captured["timeout"] = timeout
+        return ConsoleOutput(exit_code=0, stdout="ok", stderr="")
+
+    session._execute_with_timeout = fake_execute_with_timeout  # type: ignore[method-assign]
+    return session, captured
+
+
+def _artifact_session(session: _DummySession, **kwargs: Any) -> ArtifactSandboxSession:
+    with patch("llm_sandbox.session.create_session", return_value=session):
+        return ArtifactSandboxSession(enable_plotting=False, **kwargs)
+
+
+def test_run_timeout_default_is_none() -> None:
+    """`ArtifactSandboxSession.run` must not default to a hardcoded 30 seconds."""
+    default = inspect.signature(ArtifactSandboxSession.run).parameters["timeout"].default
+    assert default is None
+
+
+def test_default_timeout_greater_than_30_is_honoured() -> None:
+    """default_timeout=120 must not be overridden by a hardcoded 30 seconds."""
+    session, captured = _make_session(default_timeout=120.0)
+    artifact_session = _artifact_session(session)
+
+    result = artifact_session.run("print('hello')")
+
+    assert isinstance(result, ExecutionResult)
+    assert captured["timeout"] == 120.0
+
+
+def test_execution_timeout_greater_than_30_is_honoured() -> None:
+    """execution_timeout=90 must take precedence over default_timeout."""
+    session, captured = _make_session(default_timeout=120.0, execution_timeout=90.0)
+    artifact_session = _artifact_session(session)
+
+    artifact_session.run("print('hello')")
+
+    assert captured["timeout"] == 90.0
+
+
+def test_explicit_timeout_greater_than_30_is_honoured() -> None:
+    """An explicit timeout passed to `run` still wins over the session config."""
+    session, captured = _make_session(default_timeout=120.0)
+    artifact_session = _artifact_session(session)
+
+    artifact_session.run("print('hello')", timeout=45)
+
+    assert captured["timeout"] == 45
+
+
+def test_run_resolves_timeout_from_config_like_sandbox_session() -> None:
+    """`SandboxSession.run` and `ArtifactSandboxSession.run` resolve the same timeout."""
+    session, captured = _make_session(default_timeout=100.0)
+
+    # Plain session: no explicit timeout -> config default is used.
+    session.run("print('hello')")
+    plain_timeout = captured["timeout"]
+
+    artifact_session = _artifact_session(session)
+    artifact_session.run("print('hello')")
+    artifact_timeout = captured["timeout"]
+
+    assert plain_timeout == 100.0
+    assert artifact_timeout == plain_timeout
+
+
+def test_timeout_kwargs_are_forwarded_to_create_session() -> None:
+    """`default_timeout` / `execution_timeout` must reach the underlying session."""
+    mock_session = MagicMock()
+    with patch("llm_sandbox.session.create_session", return_value=mock_session) as mock_create_session:
+        ArtifactSandboxSession(default_timeout=120, execution_timeout=90)
+
+    call_kwargs = mock_create_session.call_args.kwargs
+    assert call_kwargs["default_timeout"] == 120
+    assert call_kwargs["execution_timeout"] == 90
+
+
+def test_run_forwards_timeout_to_language_handler() -> None:
+    """The handler receives `timeout=None` when the caller does not specify one."""
+    mock_session = MagicMock()
+    mock_handler = MagicMock()
+    mock_handler.run_with_artifacts.return_value = (
+        ConsoleOutput(exit_code=0, stdout="out", stderr=""),
+        [],
+    )
+    mock_session.language_handler = mock_handler
+
+    with patch("llm_sandbox.session.create_session", return_value=mock_session):
+        artifact_session = ArtifactSandboxSession(enable_plotting=False)
+        artifact_session.run("print('hello')", ["numpy"])
+
+    assert mock_handler.run_with_artifacts.call_args.kwargs["timeout"] is None
+
+
+@pytest.mark.parametrize("timeout", [None, 30, 120])
+def test_run_forwards_explicit_timeout_to_language_handler(timeout: float | None) -> None:
+    """An explicit timeout (including values > 30) is forwarded untouched."""
+    mock_session = MagicMock()
+    mock_handler = MagicMock()
+    mock_handler.run_with_artifacts.return_value = (
+        ConsoleOutput(exit_code=0, stdout="out", stderr=""),
+        [],
+    )
+    mock_session.language_handler = mock_handler
+
+    with patch("llm_sandbox.session.create_session", return_value=mock_session):
+        artifact_session = ArtifactSandboxSession(enable_plotting=False)
+        artifact_session.run("print('hello')", timeout=timeout)
+
+    assert mock_handler.run_with_artifacts.call_args.kwargs["timeout"] == timeout
