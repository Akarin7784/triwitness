diff --git a/tests/tw_repro/test_issue_1.py b/tests/tw_repro/test_issue_1.py
new file mode 100644
index 0000000..0cf7791
--- /dev/null
+++ b/tests/tw_repro/test_issue_1.py
@@ -0,0 +1,124 @@
+"""Reproduction test for: Add Parsing for `Assignment AND` Token.
+
+The lexer already produces the ASSIGN_AND token (``&=``) and the parser must
+accept it, both as a plain assignment statement and as a variable
+initialization, mirroring the other compound assignment operators
+(``+=``, ``-=``, ``*=``, ``/=``).
+"""
+
+from typing import List
+
+import pytest
+
+from crosstl.src.translator.ast import BinaryOpNode
+from crosstl.src.translator.lexer import Lexer
+from crosstl.src.translator.parser import Parser
+
+
+def tokenize_code(code: str) -> List:
+    """Helper function to tokenize code."""
+    lexer = Lexer(code)
+    return lexer.tokens
+
+
+def parse_code(tokens: List):
+    """Helper function to parse tokens into an AST."""
+    parser = Parser(tokens)
+    return parser.parse()
+
+
+def test_lexer_emits_assign_and_token():
+    tokens = tokenize_code("a &= 1;")
+    assert [t[0] for t in tokens][:4] == [
+        "IDENTIFIER",
+        "ASSIGN_AND",
+        "NUMBER",
+        "SEMICOLON",
+    ]
+    assert tokens[1][1] == "&="
+
+
+def test_parse_assign_and_statement():
+    code = """
+    shader PerlinNoise {
+    vertex {
+        input vec3 position;
+        output vec2 vUV;
+
+        void main() {
+            int a = 1;
+            a &= 1;
+            gl_Position = vec4(position, 1.0);
+        }
+    }
+    }
+    """
+    try:
+        ast = parse_code(tokenize_code(code))
+    except SyntaxError:
+        pytest.fail("Assignment AND (`&=`) parsing not implemented.")
+
+    vertex_body = list(ast.vertex_section.intermidiate)
+    for func in ast.vertex_section.functions:
+        vertex_body.extend(func.body)
+    binary_ops = []
+
+    def collect(node):
+        if isinstance(node, BinaryOpNode):
+            binary_ops.append(node)
+            collect(node.left)
+            collect(node.right)
+
+    for statement in vertex_body:
+        collect(statement)
+
+    assert any(
+        getattr(node, "op", None) == "&=" for node in binary_ops
+    ), "expected a BinaryOpNode with the `&=` operator"
+
+
+def test_parse_assign_and_in_expression_context():
+    code = """
+    shader Test {
+    vertex {
+        input vec3 position;
+        output vec2 vUV;
+
+        void main() {
+            int a = 1;
+            for (int i = 0; i < 10; i &= 3) {
+                vUV = vec2(0.0, 0.0);
+            }
+        }
+    }
+    }
+    """
+    try:
+        parse_code(tokenize_code(code))
+    except SyntaxError:
+        pytest.fail("Assignment AND (`&=`) parsing in expressions not implemented.")
+
+
+def test_parse_all_compound_assignments():
+    code = """
+    shader Test {
+    vertex {
+        input vec3 position;
+        output vec2 vUV;
+
+        void main() {
+            int a = 1;
+            a += 1;
+            a *= 2;
+            a /= a;
+            a -= -1;
+            a &= 1;
+            gl_Position = vec4(position, 1.0);
+        }
+    }
+    }
+    """
+    try:
+        parse_code(tokenize_code(code))
+    except SyntaxError:
+        pytest.fail("Compound assignment parsing failed.")
