         raise RuntimeError("Failed to commit changes")
 
 
+def find_existing_branches(repo_dir: str) -> list[str]:
+    """Find the branches that already exist in the repository at repo_dir.
+
+    Both local branches and remote-tracking branches are taken into account,
+    since the branch we are about to create may have been pushed by an earlier
+    attempt at fixing the issue. Remote-tracking branches are reported without
+    their remote prefix, so `remotes/origin/openhands-fix-issue-1` is reported
+    as `openhands-fix-issue-1`.
+    """
+    result = subprocess.run(
+        f"git -C {repo_dir} branch -a",
+        shell=True,
+        capture_output=True,
+        text=True,
+    )
+    if result.returncode != 0 or not isinstance(result.stdout, str):
+        # We cannot tell which branches exist, so report none of them
+        return []
+
+    existing_branches = []
+    for line in result.stdout.splitlines():
+        # `git branch` marks the current branch with a leading "* "
+        branch = line.strip().lstrip("*").strip()
+        # Skip empty lines and symbolic refs like "origin/HEAD -> origin/main"
+        if not branch or "->" in branch:
+            continue
+        parts = branch.split("/")
+        if parts[0] == "remotes":
+            # Drop the "remotes/<remote>/" prefix
+            parts = parts[2:]
+        elif parts[0] == "origin":
+            # Some versions of git print remote branches without the "remotes/" prefix
+            parts = parts[1:]
+        existing_branches.append("/".join(parts))
+
+    return existing_branches
+
+
+def get_unique_branch_name(branch_name: str, repo_dir: str) -> str:
+    """Return a branch name that does not exist yet.
+
+    The branch may already exist if the issue has been attempted before, in
+    which case `-try2`, `-try3`, ... is appended until an unused branch name is
+    found.
+    """
+    existing_branches = find_existing_branches(repo_dir)
+    if branch_name not in existing_branches:
+        return branch_name
+
+    try_num = 2
+    while f"{branch_name}-try{try_num}" in existing_branches:
+        try_num += 1
+
+    return f"{branch_name}-try{try_num}"
+
+
