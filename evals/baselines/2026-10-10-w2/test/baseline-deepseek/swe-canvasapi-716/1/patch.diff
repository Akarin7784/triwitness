diff --git a/tests/tw_repro/test_issue_obj_or_str.py b/tests/tw_repro/test_issue_obj_or_str.py
new file mode 100644
index 0000000..1c35b10
--- /dev/null
+++ b/tests/tw_repro/test_issue_obj_or_str.py
@@ -0,0 +1,164 @@
+"""
+Reproduction test for the issue "`obj_or_str` improperly rejects strings".
+
+`obj_or_str` is expected to behave like `obj_or_id`: the user may either pass
+the name of a feature directly (a `str`), or pass a
+`canvasapi.feature.Feature` object from which the name is taken. Every function
+that relies on `obj_or_str` should therefore work with either:
+
+- `canvasapi.account.Account.get_feature_flag()`
+- `canvasapi.course.Course.get_feature_flag()`
+- `canvasapi.feature.FeatureFlag.delete()`
+- `canvasapi.feature.FeatureFlag.set_feature_flag()`
+- `canvasapi.user.User.get_feature_flag()`
+"""
+
+import unittest
+
+import requests_mock
+
+from canvasapi import Canvas
+from canvasapi.feature import Feature, FeatureFlag
+from canvasapi.user import User
+from canvasapi.util import obj_or_str
+from tests import settings
+from tests.util import register_uris
+
+
+@requests_mock.Mocker()
+class TestObjOrStr(unittest.TestCase):
+    def setUp(self):
+        self.canvas = Canvas(settings.BASE_URL, settings.API_KEY)
+
+        with requests_mock.Mocker() as m:
+            register_uris({"user": ["get_by_id"]}, m)
+            self.user = self.canvas.get_user(1)
+
+    # obj_or_str()
+    def test_obj_or_str_returns_str(self, m):
+        feature_name = obj_or_str("epub_export", "name", (Feature,))
+
+        self.assertIsInstance(feature_name, str)
+        self.assertEqual(feature_name, "epub_export")
+
+    def test_obj_or_str_returns_object_attr(self, m):
+        user_name = obj_or_str(self.user, "name", (User,))
+
+        self.assertIsInstance(user_name, str)
+        self.assertEqual(user_name, "John Doe")
+
+    def test_obj_or_str_invalid_type(self, m):
+        with self.assertRaises(TypeError):
+            obj_or_str(1, "name", (User,))
+
+
+@requests_mock.Mocker()
+class TestFeatureFlagsAcceptStrings(unittest.TestCase):
+    def setUp(self):
+        self.canvas = Canvas(settings.BASE_URL, settings.API_KEY)
+
+        with requests_mock.Mocker() as m:
+            requires = {
+                "account": ["get_by_id", "get_features", "get_feature_flag"],
+                "course": ["get_by_id", "get_features", "get_feature_flag"],
+                "user": ["get_by_id", "get_features", "get_feature_flag"],
+            }
+            register_uris(requires, m)
+
+            self.account = self.canvas.get_account(1)
+            self.course = self.canvas.get_course(1)
+            self.user = self.canvas.get_user(1)
+
+            self.feature_account = self.account.get_features()[0]
+            self.feature_course = self.course.get_features()[0]
+            self.feature_user = self.user.get_features()[0]
+
+            self.feature_flag_account = self.account.get_feature_flag(
+                self.feature_account
+            )
+            self.feature_flag_course = self.course.get_feature_flag(self.feature_course)
+            self.feature_flag_user = self.user.get_feature_flag(self.feature_user)
+
+    # get_feature_flag() with a str
+    def test_account_get_feature_flag_str(self, m):
+        register_uris({"account": ["get_feature_flag"]}, m)
+
+        feature_flag = self.account.get_feature_flag("epub_export")
+
+        self.assertIsInstance(feature_flag, FeatureFlag)
+        self.assertEqual(feature_flag.feature, "epub_export")
+
+    def test_course_get_feature_flag_str(self, m):
+        register_uris({"course": ["get_feature_flag"]}, m)
+
+        feature_flag = self.course.get_feature_flag("epub_export")
+
+        self.assertIsInstance(feature_flag, FeatureFlag)
+        self.assertEqual(feature_flag.feature, "epub_export")
+
+    def test_user_get_feature_flag_str(self, m):
+        register_uris({"user": ["get_feature_flag"]}, m)
+
+        feature_flag = self.user.get_feature_flag("high_contrast")
+
+        self.assertIsInstance(feature_flag, FeatureFlag)
+        self.assertEqual(feature_flag.feature, "high_contrast")
+
+    # delete() with a str
+    def test_delete_account_str(self, m):
+        register_uris({"account": ["delete_feature_flag"]}, m)
+
+        delete_flag = self.feature_flag_account.delete("epub_export")
+
+        self.assertIsInstance(delete_flag, FeatureFlag)
+
+    def test_delete_course_str(self, m):
+        register_uris({"course": ["delete_feature_flag"]}, m)
+
+        delete_flag = self.feature_flag_course.delete("epub_export")
+
+        self.assertIsInstance(delete_flag, FeatureFlag)
+
+    def test_delete_user_str(self, m):
+        register_uris({"user": ["delete_feature_flag"]}, m)
+
+        delete_flag = self.feature_flag_user.delete("high_contrast")
+
+        self.assertIsInstance(delete_flag, FeatureFlag)
+
+    # set_feature_flag() with a str
+    def test_set_feature_flag_account_str(self, m):
+        register_uris({"account": ["set_feature_flag"]}, m)
+
+        update_flag = self.feature_flag_account.set_feature_flag("epub_export")
+
+        self.assertIsInstance(update_flag, FeatureFlag)
+
+    def test_set_feature_flag_course_str(self, m):
+        register_uris({"course": ["set_feature_flag"]}, m)
+
+        update_flag = self.feature_flag_course.set_feature_flag("epub_export")
+
+        self.assertIsInstance(update_flag, FeatureFlag)
+
+    def test_set_feature_flag_user_str(self, m):
+        register_uris({"user": ["set_feature_flag"]}, m)
+
+        update_flag = self.feature_flag_user.set_feature_flag("high_contrast")
+
+        self.assertIsInstance(update_flag, FeatureFlag)
+
+    # Feature objects keep working
+    def test_delete_account_feature_obj(self, m):
+        register_uris({"account": ["delete_feature_flag"]}, m)
+
+        delete_flag = self.feature_flag_account.delete(self.feature_account)
+
+        self.assertIsInstance(delete_flag, FeatureFlag)
+
+    def test_set_feature_flag_course_feature_obj(self, m):
+        register_uris({"course": ["set_feature_flag"]}, m)
+
+        update_flag = self.feature_flag_course.set_feature_flag(self.feature_course)
+
+        self.assertIsInstance(update_flag, FeatureFlag)
