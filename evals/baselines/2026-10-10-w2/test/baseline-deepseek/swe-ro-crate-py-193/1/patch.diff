@@ -0,0 +1,133 @@
+"""\
+Reproduction tests for the issue "Setting/Accessing nested properties on
+entities without @id".
+
+RO-Crates are supposed to contain flattened, compacted JSON-LD, so a property
+whose value is a dictionary must be an entity reference, i.e., it must have an
+``@id``. Setting a property to a dictionary without an ``@id`` used to be
+allowed, but the value could not be read back from the resulting object:
+
+    crate.root_dataset["license"] = {"@type": "CreativeWork", "name": "CC-O"}
+    crate.root_dataset["license"]  # ValueError: no @id in {...}
+
+The tests below lock the intended behavior:
+
+* assigning a dict (or a list of dicts) without ``@id`` raises ``ValueError``
+* accessing an inline dict (e.g. in a crate created by another tool, or by an
+  older version of this library) returns it as is instead of raising
+* entity references keep working as before, including round trips
+"""
+
+import json
+from pathlib import Path
+
+import pytest
+
+from rocrate.model import ContextEntity
+from rocrate.rocrate import ROCrate
+
+
+LICENSE = {
+    "@type": "CreativeWork",
+    "name": "CC0-1.0",
+    "url": "https://spdx.org/licenses/CC0-1.0",
+}
+
+
+def write_metadata(base_path, root_properties):
+    metadata = {
+        "@context": "https://w3id.org/ro/crate/1.1/context",
+        "@graph": [
+            {
+                "@id": "ro-crate-metadata.json",
+                "@type": "CreativeWork",
+                "about": {"@id": "./"},
+                "conformsTo": {"@id": "https://w3id.org/ro/crate/1.1"},
+            },
+            {"@id": "./", "@type": "Dataset", **root_properties},
+        ],
+    }
+    base_path = Path(base_path)
+    base_path.mkdir(parents=True, exist_ok=True)
+    with open(base_path / "ro-crate-metadata.json", "wt") as f:
+        json.dump(metadata, f)
+    return base_path
+
+
+# --- setting
+
+
+def test_set_dict_without_id_raises():
+    crate = ROCrate()
+    with pytest.raises(ValueError, match="no @id"):
+        crate.root_dataset["license"] = LICENSE
+
+
+def test_set_list_with_dict_without_id_raises():
+    crate = ROCrate()
+    with pytest.raises(ValueError, match="no @id"):
+        crate.root_dataset["license"] = [LICENSE]
+    # nothing was set
+    assert "license" not in crate.root_dataset
+
+
+def test_append_dict_without_id_raises():
+    crate = ROCrate()
+    with pytest.raises(ValueError, match="no @id"):
+        crate.root_dataset.append_to("license", LICENSE)
+    # nothing was added
+    assert "license" not in crate.root_dataset
+
+
+def test_set_dict_with_id_ok():
+    crate = ROCrate()
+    crate.root_dataset["license"] = {"@id": "https://spdx.org/licenses/CC0-1.0"}
+    assert "license" in crate.root_dataset
+    # the id does not resolve to an entity in the crate: it is returned as is
+    assert crate.root_dataset["license"] == "https://spdx.org/licenses/CC0-1.0"
+
+
+def test_set_entity_ok():
+    crate = ROCrate()
+    license_ = crate.add(ContextEntity(crate, "#license", properties={
+        "@type": "CreativeWork",
+        "name": "CC0-1.0",
+    }))
+    crate.root_dataset["license"] = license_
+    assert crate.root_dataset["license"] is license_
+
+
+# --- accessing
+
+
+def test_get_inline_dict_from_read_crate(tmpdir):
+    """A crate with an inline (no @id) dict property must be accessible."""
+    crate_dir = write_metadata(tmpdir / "in_crate", {"license": LICENSE})
+    crate = ROCrate(crate_dir)
+    assert crate.root_dataset["license"] == LICENSE
+
+
+def test_read_write_read_inline_dict(tmpdir):
+    """Reading and writing back a crate must not raise, either."""
+    crate_dir = write_metadata(tmpdir / "in_crate", {"license": LICENSE})
+    crate = ROCrate(crate_dir)
+    crate.write(tmpdir / "out_crate")
+    out_crate = ROCrate(tmpdir / "out_crate")
+    assert out_crate.root_dataset["license"] == LICENSE
+
+
+# --- round trip
+
+
+def test_reference_round_trip(tmpdir):
+    crate = ROCrate()
+    license_ = crate.add(ContextEntity(crate, "#license", properties={
+        "@type": "CreativeWork",
+        "name": "CC0-1.0",
+    }))
+    crate.root_dataset["license"] = license_
+    crate.write(tmpdir / "out_crate")
+    out_crate = ROCrate(tmpdir / "out_crate")
+    out_license = out_crate.root_dataset["license"]
+    assert out_license is out_crate.get("#license")
+    assert out_license["name"] == "CC0-1.0"
