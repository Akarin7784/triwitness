diff --git a/tests/tw_repro/test_issue_18748.py b/tests/tw_repro/test_issue_18748.py
new file mode 100644
index 0000000..8d65b02
--- /dev/null
+++ b/tests/tw_repro/test_issue_18748.py
@@ -0,0 +1,73 @@
+"""Reproducer for: AssertionError when doing ``conan install`` (``assert not require.version_range``)
+
+Entries in profile ``[platform_requires]`` / ``[platform_tool_requires]`` must be exact package
+references. A version range in those sections used to be taken verbatim by the graph builder
+(``_resolved_system``) and stored in the ``transitive_deps`` definitions, tripping the internal
+``assert not require.version_range`` invariant (raising an ``AssertionError`` + traceback).
+It must be reported now as a regular profile-reading error instead.
+"""
+from conan.test.assets.genconanfile import GenConanfile
+from conan.test.utils.tools import TestClient
+
+
+def test_platform_requires_version_range_is_an_error():
+    c = TestClient(light=True)
+    c.save({"conanfile.py": GenConanfile("pkg", "1.0").with_requires("dep/1.0"),
+            "profile": "[platform_requires]\ndep/[>=1.0]"})
+    c.run("install . -pr=profile", assert_error=True)
+    # A normal profile reading error, identifying section and reference
+    assert "Version ranges are not allowed in [platform_requires]: 'dep/[>=1.0]'" in c.out
+    assert "Error reading 'profile' profile" in c.out
+    # Never an internal error / traceback as the reported failure
+    assert "AssertionError" not in c.out
+    assert "Traceback" not in c.out
+
+
+def test_platform_tool_requires_version_range_is_an_error():
+    c = TestClient(light=True)
+    c.save({"conanfile.py": GenConanfile("pkg", "1.0").with_tool_requires("tool/1.0"),
+            "profile": "[platform_tool_requires]\ntool/[>=1.0]"})
+    c.run("install . -pr=profile", assert_error=True)
+    assert "Version ranges are not allowed in [platform_tool_requires]: 'tool/[>=1.0]'" in c.out
+    assert "Error reading 'profile' profile" in c.out
+    assert "AssertionError" not in c.out
+    assert "Traceback" not in c.out
+
+
+def test_platform_requires_and_tool_requires_range_messages():
+    """ the error identifies the offending section, not a generic one """
+    c = TestClient(light=True)
+    c.save({"conanfile.py": GenConanfile("pkg", "1.0"),
+            "profile": "[platform_tool_requires]\ntool/1.0\n[platform_requires]\ndep/[>=1.0]"})
+    c.run("install . -pr=profile", assert_error=True)
+    assert "[platform_requires]: 'dep/[>=1.0]'" in c.out
+    assert "[platform_tool_requires]" not in c.out.split("ERROR")[-1]
+
+
+def test_no_assertion_error_with_range_requirement_and_range_platform_require():
+    """ the original crash: both the recipe and the profile use ranges """
+    c = TestClient(light=True)
+    c.save({"conanfile.py": GenConanfile("pkg", "1.0").with_requires("dep/[>=1.0]"),
+            "profile": "[platform_requires]\ndep/[>=1.0]"})
+    c.run("install . -pr=profile", assert_error=True)
+    assert "AssertionError" not in c.out
+    assert "Traceback" not in c.out
+    assert "Version ranges are not allowed in [platform_requires]: 'dep/[>=1.0]'" in c.out
+
+
+def test_platform_requires_exact_ref_still_works():
+    """ regression: exact references keep working as before """
+    c = TestClient(light=True)
+    c.save({"conanfile.py": GenConanfile("pkg", "1.0").with_requires("dep/1.0"),
+            "profile": "[platform_requires]\ndep/1.0"})
+    c.run("install . -pr=profile")
+    assert "dep/1.0#platform - Platform" in c.out
+
+
+def test_platform_tool_requires_exact_ref_still_works():
+    """ regression: exact references keep working as before """
+    c = TestClient(light=True)
+    c.save({"conanfile.py": GenConanfile("pkg", "1.0").with_tool_requires("tool/1.0"),
+            "profile": "[platform_tool_requires]\ntool/1.0"})
+    c.run("install . -pr=profile")
+    assert "tool/1.0#platform - Platform" in c.out
