+    @staticmethod
+    def _parse_platform_requires(raw_info, section):
+        """ [platform_requires] and [platform_tool_requires] entries are "exact" references to
+        packages that exist in the system, and are matched against the requirements of the recipes.
+        Version ranges are not allowed there, so users can't expect that the platform packages will
+        be resolved to a different version
+        """
+        result = []
+        for line in raw_info.splitlines():
+            line = line.strip()
+            if not line or line.startswith("#"):
+                continue
+            ref = RecipeReference.loads(line)
+            version = repr(ref.version)
+            if version[:1] == "[" and version[-1:] == "]":
+                raise ConanException(f"Version ranges are not allowed in [{section}]: '{line}'. "
+                                     f"Only exact references are allowed, please use a fixed version")
+            result.append(ref)
+        return result
+
