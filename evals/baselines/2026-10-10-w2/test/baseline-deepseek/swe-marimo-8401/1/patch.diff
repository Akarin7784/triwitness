index 0000000..96a039a
--- /dev/null
+++ b/tests/tw_repro/test_probe_norm.py
@@ -0,0 +1,28 @@
+from __future__ import annotations
+
+
+class TestProbeNorm:
+    @staticmethod
+    async def test_double_call_in_cell(k, exec_req):
+        await k.run(
+            [
+                exec_req.get(
+                    """
+                    import marimo as mo
+
+                    calls = []
+
+                    @mo.cache
+                    def slow():
+                        calls.append(1)
+                        return "Done sleeping!"
+
+                    first = slow()
+                    second = slow()
+                    """
+                ),
+            ]
+        )
+        print("STDERR:", k.stderr.messages)
+        print("CALLS:", k.globals["calls"])
+        print("FIRST/SECOND:", k.globals["first"], k.globals["second"])
