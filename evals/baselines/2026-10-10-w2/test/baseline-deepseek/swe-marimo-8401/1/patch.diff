+import marimo
+
+__generated_with = "0.14.15"
+app = marimo.App()
+
+
+with app.setup:
+    import marimo as mo
+
+
+@app.cell
+def _():
+    calls = []
+
+    @mo.cache
+    def slow():
+        calls.append(1)
+        return "Done sleeping!"
+
+    first = slow()
+    second = slow()
+    return calls, first, second
+
+
+if __name__ == "__main__":
+    app.run()
