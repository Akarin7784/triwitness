+import logging
+
+
+class TestProbe2:
+    @staticmethod
+    def test_probe_app_fixture(app, caplog):
+        with app.setup:
+            import marimo as mo
+
+        with caplog.at_level(logging.WARNING):
+            @app.cell
+            def _():
+                @mo.cache
+                def slow():
+                    return "Done sleeping!"
+
+                res = slow()
+                return res
+
+        outputs = app.run()
+        print("CAUTH: ", [r.message for r in caplog.records])
+        print("OUT: ", outputs)
