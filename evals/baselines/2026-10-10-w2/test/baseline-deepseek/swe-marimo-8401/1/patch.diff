+import logging
+from marimo._runtime.commands import ExecuteCellCommand
+
+
+class TestProbe:
+    @staticmethod
+    async def test_probe_normal_cell(k, caplog, exec_req):
+        with caplog.at_level(logging.WARNING):
+            await k.run(
+                [
+                    exec_req.get(
+                        """
+                        import marimo as mo
+
+                        @mo.cache
+                        def slow():
+                            return "Done sleeping!"
+
+                        res = slow()
+                        """
+                    )
+                ]
+            )
+        print("CAUTH: ", [r.message for r in caplog.records])
