+"""Pytest configuration shared by all tests in this repository.
+
+This file only ensures that the test session has a usable templateflow cache.
+
+``templateflow`` is imported transitively by ``xcp_d`` and, by default, it uses
+``~/.cache/templateflow``. In some containerized test environments ``HOME`` is
+not writable, which raises ``PermissionError`` at import time and makes every
+test that imports ``xcp_d`` fail during collection. When that happens, fall back
+to a writable directory in the system temporary directory.
+"""
+
+import os
+import tempfile
+from pathlib import Path
+
+
+def _ensure_templateflow_home():
+    """Point templateflow at a writable cache if its default one is unusable."""
+    if os.environ.get('TEMPLATEFLOW_HOME'):
+        return
+
+    try:
+        (Path.home() / '.cache' / 'templateflow').mkdir(parents=True, exist_ok=True)
+    except OSError:
+        os.environ['TEMPLATEFLOW_HOME'] = os.path.join(
+            tempfile.gettempdir(),
+            'xcp_d-templateflow-home',
+        )
+
+
+_ensure_templateflow_home()
