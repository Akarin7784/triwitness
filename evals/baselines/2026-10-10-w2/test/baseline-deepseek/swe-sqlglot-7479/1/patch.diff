+    def _parse_ai_scalar(self, expr_type: t.Type[E], *named_args: str) -> E:
+        # AI.* scalar functions take a positional argument followed by named ones, e.g.
+        # AI.EMBED('content', connection_id => 'us.connection'). The named arguments are promoted
+        # to dedicated fields, while the remaining ones are kept in `expressions`, so that
+        # arbitrary usage is not lossy.
+        args = self._parse_function_args()
+        kwargs: t.Dict[str, exp.Expr] = {}
+        expressions = []
+
+        for i, arg in enumerate(args):
+            name = arg.this.name.lower() if i and isinstance(arg, exp.Kwarg) else None
+
+            if name in named_args and name not in kwargs:
+                kwargs[name] = arg
+            else:
+                expressions.append(arg)
+
+        expr = expr_type(this=seq_get(expressions, 0), expressions=expressions[1:] or None, **kwargs)
+
+        if "expression" in expr_type.arg_types and len(expressions) > 1:
+            # e.g. AI.SIMILARITY(embedding1, embedding2)
+            expr.set("expression", expressions[1])
+            expr.set("expressions", expressions[2:] or None)
+
+        return self.expression(expr)
+
+    def _parse_ai_generate(self) -> exp.AIGenerate:
+        # AI.GENERATE(MODEL <model>, <prompt> [, <params_struct>]) is the model-first form, while
+        # AI.GENERATE(<prompt> [, connection_id => ...]) is the connection-first one.
+        if self._match_text_seq("MODEL"):
+            model = self._parse_table()
+            self._match(TokenType.COMMA)
+            prompt = self._parse_bitwise()
+            params_struct = self._match(TokenType.COMMA) and self._parse_bitwise()
+
+            return self.expression(
+                exp.AIGenerate(this=prompt, model=model, params_struct=params_struct)
+            )
+
+        return self._parse_ai_scalar(
+            exp.AIGenerate, "connection_id", "endpoint", "request_type", "model_params"
+        )
+
