diff --git a/tests/tw_repro/test_issue_1.py b/tests/tw_repro/test_issue_1.py
new file mode 100644
index 0000000..b0ce1ac
--- /dev/null
+++ b/tests/tw_repro/test_issue_1.py
@@ -0,0 +1,75 @@
+"""Repro for the BigQuery AI.* typed scalar functions enhancement.
+
+AI.EMBED / AI.SIMILARITY / AI.GENERATE used to be parsed as Dot + Anonymous.
+They should now map onto richer typed AST nodes (exp.AIEmbed / exp.AISimilarity /
+exp.AIGenerate) while keeping parse/round trip behavior backward compatible.
+"""
+
+import unittest
+
+from sqlglot import exp, parse_one
+
+
+def _call(sql: str) -> exp.Expression:
+    query = parse_one(sql, dialect="bigquery")
+    node = query.expressions[0]
+    assert isinstance(node, exp.Dot), f"expected Dot, got {type(node).__name__}"
+    return node.expression
+
+
+class TestBigQueryAIScalarFunctions(unittest.TestCase):
+    def test_typed_nodes(self):
+        cases = (
+            ('SELECT AI.EMBED("hello")', exp.AIEmbed),
+            ('SELECT AI.SIMILARITY("a", "b")', exp.AISimilarity),
+            ('SELECT AI.GENERATE("Write a haiku")', exp.AIGenerate),
+        )
+
+        for sql, node_type in cases:
+            with self.subTest(sql=sql):
+                call = _call(sql)
+                self.assertIsInstance(call, node_type)
+
+    def test_roundtrip_is_backward_compatible(self):
+        cases = (
+            "SELECT AI.EMBED('hello')",
+            "SELECT AI.SIMILARITY('a', 'b')",
+            "SELECT AI.GENERATE('Write a haiku')",
+            "SELECT AI.EMBED('hello', connection_id => 'us.conn', endpoint => 'pub')",
+            "SELECT AI.GENERATE('prompt', connection_id => 'us.conn')",
+        )
+
+        for sql in cases:
+            with self.subTest(sql=sql):
+                self.assertEqual(parse_one(sql, dialect="bigquery").sql("bigquery"), sql)
+
+    def test_named_arguments_are_promoted(self):
+        call = _call(
+            "SELECT AI.EMBED('hello', connection_id => 'us.conn', endpoint => 'pub', model_params => x)"
+        )
+        self.assertIsInstance(call, exp.AIEmbed)
+        self.assertEqual(call.this.name, "hello")
+        self.assertEqual(call.args["connection_id"].expression.name, "us.conn")
+        self.assertEqual(call.args["endpoint"].expression.name, "pub")
+        self.assertEqual(call.args["model_params"].expression.name, "x")
+
+        sim = _call("SELECT AI.SIMILARITY('a', 'b')")
+        self.assertEqual(sim.this.name, "a")
+        self.assertEqual(sim.expression.name, "b")
+
+    def test_arbitrary_arguments_are_not_lost(self):
+        sql = "SELECT AI.EMBED('hello', model_params => x, something_else => 1)"
+        self.assertEqual(parse_one(sql, dialect="bigquery").sql("bigquery"), sql)
+
+    def test_generate_model_first_form(self):
+        # previously a ParseError: AI.GENERATE(MODEL <model>, <prompt>)
+        sql = "SELECT AI.GENERATE(MODEL `mydataset.gemini_model`, 'prompt')"
+        call = _call(sql)
+        self.assertIsInstance(call, exp.AIGenerate)
+        self.assertIsInstance(call.args["model"], exp.Table)
+        self.assertEqual(call.this.name, "prompt")
+        self.assertEqual(parse_one(sql, dialect="bigquery").sql("bigquery"), sql)
+
+
+if __name__ == "__main__":
+    unittest.main()
