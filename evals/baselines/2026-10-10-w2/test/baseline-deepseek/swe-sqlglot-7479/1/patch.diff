+class AIEmbed(Expression, Func):
+    # AI.EMBED produces an embedding for the given content, so it accepts a positional argument
+    # followed by named ones, e.g. AI.EMBED('content', connection_id => 'us.connection')
+    # https://docs.cloud.google.com/bigquery/docs/reference/standard-sql/bigqueryml-syntax-ai-embed
+    arg_types = {
+        "this": True,
+        "connection_id": False,
+        "endpoint": False,
+        "model_params": False,
+        "expressions": False,
+    }
+    is_var_len_args = True
+    _sql_names = ["AI_EMBED"]
+
+
+class AIGenerate(Expression, Func):
+    # AI.GENERATE generates text for the given prompt. It can either be called with named
+    # arguments, e.g. AI.GENERATE('prompt', connection_id => 'us.connection'), or with a model,
+    # e.g. AI.GENERATE(MODEL `mydataset.gemini_model`, 'prompt'), in which case the model and
+    # the optional STRUCT of parameters are set in the `model` and `params_struct` arguments.
+    # https://docs.cloud.google.com/bigquery/docs/reference/standard-sql/bigqueryml-syntax-ai-generate
+    arg_types = {
+        "this": True,
+        "connection_id": False,
+        "endpoint": False,
+        "request_type": False,
+        "model_params": False,
+        "model": False,
+        "params_struct": False,
+        "expressions": False,
+    }
+    is_var_len_args = True
+    _sql_names = ["AI_GENERATE"]
+
+
+class AISimilarity(Expression, Func):
+    # AI.SIMILARITY computes the similarity of two embeddings
+    # https://docs.cloud.google.com/bigquery/docs/reference/standard-sql/bigqueryml-syntax-ai-similarity
+    arg_types = {"this": True, "expression": False, "expressions": False}
+    is_var_len_args = True
+    _sql_names = ["AI_SIMILARITY"]
+
+
