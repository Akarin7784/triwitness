+def _hide_subapp_special_flags(app: "App") -> None:
+    """Hide a subapp's help/version flags from its own help-page.
+
+    The flags remain fully functional commands, but are not listed in the
+    subapp's ``Commands`` panel. This matches the behavior of subapps that were
+    registered directly; the same treatment must be applied to subapps that are
+    resolved from a :class:`~cyclopts.command_spec.CommandSpec` (lazy loading).
+
+    Parameters
+    ----------
+    app : App
+        The subapp whose help/version flags should be hidden.
+    """
+    for flag in chain(app.help_flags, app.version_flags):
+        app[flag].show = False
+
+
+def _apply_subapp_registration_defaults(app: "App", parent_app: "App") -> None:
+    """Apply parent-derived bookkeeping to a subapp being registered.
+
+    This performs the parts of :meth:`App.command` that must be applied to the
+    subapp itself (as opposed to the parent's command mapping) so that lazily
+    loaded subapps behave identically to directly registered ones.
+
+    Parameters
+    ----------
+    app : App
+        The subapp that is being registered to ``parent_app``.
+    parent_app : App
+        The parent app that the subapp is registered to.
+    """
+    _hide_subapp_special_flags(app)
+    if app._name_transform is None:
+        app.name_transform = parent_app.name_transform
+
+
 def _apply_parent_groups_to_kwargs(kwargs: dict[str, Any], parent_app: "App") -> None:
