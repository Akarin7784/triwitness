 from pathlib import Path
 
 import click
@@ -69,6 +70,81 @@ def add():
     pass
 
 
+@add.command(name="file")
+@click.argument('path', type=click.Path(exists=True))
+@OPTION_CRATE_PATH
+def file(crate_dir, path):
+    """\
+    Add a file to the crate.
+
+    The file is copied into the crate (at the top level if the source is
+    outside the crate directory, or at the path it already has relative to the
+    crate directory, otherwise) and registered in the metadata file.
+    """
+    crate_dir = Path(crate_dir).resolve()
+    crate = ROCrate(crate_dir, init=False, gen_preview=False)
+    source, dest_path = _resolve_data_entity_path(crate_dir, path, must_be_dir=False)
+    if source is not None:
+        dest = crate_dir / dest_path
+        dest.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(source, dest)
+    crate.add_file(dest_path, dest_path=dest_path)
+    crate.metadata.write(crate_dir)
+
+
+@add.command(name="dataset")
+@click.argument('path', type=click.Path(exists=True))
+@OPTION_CRATE_PATH
+def dataset(crate_dir, path):
+    """\
+    Add a directory (dataset) to the crate.
+
+    The directory is copied into the crate (at the top level if the source is
+    outside the crate directory, or at the path it already has relative to the
+    crate directory, otherwise), together with its contents, and registered in
+    the metadata file.
+    """
+    crate_dir = Path(crate_dir).resolve()
+    crate = ROCrate(crate_dir, init=False, gen_preview=False)
+    source, dest_path = _resolve_data_entity_path(crate_dir, path, must_be_dir=True)
+    if source is not None:
+        dest = crate_dir / dest_path
+        if not dest.exists():
+            shutil.copytree(source, dest)
+    crate.add_dataset(dest_path, dest_path=dest_path)
+    crate.metadata.write(crate_dir)
+
+
+def _resolve_data_entity_path(crate_dir, path, must_be_dir=False):
+    """\
+    Return a ``(source, dest_path)`` pair for a file or directory to be added
+    to the crate.
+
+    ``source`` is ``None`` if the entity is already in the crate directory
+    (i.e., there is nothing to copy), otherwise it's the path to copy from.
+    ``dest_path`` is the entity's path relative to the crate directory.
+    """
+    crate_dir = Path(crate_dir).resolve()
+    if not (crate_dir / "ro-crate-metadata.json").is_file():
+        raise click.ClickException(
+            f"{crate_dir}: not an RO-Crate (missing ro-crate-metadata.json)"
+        )
+    source = Path(path).resolve(strict=True)
+    is_dir = source.is_dir()
+    if must_be_dir and not is_dir:
+        raise click.ClickException(f"{source}: not a directory")
+    if not must_be_dir and is_dir:
+        raise click.ClickException(f"{source}: is a directory")
+    try:
+        dest_path = source.relative_to(crate_dir)
+    except ValueError:
+        # Source outside the crate dir: copy it to the top level
+        return source, Path(source.name)
+    if dest_path == Path("."):
+        raise click.ClickException(f"{source}: cannot add the crate directory itself")
+    return None, dest_path
+
+
 @add.command()
 @click.argument('path', type=click.Path(exists=True))
 @click.option('-l', '--language', type=click.Choice(LANG_CHOICES), default="cwl")
