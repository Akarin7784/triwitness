+
+"""\
+Reproduction test for the issue "CLI subcommands to add files and
+directories".
+
+The issue asks for two new subcommands, so that the following workflow
+works:
+
+    mkdir crate
+    cd crate
+    rocrate init  # generates minimal metadata file and nothing else
+    cp /some/other/path/file1 .
+    cp -rf /some/path/dir1 .
+    rocrate add file file1
+    rocrate add dataset dir1
+
+NOTE: pytest arguments are used as *fixture names* (the deprecated
+``--fixtures``-style behavior of pytest 8.3), so using built-in fixtures
+such as ``tmpdir`` together with parametrization is unreliable on this
+setup. This module therefore only depends on ``tmp_path_factory`` (a
+session-scoped factory fixture, so the parametrized value can never be
+mistaken for a fixture) and manages the working directory itself.
+"""
+
+import contextlib
+import json
+import os
+import shutil
+from pathlib import Path
+
+from click.testing import CliRunner
+import pytest
+
+from rocrate.cli import cli
+from rocrate.rocrate import ROCrate
+
+
+METADATA_FILE_NAME = "ro-crate-metadata.json"
+TEST_DIR = Path(__file__).absolute().parent
+
+
+@contextlib.contextmanager
+def chdir(path):
+    cwd = os.getcwd()
+    os.chdir(str(path))
+    try:
+        yield
+    finally:
+        os.chdir(cwd)
+
+
+@pytest.fixture(scope="module")
+def work_dir(tmp_path_factory):
+    return tmp_path_factory.mktemp("issue-103")
+
+
+@pytest.fixture
+def sample_sources(work_dir):
+    """A file and a directory outside of the crate dir."""
+    src_dir = work_dir / "some" / "other" / "path"
+    src_dir.mkdir(parents=True)
+    file1 = src_dir / "file1"
+    file1.write_text("file1 contents\n")
+    dir1 = work_dir / "some" / "path" / "dir1"
+    (dir1 / "subdir").mkdir(parents=True)
+    (dir1 / "inner.txt").write_text("inner\n")
+    (dir1 / "subdir" / "deep.txt").write_text("deep\n")
+    return file1, dir1
+
+
+def run_cli(*args):
+    runner = CliRunner()
+    result = runner.invoke(cli, list(args))
+    return result
+
+
+def make_crate(work_dir, name):
+    crate_dir = work_dir / name
+    crate_dir.mkdir()
+    return crate_dir
+
+
+def read_entities(crate_dir):
+    with open(Path(crate_dir) / METADATA_FILE_NAME, "rt") as f:
+        json_data = json.load(f)
+    return {_["@id"]: _ for _ in json_data["@graph"]}
+
+
+def test_cli_help():
+    result = run_cli("add", "--help")
+    assert result.exit_code == 0, result.output
+    assert "file" in result.output
+    assert "dataset" in result.output
+    for cmd in ("add file", "add dataset"):
+        result = run_cli(*cmd.split(), "--help")
+        assert result.exit_code == 0, result.output
+        assert "Usage:" in result.output
+
+
+@pytest.mark.parametrize("cwd", [False, True])
+def test_issue_workflow(work_dir, sample_sources, cwd):
+    """The workflow from the issue, step by step."""
+    file1, dir1 = sample_sources
+    crate_dir = make_crate(work_dir, f"crate_workflow_{int(cwd)}")
+
+    def invoke(*args):
+        if cwd:
+            with chdir(crate_dir):
+                return run_cli(*args)
+        return run_cli(*args, "-c", str(crate_dir))
+
+    # rocrate init: generates a minimal metadata file and nothing else
+    result = invoke("init")
+    assert result.exit_code == 0, result.output
+    assert (crate_dir / METADATA_FILE_NAME).is_file()
+    assert sorted(_.name for _ in crate_dir.iterdir()) == [METADATA_FILE_NAME]
+
+    # cp /some/other/path/file1 .
+    # cp -rf /some/path/dir1 .
+    shutil.copy(file1, crate_dir)
+    shutil.copytree(dir1, crate_dir / "dir1")
+
+    # rocrate add file file1
+    result = invoke("add", "file", "file1")
+    assert result.exit_code == 0, result.output
+
+    # rocrate add dataset dir1
+    result = invoke("add", "dataset", "dir1")
+    assert result.exit_code == 0, result.output
+
+    # both entities must be in the metadata file
+    json_entities = read_entities(crate_dir)
+    assert "file1" in json_entities
+    assert json_entities["file1"]["@type"] == "File"
+    assert "dir1/" in json_entities
+    assert json_entities["dir1/"]["@type"] == "Dataset"
+    has_part = {_["@id"] for _ in json_entities["./"]["hasPart"]}
+    assert {"file1", "dir1/"} <= has_part
+
+    # the crate must still be loadable and the data must be there
+    crate = ROCrate(crate_dir)
+    assert crate.dereference("file1")
+    assert crate.dereference("dir1/")
+    assert (crate_dir / "file1").is_file()
+    assert (crate_dir / "dir1" / "inner.txt").is_file()
+    assert (crate_dir / "dir1" / "subdir" / "deep.txt").is_file()
+
+
+def test_add_file_copies_into_crate(work_dir, sample_sources):
+    """A file outside the crate dir is copied into the crate."""
+    file1, _ = sample_sources
+    crate_dir = make_crate(work_dir, "crate_copy_file")
+    assert run_cli("init", "-c", str(crate_dir)).exit_code == 0
+    result = run_cli("add", "file", "-c", str(crate_dir), str(file1))
+    assert result.exit_code == 0, result.output
+    dest = crate_dir / file1.name
+    assert dest.is_file()
+    assert dest.read_text() == file1.read_text()
+    json_entities = read_entities(crate_dir)
+    assert file1.name in json_entities
+    assert json_entities[file1.name]["@type"] == "File"
+    assert {"@id": file1.name} in json_entities["./"]["hasPart"]
+
+
+def test_add_dataset_copies_into_crate(work_dir, sample_sources):
+    """A directory outside the crate dir is copied into the crate."""
+    _, dir1 = sample_sources
+    crate_dir = make_crate(work_dir, "crate_copy_dataset")
+    assert run_cli("init", "-c", str(crate_dir)).exit_code == 0
+    result = run_cli("add", "dataset", "-c", str(crate_dir), str(dir1))
+    assert result.exit_code == 0, result.output
+    dest = crate_dir / dir1.name
+    assert (dest / "inner.txt").is_file()
+    assert (dest / "subdir" / "deep.txt").is_file()
+    json_entities = read_entities(crate_dir)
+    assert "dir1/" in json_entities
+    assert json_entities["dir1/"]["@type"] == "Dataset"
+    assert {"@id": "dir1/"} in json_entities["./"]["hasPart"]
+
+
+def test_add_file_relative_path(work_dir):
+    """Files already in a crate subdirectory keep their relative path."""
+    crate_dir = make_crate(work_dir, "crate_relative")
+    (crate_dir / "subdir").mkdir()
+    (crate_dir / "subdir" / "file1").write_text("file1 contents\n")
+    with chdir(crate_dir):
+        assert run_cli("init").exit_code == 0
+        result = run_cli("add", "file", os.path.join("subdir", "file1"))
+    assert result.exit_code == 0, result.output
+    json_entities = read_entities(crate_dir)
+    assert "subdir/file1" in json_entities
+    assert json_entities["subdir/file1"]["@type"] == "File"
+
+
+def test_add_file_and_dataset_errors(work_dir, sample_sources):
+    file1, dir1 = sample_sources
+    crate_dir = make_crate(work_dir, "crate_errors")
+    # not an RO-Crate yet: the metadata file is missing
+    assert not (crate_dir / METADATA_FILE_NAME).exists()
+    assert run_cli("add", "file", "-c", str(crate_dir), str(file1)).exit_code != 0
+    assert run_cli("init", "-c", str(crate_dir)).exit_code == 0
+    # add file on a directory
+    result = run_cli("add", "file", "-c", str(crate_dir), str(dir1))
+    assert result.exit_code != 0
+    # add dataset on a file
+    result = run_cli("add", "dataset", "-c", str(crate_dir), str(file1))
+    assert result.exit_code != 0
+    # nonexistent path
+    result = run_cli("add", "file", "-c", str(crate_dir), str(work_dir / "nope"))
+    assert result.exit_code != 0
