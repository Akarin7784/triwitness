index 0000000..cf8e96d
--- /dev/null
+++ b/tests/tw_repro/test_issue_760.py
@@ -0,0 +1,39 @@
+"""Regression test: 'bool' object is not subscriptable (pyflakes 3.0).
+
+Reports an Annotation binding as used with a plain ``True`` instead of the
+``(scope, node)`` tuple every other load path uses.  A later assignment to
+the same name inside a function then crashed while trying to subscript it.
+"""
+
+from pyflakes import messages as m
+from pyflakes.test.harness import TestCase
+
+
+class TestAnnotationUsedAsTuple(TestCase):
+
+    def test_annotation_used_then_assigned_in_function(self):
+        self.flakes("""
+            test: int
+
+            test.__dict__
+
+
+            def fn():
+                test = 1
+        """, m.UndefinedName, m.UnusedVariable)
+
+    def test_annotation_used_in_module_scope(self):
+        self.flakes("""
+            test: int
+
+            print(test)
+        """, m.UndefinedName)
+
+    def test_annotation_used_then_assigned_in_function_no_load(self):
+        self.flakes("""
+            test: int
+
+
+            def fn():
+                test = 1
+        """, m.UnusedVariable)
