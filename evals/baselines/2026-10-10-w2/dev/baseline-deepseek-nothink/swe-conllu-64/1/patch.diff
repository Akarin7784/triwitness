+"""Reproduction test for the serializer crash on non-string metadata values.
+
+Issue: serializing metadata whose value is not a string (e.g. an int produced by
+a custom metadata_parser) raised:
+
+    TypeError: can only concatenate str (not "int") to str
+
+A metadata_parser that converts values to int should not break serialization.
+"""
+import unittest
+
+from conllu import parse
+from conllu.models import Metadata, TokenList
+
+
+class TestNonStringMetadataSerialization(unittest.TestCase):
+    def test_serialize_int_metadata_value(self):
+        tokenlist = TokenList([], Metadata([("id", 5)]))
+        self.assertEqual(tokenlist.serialize(), "# id = 5\n\n")
+
+    def test_serialize_non_string_metadata_values(self):
+        tokenlist = TokenList([], Metadata([("int", 42), ("float", 1.5), ("bool", True)]))
+        self.assertEqual(
+            tokenlist.serialize(),
+            "# int = 42\n# float = 1.5\n# bool = True\n\n",
+        )
+
+    def test_serialize_empty_metadata_value(self):
+        tokenlist = TokenList([], Metadata([("empty", "")]))
+        self.assertEqual(tokenlist.serialize(), "# empty\n\n")
+
+    def test_metadata_parser_returning_int(self):
+        data = "# id = 5\n1\tThe\tthe\tDET\tDT\t_\t4\tdet\t_\t_\n"
+
+        def int_metadata_parser(key, value):
+            return key, int(value)
+
+        sentence = parse(data, metadata_parsers={"__fallback__": int_metadata_parser})[0]
+        self.assertEqual(sentence.metadata["id"], 5)
+        # Serialization must not raise TypeError on the int value.
+        self.assertIn("# id = 5", sentence.serialize())
+
+
+if __name__ == "__main__":
+    unittest.main()
