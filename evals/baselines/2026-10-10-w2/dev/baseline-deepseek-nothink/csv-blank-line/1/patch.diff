diff --git a/csvkit_lite/parse.py b/csvkit_lite/parse.py
index 0ae3188..f158972 100644
--- a/csvkit_lite/parse.py
+++ b/csvkit_lite/parse.py
@@ -1,6 +1,8 @@
 def parse_rows(text: str) -> list[tuple[str, int]]:
     rows = []
     for line in text.splitlines():
+        if not line.strip():
+            continue
         parts = line.split(",")
         rows.append((parts[0].strip(), int(parts[1])))
     return rows
diff --git a/tests/tw_repro/test_issue_1.py b/tests/tw_repro/test_issue_1.py
new file mode 100644
index 0000000..ca9db63
--- /dev/null
+++ b/tests/tw_repro/test_issue_1.py
@@ -0,0 +1,21 @@
+from csvkit_lite.parse import parse_rows
+
+
+def test_trailing_blank_line():
+    assert parse_rows("a,1\nb,2\n") == [("a", 1), ("b", 2)]
+
+
+def test_blank_line_in_middle():
+    assert parse_rows("a,1\n\nb,2") == [("a", 1), ("b", 2)]
+
+
+def test_only_blank_lines():
+    assert parse_rows("\n\n") == []
+
+
+def test_whitespace_only_line():
+    assert parse_rows("a,1\n   \nb,2") == [("a", 1), ("b", 2)]
+
+
+def test_no_regression_no_blank_lines():
+    assert parse_rows("a,1\nb,2") == [("a", 1), ("b", 2)]
