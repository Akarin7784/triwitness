@@ -0,0 +1,13 @@
+from pager import paginate, total_pages
+
+
+def test_total_pages_ceiling():
+    assert total_pages(10, per_page=3) == 4
+    assert total_pages(9, 3) == 3
+    assert total_pages(0, 3) == 0
+    assert total_pages(1, 3) == 1
+
+
+def test_paginate_last_partial_page():
+    items = list(range(10))
+    assert paginate(items, page=4, per_page=3) == [9]
