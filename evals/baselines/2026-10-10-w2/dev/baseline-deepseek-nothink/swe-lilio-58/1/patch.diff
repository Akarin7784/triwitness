+"""Reproduction test for empty calendar resample error message.
+
+Issue: Unclear error message when an empty calendar is passed to `resample`.
+`utils.get_smallest_calendar_freq(calendar)` raises `ValueError: min() arg is an
+empty sequence` instead of a helpful message telling the user to add intervals
+to the calendar.
+"""
+import numpy as np
+import pandas as pd
+import pytest
+
+import lilio
+from lilio import Calendar
+from lilio.utils import get_smallest_calendar_freq
+
+
+def _make_data():
+    time_index = pd.date_range("20191101", "20211101", freq="1d")
+    return pd.Series(np.arange(len(time_index)), index=time_index, name="data1")
+
+
+def test_get_smallest_calendar_freq_empty_calendar():
+    cal = Calendar("12-25")
+    with pytest.raises(ValueError, match="add intervals"):
+        get_smallest_calendar_freq(cal)
+
+
+def test_resample_empty_calendar():
+    data = _make_data()
+    cal = Calendar("12-25")
+    cal.map_to_data(data)
+    with pytest.raises(ValueError, match="add intervals"):
+        lilio.resample(cal, data)
