--- /dev/null
+++ b/tests/tw_repro/test_issue_1.py
@@ -0,0 +1,27 @@
+from minicache import LRUCache
+
+
+def test_get_refreshes_recency_so_lru_is_evicted():
+    """Issue: with capacity 2, get("a") makes "a" recently used,
+    so put("c") must evict "b", not "a"."""
+    c = LRUCache(2)
+    c.put("a", 1)
+    c.put("b", 2)
+    assert c.get("a") == 1  # "a" is now most recently used
+    c.put("c", 3)  # should evict "b"
+
+    assert c.get("b", None) is None, '"b" should have been evicted'
+    assert c.get("a") == 1, '"a" should still be present'
+    assert c.get("c") == 3
+    assert len(c) == 2
+
+
+def test_get_missing_does_not_change_eviction_order():
+    c = LRUCache(2)
+    c.put("a", 1)
+    c.put("b", 2)
+    assert c.get("zz") is None
+    c.put("c", 3)  # "a" is still the least recently used
+    assert c.get("a", None) is None
+    assert c.get("b") == 2
+    assert c.get("c") == 3
