+    def __strip_comments(self, text):
+        # FIXME: only short comments removed
+        # Remove Lua short comments (`-- ...`) while leaving anything that
+        # looks like a comment marker *inside a string literal* untouched.
+        result = []
+        i = 0
+        length = len(text)
+        while i < length:
+            ch = text[i]
+            # Long bracket string or long comment: [[ ... ]] / [=[ ... ]=]
+            if ch == '[':
+                m = re.match(r'\[(=*)\[', text[i:])
+                if m:
+                    eq = m.group(1)
+                    close = ']' + eq + ']'
+                    start = i + m.end()
+                    end = text.find(close, start)
+                    if end == -1:
+                        result.append(text[i:])
+                        break
+                    j = end + len(close)
+                    # A long comment starts with `--[[ ... ]]`
+                    if result and result[-1].endswith('-') and \
+                            len(result) >= 2 and result[-2].endswith('-'):
+                        # Drop the two dashes we already emitted.
+                        result[-1] = result[-1][:-1]
+                        result[-2] = result[-2][:-1]
+                        i = j
+                        continue
+                    result.append(text[i:j])
+                    i = j
+                    continue
+            # Quoted string literal: skip over it (respecting escapes).
+            if ch in ('"', "'"):
+                start = i
+                i += 1
+                while i < length:
+                    c = text[i]
+                    if c == '\\':
+                        i += 2
+                        continue
+                    if c == ch:
+                        i += 1
+                        break
+                    i += 1
+                result.append(text[start:i])
+                continue
+            # Short comment: `--` up to (not including) end of line.
+            if ch == '-' and i + 1 < length and text[i + 1] == '-':
+                i += 2
+                while i < length and text[i] != '\n':
+                    i += 1
+                continue
+            result.append(ch)
+            i += 1
+        return ''.join(result)
+
     def encode(self, obj):
