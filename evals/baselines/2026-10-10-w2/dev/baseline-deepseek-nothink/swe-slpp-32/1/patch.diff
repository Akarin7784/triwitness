@@ -0,0 +1,26 @@
+#!/usr/bin/python
+# -*- coding: utf-8 -*-
+"""Repro for issue: lua.decode('"--3"') fails.
+
+`'--3'` is a perfectly valid lua string; the parser must not detect
+comments inside string literals.
+"""
+
+from slpp import slpp
+
+
+def test_double_quoted_dashdash_string():
+    assert slpp.decode('"--3"') == '--3'
+
+
+def test_single_quoted_dashdash_string():
+    assert slpp.decode("'--3'") == '--3'
+
+
+def test_dashdash_inside_table_key_value():
+    assert slpp.decode('{ ["--3"] = "--4" }') == {'--3': '--4'}
+
+
+def test_real_comment_still_stripped():
+    assert slpp.decode('3 -- a trailing comment') == 3
+    assert slpp.decode('{ a = 1, -- comment\n b = 2 }') == {'a': 1, 'b': 2}
