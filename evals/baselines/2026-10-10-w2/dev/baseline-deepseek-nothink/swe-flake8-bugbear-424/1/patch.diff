diff --git a/tests/tw_repro/test_issue_b017.py b/tests/tw_repro/test_issue_b017.py
new file mode 100644
index 0000000..1c3375a
--- /dev/null
+++ b/tests/tw_repro/test_issue_b017.py
@@ -0,0 +1,94 @@
+"""Repro for B017 false negative when ``raises`` is imported directly.
+
+Issue: B017 fails to warn for ``with raises(Exception):`` when ``raises`` is
+imported via ``from pytest import raises`` (i.e. used as an ``ast.Name``
+instead of the ``pytest.raises`` attribute access).
+"""
+import textwrap
+
+import pytest
+
+from bugbear import BugBearChecker
+
+
+def _b017_lines(source: str, tmp_path):
+    path = tmp_path / "repro.py"
+    path.write_text(textwrap.dedent(source))
+    bbc = BugBearChecker(filename=str(path))
+    return [e[0] for e in bbc.run()]
+
+
+ISSUE_SOURCE = """\
+import pytest
+from pytest import raises
+
+
+def foo():
+    raise
+
+
+def test_pytest_raises():
+    with raises(Exception):
+        foo()
+    with pytest.raises(Exception):
+        foo()
+"""
+
+
+def test_imported_raises_is_flagged(tmp_path):
+    # ``with raises(Exception):`` is line 10 and
+    # ``with pytest.raises(Exception):`` is line 12.
+    assert _b017_lines(ISSUE_SOURCE, tmp_path) == [10, 12]
+
+
+def test_imported_raises_with_match_not_flagged(tmp_path):
+    source = """\
+from pytest import raises
+
+
+def foo():
+    raise
+
+
+def test_raises_with_match():
+    with raises(Exception, match="foo"):
+        foo()
+"""
+    assert _b017_lines(source, tmp_path) == []
+
+
+def test_imported_raises_with_target_not_flagged(tmp_path):
+    source = """\
+from pytest import raises
+
+
+def foo():
+    raise
+
+
+def test_raises_with_target():
+    with raises(Exception) as exc:
+        foo()
+    assert exc.value
+"""
+    assert _b017_lines(source, tmp_path) == []
+
+
+def test_pytest_raises_attr_still_flagged(tmp_path):
+    source = """\
+import pytest
+
+
+def foo():
+    raise
+
+
+def test_pytest_raises():
+    with pytest.raises(Exception):
+        foo()
+"""
+    assert _b017_lines(source, tmp_path) == [9]
+
+
+if __name__ == "__main__":
+    raise SystemExit(pytest.main([__file__, "-v"]))
