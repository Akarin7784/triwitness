diff --git a/tests/tw_repro/test_issue_40.py b/tests/tw_repro/test_issue_40.py
new file mode 100644
index 0000000..c1b0e52
--- /dev/null
+++ b/tests/tw_repro/test_issue_40.py
@@ -0,0 +1,103 @@
+"""Reproduction test: ArtifactSandboxSession does not allow timeouts greater than 30 seconds.
+
+Issue: ArtifactSandboxSession does not allow timeouts greater than 30 seconds.
+SandboxSession works as expected.
+
+Root cause: ArtifactSandboxSession.run() declares a hard-coded default of
+``timeout: int = 30`` and always forwards it to the language handler, which in
+turn passes it to ``BaseSession.run(timeout=...)``.  Because
+``BaseSession.run`` computes ``actual_timeout = timeout or config.get_execution_timeout()``,
+the always-present ``30`` overrides the session-level ``execution_timeout`` /
+``default_timeout`` configuration, effectively capping every artifact run at 30s.
+
+These tests lock the behavior described in the issue:
+  * the default timeout forwarded to the language handler must come from the
+    session config (not a hard-coded 30),
+  * a session configured with an execution_timeout > 30 must forward that value,
+  * an explicit ``timeout`` argument must still take precedence.
+"""
+
+from unittest.mock import MagicMock, patch
+
+from llm_sandbox.core.config import SessionConfig
+from llm_sandbox.session import ArtifactSandboxSession
+
+CONFIGURED_TIMEOUT = 120.0
+
+
+def _make_artifact_session(config: SessionConfig) -> tuple[ArtifactSandboxSession, MagicMock]:
+    """Build an ArtifactSandboxSession whose underlying session is a mock.
+
+    ``config`` is a real ``SessionConfig`` so that ``get_execution_timeout()``
+    resolves exactly as it does in production. Returns the artifact session and
+    the language-handler mock so callers can inspect the forwarded timeout.
+    """
+    mock_language_handler = MagicMock()
+    mock_language_handler.is_support_plot_detection = True
+    mock_language_handler.run_with_artifacts.return_value = (
+        MagicMock(exit_code=0, stdout="output", stderr=""),
+        [],
+    )
+
+    mock_base_session = MagicMock()
+    mock_base_session.language_handler = mock_language_handler
+    mock_base_session.config = config
+
+    with patch("llm_sandbox.session.create_session", return_value=mock_base_session):
+        artifact_session = ArtifactSandboxSession(enable_plotting=True)
+
+    return artifact_session, mock_language_handler
+
+
+def test_artifact_session_default_timeout_is_not_capped_at_30() -> None:
+    """With ``execution_timeout`` > 30, the configured timeout must apply.
+
+    Before the fix this fails because a hard-coded ``timeout=30`` was forwarded
+    regardless of the configured ``execution_timeout``.
+    """
+    config = SessionConfig(execution_timeout=CONFIGURED_TIMEOUT)
+    assert config.get_execution_timeout() == CONFIGURED_TIMEOUT
+
+    artifact_session, language_handler = _make_artifact_session(config)
+
+    artifact_session.run("print('hello')")
+
+    _, kwargs = language_handler.run_with_artifacts.call_args
+    forwarded = kwargs["timeout"]
+    assert forwarded != 30, (
+        "ArtifactSandboxSession.run() forwarded the hard-coded 30s default and "
+        "ignored the configured execution_timeout"
+    )
+    # The forwarded value feeds ``BaseSession.run``, which resolves
+    # ``timeout or config.get_execution_timeout()``; None means "use the config".
+    effective_timeout = forwarded or config.get_execution_timeout()
+    assert effective_timeout == CONFIGURED_TIMEOUT
+
+
+def test_artifact_session_default_timeout_defers_to_base_session() -> None:
+    """The default (None) means 'use the session config', matching SandboxSession.
+
+    ``BaseSession.run`` resolves ``timeout or config.get_execution_timeout()``,
+    so forwarding ``None`` lets a configured timeout > 30s actually apply.
+    """
+    config = SessionConfig(execution_timeout=CONFIGURED_TIMEOUT)
+    artifact_session, language_handler = _make_artifact_session(config)
+
+    artifact_session.run("print('hello')")
+
+    _, kwargs = language_handler.run_with_artifacts.call_args
+    assert kwargs["timeout"] is None, (
+        "Expected ArtifactSandboxSession.run() to forward timeout=None when the "
+        "caller did not specify one, so that the session config timeout applies"
+    )
+
+
+def test_artifact_session_explicit_timeout_still_wins() -> None:
+    """An explicit per-call timeout must still override the session config."""
+    config = SessionConfig(execution_timeout=CONFIGURED_TIMEOUT)
+    artifact_session, language_handler = _make_artifact_session(config)
+
+    artifact_session.run("print('hello')", timeout=5.0)
+
+    _, kwargs = language_handler.run_with_artifacts.call_args
+    assert kwargs["timeout"] == 5.0
