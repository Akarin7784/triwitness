+def _hide_subapp_help_version_flags(app: "App") -> None:
+    """Hide a sub-app's own ``help_flags``/``version_flags`` from its help output.
+
+    Since v3.10 (PR #363), a sub-app registered as a command no longer displays
+    its own ``--help``/``--version`` flags in its help panel; the flags still
+    function, but are hidden. This must be applied consistently for both direct
+    (``app.command(subapp)``) and lazy (``app.command("mod:subapp")``)
+    registration.
+
+    Parameters
+    ----------
+    app : App
+        The sub-app whose help/version flag commands should be hidden.
+    """
+    for flag in chain(app.help_flags, app.version_flags):
+        try:
+            app[flag].show = False
+        except KeyError:
+            pass
+
+
