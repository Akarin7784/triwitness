+"""
+Reproduction for the host-path symlink escape in the ``allowed_host_paths``
+allowlist of OpenSandbox.
+
+An attacker places a symbolic link inside a whitelisted host path, the symlink
+points at the host root directory ``/`` (or any other host path outside the
+allowlist), and then requests a bind mount using the symlink path.  Because
+``ensure_valid_host_path`` only performs lexical normalisation (``normpath``)
+and never resolves symbolic links (``realpath``), the allowlist check passes
+while Docker happily resolves the symlink when bind mounting, giving access to
+an arbitrary host path.
+"""
+
+import os
+from unittest.mock import MagicMock, patch
+
+import pytest
+from fastapi import HTTPException, status
+
+from opensandbox_server.api.schema import (
+    CreateSandboxRequest,
+    Host,
+    ImageSpec,
+    ResourceLimits,
+    Volume,
+)
+from opensandbox_server.config import StorageConfig
+from opensandbox_server.services.constants import SandboxErrorCodes
+from opensandbox_server.services.docker import DockerSandboxService
+from opensandbox_server.services.validators import ensure_valid_host_path
+
+from tests.test_docker_service import _app_config
+
+
+class TestEnsureValidHostPathRejectsSymlinks:
+    """``ensure_valid_host_path`` must reject paths containing symlinks."""
+
+    def test_symlink_inside_allowed_prefix_pointing_to_root_is_rejected(self, tmp_path):
+        """A symlink under an allowed prefix that points to ``/`` must be rejected."""
+        allowed_dir = tmp_path / "allowed"
+        allowed_dir.mkdir()
+        escape = allowed_dir / "escape"
+        os.symlink("/", escape)
+
+        with pytest.raises(HTTPException) as exc_info:
+            ensure_valid_host_path(str(escape), [str(allowed_dir)])
+
+        assert exc_info.value.status_code == status.HTTP_400_BAD_REQUEST
+        assert exc_info.value.detail["code"] in (
+            SandboxErrorCodes.INVALID_HOST_PATH,
+            SandboxErrorCodes.HOST_PATH_NOT_ALLOWED,
+        )
+
+    def test_lexical_prefix_match_with_symlink_component_is_rejected(self, tmp_path):
+        """The symlink path lexically starts with the allowed prefix, but must still be rejected."""
+        allowed_dir = tmp_path / "allowed"
+        allowed_dir.mkdir()
+        escape = allowed_dir / "escape"
+        os.symlink("/", escape)
+        requested = str(escape / "etc")
+
+        # Sanity check: the requested path really does look allowlisted lexically.
+        assert os.path.normpath(requested).startswith(str(allowed_dir))
+
+        with pytest.raises(HTTPException) as exc_info:
+            ensure_valid_host_path(requested, [str(allowed_dir)])
+
+        assert exc_info.value.status_code == status.HTTP_400_BAD_REQUEST
+
+    def test_nested_symlink_deep_inside_prefix_is_rejected(self, tmp_path):
+        """A symlink that is not a direct child of the allowed prefix must also be caught."""
+        allowed_dir = tmp_path / "allowed"
+        nested = allowed_dir / "a" / "b"
+        nested.mkdir(parents=True)
+        escape = nested / "escape"
+        os.symlink("/", escape)
+
+        with pytest.raises(HTTPException) as exc_info:
+            ensure_valid_host_path(str(escape), [str(allowed_dir)])
+
+        assert exc_info.value.status_code == status.HTTP_400_BAD_REQUEST
+
+    def test_regular_path_inside_prefix_is_still_allowed(self, tmp_path):
+        """Non-symlink paths under an allowed prefix must keep working."""
+        allowed_dir = tmp_path / "allowed"
+        target = allowed_dir / "sub"
+        target.mkdir(parents=True)
+
+        assert ensure_valid_host_path(str(target), [str(allowed_dir)]) is None
+
+
+class TestDockerServiceRejectsSymlinkedHostVolume:
+    """``create_sandbox`` must reject symlinked host volumes that escape the allowlist."""
+
+    @pytest.mark.asyncio
+    @patch("opensandbox_server.services.docker.docker")
+    async def test_create_sandbox_symlink_to_root_is_rejected(self, mock_docker, tmp_path):
+        mock_client = MagicMock()
+        mock_client.containers.list.return_value = []
+        mock_docker.from_env.return_value = mock_client
+
+        allowed_dir = tmp_path / "allowed"
+        allowed_dir.mkdir()
+        escape = allowed_dir / "escape"
+        os.symlink("/", escape)
+
+        cfg = _app_config()
+        cfg.storage = StorageConfig(allowed_host_paths=[str(allowed_dir)])
+        service = DockerSandboxService(config=cfg)
+
+        request = CreateSandboxRequest(
+            image=ImageSpec(uri="python:3.11"),
+            timeout=120,
+            resourceLimits=ResourceLimits(root={}),
+            env={},
+            metadata={},
+            entrypoint=["python"],
+            volumes=[
+                Volume(
+                    name="workdir",
+                    host=Host(path=str(escape)),
+                    mount_path="/mnt/work",
+                    read_only=False,
+                )
+            ],
+        )
+
+        with patch.object(service, "_ensure_image_available"), patch.object(
+            service, "_prepare_sandbox_runtime"
+        ):
+            with pytest.raises(HTTPException) as exc_info:
+                await service.create_sandbox(request)
+
+        assert exc_info.value.status_code == status.HTTP_400_BAD_REQUEST
