+def _find_symlink_component(path: str) -> Optional[str]:
+    """
+    Return the first path component of ``path`` that is a symbolic link.
+
+    The check walks every prefix of the (lexically normalized) path, from the
+    filesystem root down to the full path, and inspects each component with
+    ``os.path.islink``.  Components that do not exist yet (``os.path.islink``
+    returns ``False`` for missing paths) are not considered symlinks.
+
+    Windows-style paths (e.g. ``D:\\data``) are reported as ``None`` because
+    their components cannot be stat-ed on a POSIX host.  Callers still rely on
+    the lexical checks in :func:`ensure_valid_host_path` for those paths.
+
+    Args:
+        path: Absolute host path to inspect.
+
+    Returns:
+        The offending component (as an absolute path) when a symlink is found,
+        otherwise ``None``.
+    """
+    # On POSIX hosts, Windows drive paths (C:\ or D:/) cannot be stat-ed for
+    # symlink resolution; skip the filesystem walk for them.
+    if os.name != "nt" and re.match(r"^[A-Za-z]:[\\/]", path):
+        return None
+
+    native_path = os.path.normpath(path)
+    components: List[str] = []
+
+    # Build the list of path components from the root down to the leaf.
+    head, tail = os.path.split(native_path)
+    while tail:
+        components.append(tail)
+        head, tail = os.path.split(head)
+    # ``head`` now holds the anchor (``/`` on POSIX or ``C:\\`` on Windows).
+    anchor = head
+    if not anchor:
+        # Relative paths should have been rejected earlier; nothing to walk.
+        return None
+
+    current = anchor
+    for component in reversed(components):
+        current = os.path.join(current, component)
+        try:
+            if os.path.islink(current):
+                return current
+        except OSError:
+            # Cannot stat this component (e.g. permissions); treat as
+            # non-symlink and let downstream checks handle it.
+            continue
+    return None
+
