@@ -0,0 +1,61 @@
+"""
+Repro for: template_loader blocks on STATICFILES_DIRS if there are tuples.
+
+Django allows STATICFILES_DIRS entries to be either a path or a
+`(prefix, path)` tuple. `django_components.template_loader.Loader.get_dirs`
+must support both, and consider the second item of the tuple.
+
+https://docs.djangoproject.com/en/3.2/ref/settings/#std-setting-STATICFILES_DIRS
+"""
+
+from pathlib import Path
+
+from django.template.engine import Engine
+from django.test import override_settings
+
+# isort: off
+from ..django_test_setup import *  # NOQA
+from ..testutils import BaseTestCase
+
+# isort: on
+
+from django_components.template_loader import Loader
+
+TESTS_DIR = Path(__file__).parent.parent.resolve()
+COMPONENTS_DIR = TESTS_DIR / "components"
+
+
+class StaticfilesDirsTupleTests(BaseTestCase):
+    """`Loader.get_dirs` must not choke on `(prefix, path)` tuples in STATICFILES_DIRS"""
+
+    def test_get_dirs_with_tuple_entry(self):
+        with override_settings(
+            BASE_DIR=TESTS_DIR,
+            STATICFILES_DIRS=[("downloads", COMPONENTS_DIR)],
+        ):
+            current_engine = Engine.get_default()
+            loader = Loader(current_engine)
+            dirs = loader.get_dirs()
+
+        self.assertEqual(dirs, [COMPONENTS_DIR.resolve()])
+
+    def test_get_dirs_with_mixed_entries(self):
+        with override_settings(
+            BASE_DIR=TESTS_DIR,
+            STATICFILES_DIRS=[COMPONENTS_DIR, ("downloads", COMPONENTS_DIR)],
+        ):
+            current_engine = Engine.get_default()
+            loader = Loader(current_engine)
+            dirs = loader.get_dirs()
+
+        self.assertEqual(dirs, [COMPONENTS_DIR.resolve()])
+
+    def test_tuple_entry_does_not_raise_type_error(self):
+        # The original bug was a `TypeError: expected str, bytes or os.PathLike object, not tuple`
+        with override_settings(
+            BASE_DIR=TESTS_DIR,
+            STATICFILES_DIRS=[("downloads", "/opt/webfiles/stats")],
+        ):
+            current_engine = Engine.get_default()
+            loader = Loader(current_engine)
+            loader.get_dirs()  # Must not raise
