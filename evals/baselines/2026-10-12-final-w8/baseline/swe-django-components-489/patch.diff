+# Notes on `get_component_dirs()` and `_resolve_component_dir()` below:
+#
+# Django allows `STATICFILES_DIRS` entries to be either a plain path (str / PathLike),
+# or a `(prefix, path)` tuple, where the path is the one that matters for us.
+# See https://docs.djangoproject.com/en/3.2/ref/settings/#std-setting-STATICFILES_DIRS
+#
+# To keep the two supported forms in sync, we expose `get_component_dirs()` for the
+# `STATICFILES_DIRS` setting, and `_resolve_component_dir()` for turning a single
+# entry (of either form) into a Path.
+def get_component_dirs() -> List[Path]:
+    """Return the dirs from `settings.STATICFILES_DIRS` as a list of paths.
+
+    Handles both plain path entries and `(prefix, path)` tuples.
+    When `STATICFILES_DIRS` is not set, defaults to a single `"components"` dir,
+    so `Component.get_template()` reports the invalid component name.
+    """
+    if hasattr(settings, "STATICFILES_DIRS") and len(settings.STATICFILES_DIRS):
+        component_dirs = settings.STATICFILES_DIRS
+    else:
+        component_dirs = ["components"]
+
+    return [_resolve_component_dir(entry) for entry in component_dirs]
+
+
+def _resolve_component_dir(entry: Any) -> Path:
+    """Normalize a single `STATICFILES_DIRS` entry into a Path.
+
+    `(prefix, path)` tuples are supported (as in Django), and the second item is used.
+    """
+    if isinstance(entry, (tuple, list)) and len(entry) == 2:
+        entry = entry[1]
+    return Path(entry)
+
