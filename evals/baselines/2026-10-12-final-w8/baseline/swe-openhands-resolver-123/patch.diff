+def check_branch_exists(base_url: str, headers: dict, branch_name: str) -> bool:
+    """Check whether a branch already exists on the remote repository."""
+    response = requests.get(f"{base_url}/branches/{branch_name}", headers=headers)
+    if response.status_code == 200:
+        return True
+    elif response.status_code == 404:
+        return False
+    else:
+        response.raise_for_status()
+        # If raise_for_status did not raise (e.g. a mocked/odd response),
+        # treat the branch as not existing.
+        return False
+
