@@ -0,0 +1,171 @@
+"""Reproduction for: "Better handling of when a branch already exists".
+
+When the resolver has already tried to solve an issue, the fixed branch name
+``openhands-fix-issue-<n>`` may already exist on the remote.  In that case the
+resolver must append ``-try2``, ``-try3``, ... until it finds a branch name that
+does not exist yet.
+
+These tests lock the observable behaviour (which branch name is actually
+checked out / pushed and used for the PR), independent of the internal helper
+naming.
+"""
+
+import os
+import tempfile
+
+import pytest
+from unittest.mock import patch, MagicMock, call
+
+from openhands_resolver.send_pull_request import send_pull_request
+from openhands_resolver.resolver_output import GithubIssue
+
+
+@pytest.fixture
+def mock_output_dir():
+    with tempfile.TemporaryDirectory() as temp_dir:
+        repo_path = os.path.join(temp_dir, "repo")
+        os.makedirs(repo_path)
+        os.system(f"git init {repo_path}")
+        yield temp_dir
+
+
+@pytest.fixture
+def mock_github_issue():
+    return GithubIssue(
+        number=42,
+        title="Test Issue",
+        owner="test-owner",
+        repo="test-repo",
+        body="Test body",
+    )
+
+
+def _make_get(branch_exists_map):
+    """Return a fake requests.get.
+
+    ``branch_exists_map`` maps branch name -> whether it exists.
+    The default-branch lookup (base repo URL) always returns ``main``.
+    Branch-existence lookups return a 200 (exists) or 404 (missing) object.
+    """
+
+    def fake_get(url, headers=None, **kwargs):
+        # default branch lookup
+        if "/branches/" not in url:
+            resp = MagicMock()
+            resp.status_code = 200
+            resp.json.return_value = {"default_branch": "main"}
+            resp.raise_for_status.return_value = None
+            return resp
+
+        branch_name = url.rsplit("/branches/", 1)[1]
+        exists = branch_exists_map.get(branch_name, False)
+        resp = MagicMock()
+        resp.status_code = 200 if exists else 404
+        resp.raise_for_status.return_value = None
+        return resp
+
+    return fake_get
+
+
+@pytest.mark.parametrize(
+    "existing, expected_branch",
+    [
+        (set(), "openhands-fix-issue-42"),
+        ({"openhands-fix-issue-42"}, "openhands-fix-issue-42-try2"),
+        (
+            {"openhands-fix-issue-42", "openhands-fix-issue-42-try2"},
+            "openhands-fix-issue-42-try3",
+        ),
+        (
+            {
+                "openhands-fix-issue-42",
+                "openhands-fix-issue-42-try2",
+                "openhands-fix-issue-42-try3",
+            },
+            "openhands-fix-issue-42-try4",
+        ),
+    ],
+)
+@patch("subprocess.run")
+@patch("requests.post")
+@patch("requests.get")
+def test_send_pull_request_appends_try_suffix_for_existing_branch(
+    mock_get,
+    mock_post,
+    mock_run,
+    mock_github_issue,
+    mock_output_dir,
+    existing,
+    expected_branch,
+):
+    repo_path = os.path.join(mock_output_dir, "repo")
+
+    mock_get.side_effect = _make_get({b: True for b in existing})
+    mock_post.return_value.json.return_value = {
+        "html_url": "https://github.com/test-owner/test-repo/pull/1"
+    }
+    mock_run.side_effect = [
+        MagicMock(returncode=0),  # git checkout -b
+        MagicMock(returncode=0),  # git push
+    ]
+
+    result = send_pull_request(
+        github_issue=mock_github_issue,
+        github_token="test-token",
+        github_username="test-user",
+        patch_dir=repo_path,
+        pr_type="branch",
+    )
+
+    checkout_call, push_call = mock_run.call_args_list
+    assert checkout_call == call(
+        f"git -C {repo_path} checkout -b {expected_branch}",
+        shell=True,
+        capture_output=True,
+        text=True,
+    )
+    assert push_call == call(
+        f"git -C {repo_path} push https://test-user:test-token@github.com/"
+        f"test-owner/test-repo.git {expected_branch}",
+        shell=True,
+        capture_output=True,
+        text=True,
+    )
+    assert result == (
+        f"https://github.com/test-owner/test-repo/compare/{expected_branch}?expand=1"
+    )
+
+
+@patch("subprocess.run")
+@patch("requests.post")
+@patch("requests.get")
+def test_send_pull_request_branch_check_error_raises(
+    mock_get, mock_post, mock_run, mock_github_issue, mock_output_dir
+):
+    """A non-200/404 status while checking the branch must raise."""
+    repo_path = os.path.join(mock_output_dir, "repo")
+
+    def fake_get(url, headers=None, **kwargs):
+        resp = MagicMock()
+        if "/branches/" not in url:
+            resp.status_code = 200
+            resp.json.return_value = {"default_branch": "main"}
+            return resp
+        resp.status_code = 500
+        resp.raise_for_status.side_effect = RuntimeError("boom")
+        return resp
+
+    mock_get.side_effect = fake_get
+    mock_run.side_effect = [
+        MagicMock(returncode=0),  # git checkout -b
+        MagicMock(returncode=0),  # git push
+    ]
+
+    with pytest.raises(RuntimeError):
+        send_pull_request(
+            github_issue=mock_github_issue,
+            github_token="test-token",
+            github_username="test-user",
+            patch_dir=repo_path,
+            pr_type="branch",
+        )
