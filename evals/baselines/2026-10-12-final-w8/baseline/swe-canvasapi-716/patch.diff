diff --git a/tests/tw_repro/test_issue_533.py b/tests/tw_repro/test_issue_533.py
new file mode 100644
index 0000000..6f4c7bd
--- /dev/null
+++ b/tests/tw_repro/test_issue_533.py
@@ -0,0 +1,77 @@
+"""Repro for: `obj_or_str` improperly rejects strings.
+
+`obj_or_str` should behave like `obj_or_id`: if the caller passes a plain
+string (e.g. a feature name), it should be returned unchanged. If an object
+of one of the accepted types is passed, the named attribute should be
+extracted and returned as a string.
+"""
+
+import unittest
+
+import requests_mock
+
+from canvasapi import Canvas
+from canvasapi.feature import Feature
+from canvasapi.util import obj_or_str
+from tests import settings
+from tests.util import register_uris
+
+
+@requests_mock.Mocker()
+class TestObjOrStrStr(unittest.TestCase):
+    def setUp(self):
+        self.canvas = Canvas(settings.BASE_URL, settings.API_KEY)
+
+    def test_obj_or_str_str(self, m):
+        """A plain str is returned unchanged (like obj_or_id does for ints)."""
+        result = obj_or_str("epub_export", "name", (Feature,))
+        self.assertIsInstance(result, str)
+        self.assertEqual(result, "epub_export")
+
+    def test_obj_or_str_obj(self, m):
+        """An object of an accepted type still yields its attribute as str."""
+        register_uris({"account": ["get_by_id", "get_features"]}, m)
+        account = self.canvas.get_account(1)
+        feature = account.get_features()[0]
+        result = obj_or_str(feature, "name", (Feature,))
+        self.assertIsInstance(result, str)
+        self.assertEqual(result, "epub_export")
+
+
+@requests_mock.Mocker()
+class TestFeatureFlagStrCallSites(unittest.TestCase):
+    """All documented call sites should accept a str feature name."""
+
+    def setUp(self):
+        self.canvas = Canvas(settings.BASE_URL, settings.API_KEY)
+
+        with requests_mock.Mocker() as m:
+            requires = {
+                "account": ["get_by_id"],
+                "course": ["get_by_id"],
+                "user": ["get_by_id"],
+            }
+            register_uris(requires, m)
+
+            self.account = self.canvas.get_account(1)
+            self.course = self.canvas.get_course(1)
+            self.user = self.canvas.get_user(1)
+
+    def test_account_get_feature_flag_str(self, m):
+        register_uris({"account": ["get_feature_flag"]}, m)
+        flag = self.account.get_feature_flag("epub_export")
+        self.assertEqual(flag.feature, "epub_export")
+
+    def test_course_get_feature_flag_str(self, m):
+        register_uris({"course": ["get_feature_flag"]}, m)
+        flag = self.course.get_feature_flag("epub_export")
+        self.assertEqual(flag.feature, "epub_export")
+
+    def test_user_get_feature_flag_str(self, m):
+        register_uris({"user": ["get_feature_flag"]}, m)
+        flag = self.user.get_feature_flag("high_contrast")
+        self.assertEqual(flag.feature, "high_contrast")
+
+
+if __name__ == "__main__":
+    unittest.main()
