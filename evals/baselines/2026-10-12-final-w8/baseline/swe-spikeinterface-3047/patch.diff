+"""
+Repro for: `select_units` fails in `SortingAnalyzer` after using `load_sorting_analyzer`.
+
+After saving a SortingAnalyzer to binary_folder and reloading it, calling
+`select_units` raises `TypeError: unhashable type: 'numpy.ndarray'`.
+
+Root cause: the extension `info.json` file (importing provenance) is loaded
+into `extension.data` under the key "info" by `AnalyzerExtension.load_data`,
+and then `_select_extension_data` tries to index that dict with an array.
+"""
+
+import pytest
+
+
+def test_select_units_after_reload_binary_folder(tmp_path):
+    import spikeinterface.core as si
+
+    rec, sorting = si.generate_ground_truth_recording(num_channels=4, durations=[1.0], seed=0)
+    folder = tmp_path / "test"
+    analyzer = si.create_sorting_analyzer(sorting, rec, format="binary_folder", folder=folder)
+    analyzer.compute(["random_spikes", "waveforms", "templates"])
+
+    new_analyzer = si.load_sorting_analyzer(folder=folder)
+
+    # The importing provenance ("info") must NOT pollute the extension data.
+    for ext_name, ext in new_analyzer.extensions.items():
+        assert "info" not in ext.data, f"'info' leaked into data of extension {ext_name}"
+
+    # select_units must work after reloading
+    selected = new_analyzer.select_units(unit_ids=[1])
+    assert selected.unit_ids == [1]
+
+    # And the extension data must be correctly sliced
+    templates = selected.get_extension("templates")
+    assert templates.data["average"].shape[0] == 1
