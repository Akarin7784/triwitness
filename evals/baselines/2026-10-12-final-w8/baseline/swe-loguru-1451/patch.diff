diff --git a/tests/tw_repro/test_issue_missing_format_key.py b/tests/tw_repro/test_issue_missing_format_key.py
new file mode 100644
index 0000000..5dfe841
--- /dev/null
+++ b/tests/tw_repro/test_issue_missing_format_key.py
@@ -0,0 +1,62 @@
+import pytest
+
+from loguru import logger
+
+
+def test_catch_true_reports_missing_key(writer, capsys):
+    logger.remove()
+    logger.add(writer, format="{nonexistent}", catch=True)
+
+    logger.info("Hello world")
+
+    out, err = capsys.readouterr()
+    assert out == ""
+    assert err != ""
+
+    # The diagnostic must clearly name the missing key.
+    assert "nonexistent" in err
+    assert "Invalid format key" in err
+
+    # The diagnostic must be actionable: mention "logger.bind()" and "extra[key]".
+    assert "logger.bind(" in err
+    assert "extra[" in err
+
+    # The diagnostic must list the available record keys.
+    for key in ("elapsed", "exception", "extra", "file", "level", "message"):
+        assert key in err
+
+
+def test_catch_true_does_not_crash(writer, capsys):
+    logger.remove()
+    logger.add(writer, format="{nonexistent}", catch=True)
+
+    # Multiple calls must not raise and the logger must keep working.
+    logger.info("first")
+    logger.info("second")
+
+    out, err = capsys.readouterr()
+    assert out == ""
+    assert err.count("nonexistent") >= 2
+
+
+def test_catch_false_raises_keyerror_with_key_and_guidance(writer):
+    logger.remove()
+    logger.add(writer, format="{nonexistent}", catch=False)
+
+    with pytest.raises(KeyError) as excinfo:
+        logger.info("Hello world")
+
+    message = str(excinfo.value)
+    assert "nonexistent" in message
+    assert "logger.bind(" in message
+    assert "extra[" in message
+
+
+def test_patcher_keys_still_supported(writer):
+    logger.remove()
+    logger.configure(patcher=lambda record: record.update(custom_key="patched"))
+    logger.add(writer, format="{custom_key} {message}", catch=False)
+
+    logger.info("Hello world")
+
+    assert writer.read() == "patched Hello world\n"
