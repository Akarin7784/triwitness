index 342d0b0..d80b306 100644
--- a/CHANGELOG.rst
+++ b/CHANGELOG.rst
@@ -1,6 +1,7 @@
 `Unreleased`_
 =============
 
+- Improve feedback when a format string passed to ``logger.add()`` references an invalid key, by naming the missing key, listing the available record keys, and suggesting the use of ``logger.bind()`` with ``{extra[key]}``.
 - Change the default log format to include the timezone offset since it produces less ambiguous logs (`#856 <https://github.com/Delgan/loguru/pull/856>`_, thanks `@tim-x-y-z <https://github.com/tim-x-y-z>`_).
 - Add new ``logger.reinstall()`` method to automatically set up the ``logger`` in spawned child processes (`#818 <https://github.com/Delgan/loguru/issues/818>`_, thanks `@monchin <https://github.com/monchin>`_).
 - Fix incorrect microsecond value when formatting the log timestamp using ``{time:x}`` (`#1440 <https://github.com/Delgan/loguru/issues/1440>`_).
diff --git a/loguru/_colorizer.py b/loguru/_colorizer.py
index 7cffe4d..99b1fa9 100644
--- a/loguru/_colorizer.py
+++ b/loguru/_colorizer.py
@@ -23,6 +23,47 @@ def try_formatting(*exceptions):
         ) from e
 
 
+def make_missing_key_error(key, record):
+    try:
+        available = ", ".join(repr(k) for k in sorted(record))
+    except Exception:
+        available = "<unknown>"
+    return KeyError(
+        "Invalid format key: %r was not found in the record.\n"
+        "Available keys are: %s.\n"
+        "To reference a custom value in the format string, add it with "
+        "`logger.bind(%s=value)` and use `{extra[%s]}` (or a patcher).\n"
+        % (key, available, key, key)
+    )
+
+
+def make_missing_extra_key_error(key, extra):
+    try:
+        available = ", ".join(repr(k) for k in sorted(extra))
+    except Exception:
+        available = "<unknown>"
+    return KeyError(
+        "Invalid format key: 'extra[%s]' was not found in the record.\n"
+        "Available extra keys are: %s.\n"
+        "To add a custom value, use `logger.bind(%s=value)` and reference it as "
+        "`{extra[%s]}` (or a patcher).\n" % (key, available, key, key)
+    )
+
+
+class RecordMapping(dict):
+    """A mapping used to format records, raising an explicit error on missing keys."""
+
+    def __missing__(self, key):
+        raise make_missing_key_error(key, dict(self)) from None
+
+
+class ExtraMapping(dict):
+    """A mapping wrapping the record "extra" dict, with an explicit error on missing keys."""
+
+    def __missing__(self, key):
+        raise make_missing_extra_key_error(key, dict(self)) from None
+
+
