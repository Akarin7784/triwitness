diff --git a/tests/tw_repro/test_issue_3734.py b/tests/tw_repro/test_issue_3734.py
new file mode 100644
index 0000000..d479816
--- /dev/null
+++ b/tests/tw_repro/test_issue_3734.py
@@ -0,0 +1,40 @@
+"""
+Reproduction for issue: `aggregate_units` doesn't propagate properties when
+string lengths don't match.
+
+Two sortings have the same string property (e.g. labels), but the string
+dtypes differ (e.g. "<U4" vs "<U2") because the max string length is
+different. The dtype comparison in UnitsAggregationSorting drops the
+property instead of merging it.
+
+See https://github.com/SpikeInterface/spikeinterface BLOCKED link
+"""
+
+import numpy as np
+
+from spikeinterface.core import generate_sorting, aggregate_units
+
+
+def test_aggregate_units_string_property_different_lengths():
+    num_units1 = 2
+    num_units2 = 3
+
+    sorting1 = generate_sorting(num_units=num_units1, seed=1205)
+    sorting1.set_property("chris_label", ["good"] * sorting1.get_num_units())
+
+    sorting2 = generate_sorting(num_units=num_units2, seed=1205)
+    sorting2.set_property("chris_label", ["ok"] * sorting2.get_num_units())
+
+    # Sanity check: the string lengths (and therefore the dtypes) differ
+    assert sorting1.get_property("chris_label").dtype != sorting2.get_property("chris_label").dtype
+
+    sort = aggregate_units([sorting1, sorting2])
+
+    # The property must be propagated even though the dtypes differ
+    assert "chris_label" in sort.get_property_keys()
+    expected = np.array(["good"] * num_units1 + ["ok"] * num_units2)
+    np.testing.assert_array_equal(sort.get_property("chris_label"), expected)
+
+
+if __name__ == "__main__":
+    test_aggregate_units_string_property_different_lengths()
