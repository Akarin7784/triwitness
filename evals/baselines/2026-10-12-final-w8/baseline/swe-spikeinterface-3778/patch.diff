+def _merge_dtypes(dtype1, dtype2):
+    """
+    Merge two numpy dtypes of the same kind into a common dtype that can hold
+    the values of both.
+
+    This is mainly needed for fixed-width string dtypes (e.g. "<U4" and "<U2"),
+    which are not equal even though they are compatible: the resulting dtype uses
+    the largest string length ("<U4" in the example).
+    """
+    merged = np.result_type(dtype1, dtype2)
+    # np.result_type can fall back on a generic dtype (e.g. object) for exotic
+    # dtypes; keep the widest of the two in that case.
+    if merged.kind != dtype1.kind:
+        if dtype1.itemsize >= dtype2.itemsize:
+            merged = dtype1
+        else:
+            merged = dtype2
+    return merged
+
