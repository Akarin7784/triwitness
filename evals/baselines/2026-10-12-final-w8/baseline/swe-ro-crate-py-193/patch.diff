+"""Reproducer for "Setting/Accessing nested properties on entities without @id".
+
+Setting a nested property whose value is a dictionary that does not contain an
+``@id`` used to be accepted silently, but accessing the property afterwards
+raised ``ValueError: no @id in {...}``.
+"""
+
+import pytest
+
+from rocrate.rocrate import ROCrate
+
+
+def test_set_nested_prop_without_id_raises():
+    """Setting a dict without @id must be rejected."""
+    crate = ROCrate()
+    with pytest.raises(ValueError):
+        crate.root_dataset["license"] = {
+            "@type": "CreativeWork",
+            "name": "CC-O",
+            "url": "https://spdx.org/licenses/CC0-1.0",
+        }
+
+
+def test_set_nested_prop_without_id_list_raises():
+    """A list containing a dict without @id must be rejected too."""
+    crate = ROCrate()
+    with pytest.raises(ValueError):
+        crate.root_dataset["license"] = [
+            "https://spdx.org/licenses/CC0-1.0",
+            {
+                "@type": "CreativeWork",
+                "name": "CC-O",
+            },
+        ]
+
+
+def test_set_nested_prop_with_id_ok():
+    """A dict with an @id may still be set and round-trips through __getitem__."""
+    crate = ROCrate()
+    crate.root_dataset["license"] = {"@id": "https://spdx.org/licenses/CC0-1.0"}
+    assert crate.root_dataset["license"] == "https://spdx.org/licenses/CC0-1.0"
+
+
+def test_get_nested_prop_without_id_still_raises_after_fix():
+    """Reading a value without an @id that was loaded from metadata still raises.
+
+    The assignment-side check prevents creating such a property, but a crate
+    read from disk may still contain one; this documents the unchanged
+    read-side behavior.
+    """
+    metadata = {
+        "@context": "https://w3id.org/ro/crate/1.1/context",
+        "@graph": [
+            {
+                "@id": "ro-crate-metadata.json",
+                "@type": "CreativeWork",
+                "about": {"@id": "./"},
+                "conformsTo": {"@id": "https://w3id.org/ro/crate/1.1"},
+            },
+            {
+                "@id": "./",
+                "@type": "Dataset",
+                "license": {
+                    "@type": "CreativeWork",
+                    "name": "CC-O",
+                    "url": "https://spdx.org/licenses/CC0-1.0",
+                },
+            },
+        ],
+    }
+    crate = ROCrate(metadata)
+    with pytest.raises(ValueError):
+        crate.root_dataset["license"]
+
+
+def test_append_to_nested_prop_without_id_raises():
+    """append_to must apply the same check."""
+    crate = ROCrate()
+    with pytest.raises(ValueError):
+        crate.root_dataset.append_to("license", {"@type": "CreativeWork", "name": "CC-O"})
