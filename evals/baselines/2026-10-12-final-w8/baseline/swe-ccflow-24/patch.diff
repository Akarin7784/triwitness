diff --git a/tests/tw_repro/test_issue_14.py b/tests/tw_repro/test_issue_14.py
new file mode 100644
index 0000000..39957a0
--- /dev/null
+++ b/tests/tw_repro/test_issue_14.py
@@ -0,0 +1,86 @@
+"""Reproduction for issue: Ability to pass kwargs to CallableModel.
+
+The feature request is that one should be able to pass the kwargs of the context
+directly to the call method, and have it validate the context from them (instead
+of having to explicitly construct a Context instance or pass a dict).
+"""
+
+from typing import List
+
+import pytest
+
+from ccflow import CallableModel, ContextBase, Flow, ResultBase
+
+
+class MyContext(ContextBase):
+    a: str
+
+
+class MyExtendedContext(MyContext):
+    b: float = 0.0
+    c: bool = False
+
+
+class ListContext(ContextBase):
+    ll: List[str] = []
+
+
+class MyResult(ResultBase):
+    x: int
+    y: str
+
+
+class MyCallable(CallableModel):
+    i: int
+    ll: List[int] = []
+
+    @Flow.call
+    def __call__(self, context: MyContext) -> MyResult:
+        return MyResult(x=self.i, y=context.a)
+
+
+def test_call_with_kwargs():
+    m = MyCallable(i=5)
+    # Passing the context kwargs directly should validate a context from them
+    assert m(a="foo") == MyResult(x=5, y="foo")
+
+
+def test_call_with_kwargs_matches_context():
+    m = MyCallable(i=5)
+    assert m(a="foo") == m(MyContext(a="foo"))
+
+
+def test_call_with_kwargs_defaults():
+    m = MyCallable(i=5)
+    assert m(a="foo") == m({"a": "foo"})
+
+
+def test_non_default_call_with_kwargs():
+    class MyModel(CallableModel):
+        @Flow.call
+        def foo(self, context: MyContext) -> MyResult:
+            return MyResult(x=1, y=context.a)
+
+        @Flow.call
+        def __call__(self, context: MyContext) -> MyResult:
+            return self.foo(context)
+
+    m = MyModel()
+    assert m.foo(a="foo") == MyResult(x=1, y="foo")
+    assert m(a="foo") == MyResult(x=1, y="foo")
+
+
+def test_kwargs_validation_error():
+    """Invalid kwargs should raise a validation error (like passing a bad dict)."""
+    from pydantic import ValidationError
+
+    m = MyCallable(i=5)
+    with pytest.raises(ValidationError):
+        m(nonexistent_field="foo")
+
+
+def test_kwargs_and_positional_conflict():
+    """Providing both a positional context and kwargs is ambiguous and should error."""
+    m = MyCallable(i=5)
+    with pytest.raises(TypeError):
+        m(MyContext(a="foo"), a="bar")
