+class ManagedIdentityAssertion(AssertionCreator):
+    """Feed an instance of this class to a ConfidentialClientApplication's
+    ``client_credential`` parameter (or its ``client_assertion`` counterpart),
+    so that this app can use a FIC (Federated Identity Credential) whose
+    assertion is the Managed Identity token.
+
+    This is an experimental feature.
+
+    The claims are exposed here, so that the claims challenge obtained by the
+    downstream app can be relayed into the Managed Identity request, which in
+    turn bypasses the Managed Identity token cache.
+    """
+    def __init__(self, client, resource):
+        """
+        :param client:
+            An instance of :class:`ManagedIdentityClient` which will be used to
+            obtain the Managed Identity token.
+        :param str resource:
+            The resource of the Managed Identity token.
+        """
+        self._client = client
+        self._resource = resource
+
+    def create_normal_assertion(
+            self, audience, issuer, subject=None, expires_at=None, expires_in=600,
+            issued_at=None, assertion_id=None, **kwargs):
+        """Create an assertion by obtaining a Managed Identity token.
+
+        The claims challenge, if any, is relayed to the Managed Identity client,
+        which will then bypass its own token cache.
+        """
+        return _str2bytes(self._client.acquire_token_for_client(
+            resource=self._resource,
+            claims_challenge=kwargs.get("claims_challenge"),
+            )["access_token"])
+
+    def create_regenerative_assertion(
+            self, audience, issuer, subject=None, expires_in=600, **kwargs):
+        """Same as the base class, except that when a claims challenge is present,
+        the assertion shall be regenerated on every call, so that the claims
+        challenge can be relayed to the Managed Identity client every time.
+        """
+        if kwargs.get("claims_challenge"):
+            # Do not use AutoRefresher, otherwise the (cached) assertion
+            # would not honor the per-request claims challenge.
+            def regenerated(claims_challenge=kwargs.get("claims_challenge")):
+                return self.create_normal_assertion(
+                    audience, issuer, subject,
+                    claims_challenge=claims_challenge)
+            return regenerated
+        return super(ManagedIdentityAssertion, self).create_regenerative_assertion(
+            audience, issuer, subject, expires_in=expires_in, **kwargs)
+
+
