diff --git a/tests/tw_repro/test_issue_claims_mi.py b/tests/tw_repro/test_issue_claims_mi.py
new file mode 100644
index 0000000..b42e294
--- /dev/null
+++ b/tests/tw_repro/test_issue_claims_mi.py
@@ -0,0 +1,189 @@
+"""Repro for: Implement Claims API to Bypass Cache When Claims are Present in MSAL with Managed Identity
+
+Expected behavior (from the Issue):
+  * MSAL for Managed Identity exposes a claims API, i.e.
+    ``ManagedIdentityClient.acquire_token_for_client(..., claims_challenge=...)``.
+  * When claims are present in the token request, the token cache shall be bypassed
+    so that a fresh token is requested from the Managed Identity endpoint.
+  * The claims shall NOT be forwarded to the (unchanged) MSI v1 endpoint.
+  * The MI assertion provider (used for FIC) shall expose claims too.
+
+This test fails on the original code:
+  - ``acquire_token_for_client(resource=..., claims_challenge=...)`` raises TypeError
+    (unexpected keyword argument), because the claims API is not implemented.
+  - ``msal.ManagedIdentityAssertion`` does not exist.
+"""
+import json
+import time
+import unittest
+
+from tests.http_client import MinimalResponse
+from msal import (
+    SystemAssignedManagedIdentity,
+    ManagedIdentityClient,
+)
+from msal.token_cache import is_subdict_of
+
+
+CLAIMS = '{"access_token":{"nbf":{"essential":true,"value":"%s"}}}' % int(time.time())
+
+
+class ManagedIdentityClaimsTestCase(unittest.TestCase):
+    def setUp(self):
+        self.app = ManagedIdentityClient(
+            SystemAssignedManagedIdentity(),
+            http_client=self._HttpClient(),
+            )
+
+    class _HttpClient(object):
+        def __init__(self):
+            self.call_count = 0
+        def get(self, url, params=None, headers=None, **kwargs):
+            self.call_count += 1
+            return MinimalResponse(
+                status_code=200,
+                text='{"access_token": "AT%s", "expires_in": "7890", "resource": "R"}' % (
+                    self.call_count),
+                )
+        def close(self):
+            pass
+
+    def test_claims_challenge_is_accepted_and_bypasses_cache(self):
+        # 1st call: no claims -> obtain a token and populate the cache
+        first = self.app.acquire_token_for_client(resource="R")
+        self.assertEqual("AT1", first["access_token"])
+        call_count = self.app._http_client.http_client.call_count
+
+        # 2nd call: no claims -> served from cache
+        second = self.app.acquire_token_for_client(resource="R")
+        self.assertEqual("AT1", second["access_token"], "Should hit the cache")
+        self.assertEqual(
+            call_count, self.app._http_client.http_client.call_count,
+            "A cache hit should not trigger a new http call")
+
+        # 3rd call: claims present -> cache must be bypassed
+        third = self.app.acquire_token_for_client(
+            resource="R", claims_challenge=CLAIMS)
+        self.assertNotEqual(
+            "AT1", third["access_token"],
+            "Claims challenge shall bypass the cache and fetch a new token")
+        self.assertTrue(is_subdict_of(
+            {"access_token": "AT2", "token_type": "Bearer"}, third))
+        self.assertEqual(
+            call_count + 1, self.app._http_client.http_client.call_count,
+            "Claims challenge shall trigger a new http call")
+
+    def test_claims_are_not_sent_to_the_endpoint(self):
+        captured = {}
+
+        def fake_get(url, params=None, headers=None, **kwargs):
+            captured["url"] = url
+            captured["params"] = params or {}
+            captured["data"] = kwargs.get("data")
+            return MinimalResponse(
+                status_code=200,
+                text='{"access_token": "AT", "expires_in": "7890", "resource": "R"}',
+                )
+
+        self.app._http_client.get = fake_get
+        self.app.acquire_token_for_client(resource="R", claims_challenge=CLAIMS)
+        self.assertNotIn("claims", captured["params"], "MSI v1 endpoint is unchanged")
+
+    def test_claims_challenge_defaults_to_none(self):
+        result = self.app.acquire_token_for_client(resource="R")
+        self.assertEqual("access_token", next(iter(result)))
+
+
+class ManagedIdentityAssertionTestCase(unittest.TestCase):
+    """The MI assertion provider used by FIC shall expose claims too."""
+
+    def test_assertion_provider_exists_and_forwards_claims(self):
+        import msal
+        self.assertTrue(hasattr(msal, "ManagedIdentityAssertion"))
+        from msal.managed_identity import ManagedIdentityAssertion
+
+        recorded = {}
+
+        class _FakeClient(object):
+            def acquire_token_for_client(self, *, resource, claims_challenge=None):
+                recorded["resource"] = resource
+                recorded["claims_challenge"] = claims_challenge
+                return {"access_token": "AT"}
+
+        provider = ManagedIdentityAssertion(
+            client=_FakeClient(), resource="R")
+        assertion = provider.create_normal_assertion(
+            audience="audience", issuer="issuer", claims_challenge=CLAIMS)
+        self.assertEqual(b"AT", assertion)
+        self.assertEqual("R", recorded["resource"])
+        self.assertEqual(
+            CLAIMS, recorded["claims_challenge"],
+            "The MI assertion provider shall forward claims to the MI client")
+
+    def test_assertion_provider_works_as_client_credential_for_fic(self):
+        import msal
+        from unittest.mock import patch
+        from msal.authority import tenant_discovery
+
+        base = "https://login.microsoftonline.com/my_tenant/oauth2/v2.0"
+        wellknown = json.dumps({
+            "authorization_endpoint": base + "/authorize",
+            "token_endpoint": base + "/token",
+            "issuer": "https://login.microsoftonline.com/my_tenant/v2.0",
+            "device_authorization_endpoint": base + "/devicecode",
+        })
+
+        class FakeMIHttp(object):
+            def __init__(self):
+                self.calls = 0
+            def get(self, url, params=None, headers=None, **kwargs):
+                self.calls += 1
+                return MinimalResponse(status_code=200, text=(
+                    '{"access_token": "MI_AT%s", "expires_in": "7890", '
+                    '"resource": "MI_RESOURCE"}') % self.calls)
+            def close(self):
+                pass
+
+        mi_http = FakeMIHttp()
+        mi = msal.ManagedIdentityClient(
+            SystemAssignedManagedIdentity(), http_client=mi_http)
+        provider = msal.ManagedIdentityAssertion(client=mi, resource="MI_RESOURCE")
+
+        with patch("msal.authority.tenant_discovery",
+                   side_effect=lambda endpoint, http_client, **kw: json.loads(wellknown)):
+            app = msal.ConfidentialClientApplication(
+                "my_client_id",
+                authority="https://login.microsoftonline.com/my_tenant",
+                client_credential=provider)
+
+        captured = {}
+
+        def mock_post(url, headers=None, *args, **kwargs):
+            captured.update(kwargs)
+            return MinimalResponse(status_code=200, text=json.dumps({
+                "access_token": "CCA_AT", "token_type": "Bearer", "expires_in": 3600,
+                }))
+
+        # Without claims: the MI token is cached and reused for the assertion
+        app.acquire_token_for_client(["scope"], post=mock_post)
+        self.assertEqual(
+            b"MI_AT1", captured["data"].get("client_assertion"),
+            "MI assertion shall be used as the client assertion")
+        app.acquire_token_for_client(["scope"], post=mock_post)
+        self.assertEqual(
+            b"MI_AT1", captured["data"].get("client_assertion"),
+            "MI token should come from the MI cache when no claims are present")
+
+        # With claims: the MI cache shall be bypassed, so a fresh MI token is used
+        app.acquire_token_for_client(
+            ["scope"], claims_challenge=CLAIMS, post=mock_post)
+        self.assertEqual(
+            b"MI_AT2", captured["data"].get("client_assertion"),
+            "Claims shall bypass the MI cache and use a fresh MI token")
+        self.assertEqual(
+            CLAIMS, captured["data"].get("claims"),
+            "The claims shall also be sent to the downstream AAD endpoint")
+
+
+if __name__ == "__main__":
+    unittest.main()
