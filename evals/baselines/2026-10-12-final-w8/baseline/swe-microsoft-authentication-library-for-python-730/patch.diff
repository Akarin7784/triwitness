+def _accepts_claims_challenge(assertion_callable):
+    """Return True if the callable optionally accepts a claims_challenge kwarg."""
+    try:
+        import inspect
+        signature = inspect.signature(assertion_callable)
+    except (TypeError, ValueError):  # E.g., some built-ins have no signature
+        return False
+    for name, param in signature.parameters.items():
+        if name == "claims_challenge" and param.kind in (
+                param.POSITIONAL_OR_KEYWORD, param.KEYWORD_ONLY):
+            return True
+    return any(  # E.g., it accepts **kwargs, so we optimistically pass the claim
+        param.kind == param.VAR_KEYWORD for param in signature.parameters.values())
+
