diff --git a/tests/tw_repro/test_issue_ai.py b/tests/tw_repro/test_issue_ai.py
new file mode 100644
index 0000000..9038628
--- /dev/null
+++ b/tests/tw_repro/test_issue_ai.py
@@ -0,0 +1,68 @@
+"""Repro for: richer typed handling for BigQuery AI.* scalar functions.
+
+The issue asks for `AI.EMBED`, `AI.SIMILARITY` and `AI.GENERATE` to be parsed into
+richer typed AST nodes instead of a generic `Dot` wrapping an `Anonymous` function,
+while keeping round trip behavior backward compatible.
+"""
+
+import unittest
+
+from sqlglot import parse_one
+from sqlglot import expressions as exp
+
+
+class TestBigQueryAIScalarFunctions(unittest.TestCase):
+    def _function(self, sql):
+        node = parse_one(sql, dialect="bigquery").expressions[0]
+        self.assertIsInstance(node, exp.Dot)
+        return node.expression
+
+    def test_ai_embed(self):
+        fn = self._function("SELECT AI.EMBED('hello')")
+        self.assertIsInstance(fn, exp.AIEmbed)
+        self.assertEqual(
+            parse_one("SELECT AI.EMBED('hello')", dialect="bigquery").sql(dialect="bigquery"),
+            "SELECT AI.EMBED('hello')",
+        )
+
+    def test_ai_similarity(self):
+        fn = self._function("SELECT AI.SIMILARITY('a', 'b')")
+        self.assertIsInstance(fn, exp.AISimilarity)
+        self.assertEqual(
+            parse_one("SELECT AI.SIMILARITY('a', 'b')", dialect="bigquery").sql(
+                dialect="bigquery"
+            ),
+            "SELECT AI.SIMILARITY('a', 'b')",
+        )
+
+    def test_ai_generate(self):
+        fn = self._function("SELECT AI.GENERATE('Write a haiku')")
+        self.assertIsInstance(fn, exp.AIGenerate)
+        self.assertEqual(
+            parse_one("SELECT AI.GENERATE('Write a haiku')", dialect="bigquery").sql(
+                dialect="bigquery"
+            ),
+            "SELECT AI.GENERATE('Write a haiku')",
+        )
+
+    def test_rich_arguments(self):
+        # Arguments should be semantically accessible, not just positional Anonymous args
+        embed = self._function(
+            "SELECT AI.EMBED('hello', connection_id => 'us.example', endpoint => 'text-embedding-005')"
+        )
+        self.assertIsInstance(embed.this, exp.Literal)
+        self.assertTrue(embed.args.get("connection_id"))
+        self.assertTrue(embed.args.get("endpoint"))
+
+        generate = self._function(
+            "SELECT AI.GENERATE('Write a haiku', connection_id => 'us.example', "
+            "endpoint => 'gemini-2.0-flash', model_params => JSON '{}')"
+        )
+        self.assertIsInstance(generate.this, exp.Literal)
+        self.assertTrue(generate.args.get("connection_id"))
+        self.assertTrue(generate.args.get("endpoint"))
+        self.assertTrue(generate.args.get("model_params"))
+
+
+if __name__ == "__main__":
+    unittest.main()
