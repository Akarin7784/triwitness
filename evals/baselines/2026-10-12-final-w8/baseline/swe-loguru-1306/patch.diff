index 0000000..72997f4
--- /dev/null
+++ b/tests/tw_repro/test_issue_force_color.py
@@ -0,0 +1,77 @@
+"""Reproduction test for "Support for FORCE_COLOR" (https://force-color.org/).
+
+Expected behavior: setting the ``FORCE_COLOR`` environment variable should force
+colorization to be enabled by default, even for non-TTY streams. This mirrors the
+existing ``NO_COLOR`` support but in the opposite direction.
+"""
+
+import os
+import sys
+
+import pytest
+
+from loguru import logger
+from loguru._colorama import should_colorize
+
+from tests.conftest import StreamIsattyFalse, StreamIsattyTrue, parse
+
+
+@pytest.fixture(autouse=True)
+def clear_environment():
+    env = os.environ.copy()
+    os.environ.clear()
+    yield
+    os.environ.update(env)
+
+
+@pytest.mark.parametrize(
+    "patched",
+    ["__stdout__", "__stderr__", "stdout", "stderr", ""],
+)
+def test_honor_force_color_standard(monkeypatch, patched):
+    stream = StreamIsattyFalse()
+    with monkeypatch.context() as context:
+        context.setitem(os.environ, "FORCE_COLOR", "1")
+        context.setattr(sys, patched, stream, raising=False)
+        assert should_colorize(stream) is True
+
+
+@pytest.mark.parametrize(
+    ("force_color", "expected"),
+    [
+        ("1", True),
+        ("true", True),
+        ("", True),
+    ],
+)
+def test_force_color_presence_enables_color(monkeypatch, force_color, expected):
+    stream = StreamIsattyFalse()
+    with monkeypatch.context() as context:
+        context.setitem(os.environ, "FORCE_COLOR", force_color)
+        assert should_colorize(stream) is expected
+
+
+def test_no_color_takes_precedence_over_force_color(monkeypatch):
+    stream = StreamIsattyTrue()
+    with monkeypatch.context() as context:
+        context.setitem(os.environ, "NO_COLOR", "1")
+        context.setitem(os.environ, "FORCE_COLOR", "1")
+        assert should_colorize(stream) is False
+
+
+def test_force_color_does_not_override_explicit_argument(monkeypatch):
+    stream = StreamIsattyFalse()
+    with monkeypatch.context() as context:
+        context.setitem(os.environ, "FORCE_COLOR", "1")
+        logger.add(stream, format="<blue>{message}</blue>", colorize=None)
+        logger.debug("Message")
+        assert stream.getvalue() == parse("<blue>Message</blue>\n")
+
+
+def test_explicit_colorize_false_wins_over_force_color(monkeypatch):
+    stream = StreamIsattyFalse()
+    with monkeypatch.context() as context:
+        context.setitem(os.environ, "FORCE_COLOR", "1")
+        logger.add(stream, format="<blue>{message}</blue>", colorize=False)
+        logger.debug("Message")
+        assert stream.getvalue() == "Message\n"
