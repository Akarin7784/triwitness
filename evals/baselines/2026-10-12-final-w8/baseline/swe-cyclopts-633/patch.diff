+"""Repro: duplicate negative shown in help for a ``bool | None`` parameter.
+
+Issue: a parameter annotated ``Annotated[bool | None, Parameter(negative="--negative")]``
+shows ``--negative`` twice in the help text.
+"""
+
+from typing import Annotated
+
+from cyclopts import App, Parameter
+
+
+def test_get_negatives_bool_none_union_no_duplicate():
+    p = Parameter(negative="--negative", name=("--param",))
+    assert ("--negative",) == p.get_negatives(bool | None)
+
+
+def test_help_no_duplicate_negative_for_bool_none_union(console):
+    app = App(result_action="return_value")
+
+    @app.default
+    def cmd(
+        *,
+        param: Annotated[bool | None, Parameter(negative="--negative")] = None,
+    ):
+        pass
+
+    with console.capture() as capture:
+        app(["--help"], console=console)
+
+    help_text = capture.get()
+    assert help_text.count("--negative") == 1, help_text
