+"""
+Reproduction for: adding an outer legend (loc='r') to a non-border axis
+removes its y-axis tick labels when the figure uses sharey='labs' and one
+of the axes has been hidden.
+
+The outer legend creates a hidden ("filled") panel on the right side of the
+axis. That filled panel used to promote the main axes to full tick-label
+sharing (level 3), after which the figure-level tick-label sharing logic
+stripped the left tick labels from the middle axes because it is not on the
+left figure border.
+"""
+
+import matplotlib
+
+matplotlib.use("Agg")
+
+import ultraplot as uplt  # noqa: E402
+
+
+def _labelleft(ax):
+    params = ax.yaxis.get_tick_params()
+    # "labelleft" is stable across the supported matplotlib versions
+    return params.get("labelleft")
+
+
+def test_outer_legend_border_labels_with_hidden_axis():
+    fig, axs = uplt.subplots(ncols=3, sharey="labs")
+    axs[-1].set_visible(False)
+    for ax in axs[:-1]:
+        ax.plot([0, 1], [0, 1], label="line")
+
+    fig.canvas.draw()
+    before = [_labelleft(ax) for ax in axs]
+
+    # Adding an outer legend must not hide the y-axis tick labels of the
+    # middle (non-border) axes.
+    axs[-2].legend(loc="r")
+    fig.canvas.draw()
+    after = [_labelleft(ax) for ax in axs]
+
+    assert before == [True, True, True]
+    assert after == [True, True, True], (
+        f"outer legend changed y tick label visibility: before={before} after={after}"
+    )
+
+
+def test_outer_legend_border_labels_without_hidden_axis():
+    # Same situation but with all three axes visible.
+    fig, axs = uplt.subplots(ncols=3, sharey="labs")
+    for ax in axs[:-1]:
+        ax.plot([0, 1], [0, 1], label="line")
+
+    fig.canvas.draw()
+    axs[-2].legend(loc="r")
+    fig.canvas.draw()
+
+    # sharey='labs' only shares axis *labels* (level 1), so every axis keeps
+    # its own tick labels -- the legend must not change that.
+    assert [_labelleft(ax) for ax in axs] == [True, True, True]
