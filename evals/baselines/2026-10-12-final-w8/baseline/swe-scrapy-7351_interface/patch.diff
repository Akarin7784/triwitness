diff --git a/tests/tw_repro/test_issue_1.py b/tests/tw_repro/test_issue_1.py
new file mode 100644
index 0000000..c7603cd
--- /dev/null
+++ b/tests/tw_repro/test_issue_1.py
@@ -0,0 +1,78 @@
+"""Repro for: DownloaderAwarePriorityQueue starves slots on active-count ties.
+
+When all candidate slots report the same active-download count, ``pop()`` must
+rotate through the available slots (round-robin) instead of always picking the
+first (lexicographically smallest) one.  The rotation is observable through the
+``DOWNLOAD_SLOT`` metadata of the returned requests.
+"""
+
+from unittest.mock import Mock
+
+from scrapy.core.downloader import Downloader
+from scrapy.http.request import Request
+from scrapy.pqueues import DownloaderAwarePriorityQueue
+from scrapy.spiders import Spider
+from scrapy.squeues import FifoMemoryQueue
+from scrapy.utils.test import get_crawler
+from tests.test_scheduler import MockDownloader
+
+
+def _make_queue():
+    crawler = get_crawler(Spider)
+    crawler.engine = Mock(downloader=MockDownloader())
+    return DownloaderAwarePriorityQueue.from_crawler(
+        crawler=crawler,
+        downstream_queue_cls=FifoMemoryQueue,
+        key="foo/bar",
+    )
+
+
+def _push(queue, slot, n=1):
+    for i in range(n):
+        request = Request(f"https://example.org/{slot}/{i}")
+        request.meta[Downloader.DOWNLOAD_SLOT] = slot
+        queue.push(request)
+
+
+def test_two_slots_equal_active_alternate():
+    queue = _make_queue()
+    try:
+        _push(queue, "aaa", 3)
+        _push(queue, "bbb", 3)
+
+        popped = [queue.pop().meta[Downloader.DOWNLOAD_SLOT] for _ in range(6)]
+        # Both slots start with equal (zero) active counts, so pops must
+        # alternate between them while both remain non-empty.
+        assert popped == ["aaa", "bbb", "aaa", "bbb", "aaa", "bbb"]
+    finally:
+        queue.close()
+
+
+def test_three_slots_equal_active_rotate():
+    queue = _make_queue()
+    try:
+        for slot in ("aaa", "bbb", "ccc"):
+            _push(queue, slot, 2)
+
+        popped = [queue.pop().meta[Downloader.DOWNLOAD_SLOT] for _ in range(6)]
+        assert popped == ["aaa", "bbb", "ccc", "aaa", "bbb", "ccc"]
+    finally:
+        queue.close()
+
+
+def test_rotation_continues_after_slot_removed():
+    queue = _make_queue()
+    try:
+        # aaa has a single request, so it empties and is removed on its first
+        # pop; rotation must continue from aaa's position rather than restart
+        # at the first slot.
+        _push(queue, "aaa", 1)
+        _push(queue, "bbb", 3)
+        _push(queue, "ccc", 3)
+
+        popped = [queue.pop().meta[Downloader.DOWNLOAD_SLOT] for _ in range(5)]
+        # aaa pops first (rotation position 0), then it is removed; the next pop
+        # must be bbb (the slot after the removed one), then ccc, then bbb...
+        assert popped == ["aaa", "bbb", "ccc", "bbb", "ccc"]
+    finally:
+        queue.close()
