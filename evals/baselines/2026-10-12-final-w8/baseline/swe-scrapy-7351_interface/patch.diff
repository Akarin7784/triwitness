+        """Return the slot with the fewest active downloads.
+
+        When several slots share the lowest active-download count, the
+        tie-breaker is a fair round-robin: the slot that follows the
+        previously selected one in the rotation order (wrapping around) wins.
+        """
+        if len(stats) == 1:
+            return stats[0][1]
+        min_active = min(active for active, _ in stats)
+        tied = {slot for active, slot in stats if active == min_active}
+        count = len(self._slot_order)
+        # Position of the slot selected by the previous call, if any.
+        try:
+            last_index = self._slot_order.index(self._last_slot)
+        except ValueError:
+            last_index = -1
+        for offset in range(1, count + 1):
+            candidate = self._slot_order[(last_index + offset) % count]
+            if candidate in tied:
+                return candidate
+        # Fallback: the rotation order does not cover the tied slots (e.g. a
+        # slot was added without being registered).
+        return min(stats)[1]
 
