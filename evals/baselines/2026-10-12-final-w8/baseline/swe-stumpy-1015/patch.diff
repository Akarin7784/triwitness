diff --git a/tests/tw_repro/test_issue_395.py b/tests/tw_repro/test_issue_395.py
new file mode 100644
index 0000000..834cd86
--- /dev/null
+++ b/tests/tw_repro/test_issue_395.py
@@ -0,0 +1,195 @@
+import numpy as np
+import numpy.testing as npt
+
+import stumpy
+
+
+def test_motifs_max_matches_none():
+    """
+    `max_matches=None` should mean "do not restrict the number of matches".
+    Previously, `max_matches=None` was converted to `np.inf` which was then
+    used to slice `query_matches`, raising:
+        TypeError: slice indices must be integers or None or have an __index__ method
+    """
+    arr = np.array([0.0, 1, 2, 2, 0, 1, 2, 2, 0, 0, 0, 0])
+    m = 3
+    mp = stumpy.stump(arr, m=m)
+
+    motif_distances, motif_indices = stumpy.motifs(
+        arr, mp[:, 0], max_matches=None, max_distance=np.inf, cutoff=np.inf
+    )
+
+    assert motif_distances.dtype != object
+    assert motif_indices.dtype != object
+
+    # The first column is always the self-match/trivial-match and the found
+    # matches should include every subsequence whose distance is within
+    # `max_distance`
+    npt.assert_array_equal(motif_indices[0], np.array([0, 4, 8, 2, 6]))
+    npt.assert_almost_equal(
+        motif_distances[0],
+        np.array([0.0, 0.0, 1.7320508075688772, 3.3460652149512318, 3.3460652149512318]),
+    )
+
+
+def test_motifs_max_matches_none_same_as_all():
+    """
+    Compare `max_matches=None` against `max_matches=T.shape[-1] - m + 1` (i.e.
+    the maximum possible number of matches). Both should be identical since no
+    more matches than that could ever be returned.
+    """
+    np.random.seed(0)
+    T = np.random.rand(64)
+    m = 3
+    max_motifs = 3
+    max_matches = T.shape[-1] - m + 1
+
+    mp = stumpy.stump(T, m)
+
+    ref_distances, ref_indices = stumpy.motifs(
+        T,
+        mp[:, 0].astype(np.float64),
+        max_matches=max_matches,
+        max_motifs=max_motifs,
+        max_distance=np.inf,
+        cutoff=np.inf,
+    )
+
+    comp_distances, comp_indices = stumpy.motifs(
+        T,
+        mp[:, 0].astype(np.float64),
+        max_matches=None,
+        max_motifs=max_motifs,
+        max_distance=np.inf,
+        cutoff=np.inf,
+    )
+
+    npt.assert_almost_equal(ref_distances, comp_distances)
+    npt.assert_almost_equal(ref_indices, comp_indices)
+
+
+def test_aamp_motifs_max_matches_none():
+    """
+    Same as above but for the non-normalized (`aamp_motifs`) version.
+    """
+    np.random.seed(0)
+    T = np.random.rand(64)
+    m = 3
+    max_motifs = 3
+    max_matches = T.shape[-1] - m + 1
+
+    mp = stumpy.aamp(T, m)
+
+    ref_distances, ref_indices = stumpy.aamp_motifs(
+        T,
+        mp[:, 0].astype(np.float64),
+        max_matches=max_matches,
+        max_motifs=max_motifs,
+        max_distance=np.inf,
+        cutoff=np.inf,
+    )
+
+    comp_distances, comp_indices = stumpy.aamp_motifs(
+        T,
+        mp[:, 0].astype(np.float64),
+        max_matches=None,
+        max_motifs=max_motifs,
+        max_distance=np.inf,
+        cutoff=np.inf,
+    )
+
+    npt.assert_almost_equal(ref_distances, comp_distances)
+    npt.assert_almost_equal(ref_indices, comp_indices)
+
+
+def test_mmotifs_max_matches_none():
+    """
+    Same as above but for the multi-dimensional (`mmotifs`) version.
+    """
+    np.random.seed(0)
+    T = np.random.rand(2, 64)
+    m = 3
+    max_motifs = 2
+    max_matches = T.shape[-1] - m + 1
+
+    mp = stumpy.mstump(T, m)
+
+    (
+        ref_distances,
+        ref_indices,
+        _,
+        _,
+    ) = stumpy.mmotifs(
+        T,
+        mp[0],
+        mp[1],
+        max_matches=max_matches,
+        max_motifs=max_motifs,
+        max_distance=np.inf,
+        cutoffs=np.inf,
+    )
+
+    (
+        comp_distances,
+        comp_indices,
+        _,
+        _,
+    ) = stumpy.mmotifs(
+        T,
+        mp[0],
+        mp[1],
+        max_matches=None,
+        max_motifs=max_motifs,
+        max_distance=np.inf,
+        cutoffs=np.inf,
+    )
+
+    npt.assert_almost_equal(ref_distances, comp_distances)
+    npt.assert_almost_equal(ref_indices, comp_indices)
+
