diff --git a/tests/tw_repro/test_issue_295.py b/tests/tw_repro/test_issue_295.py
new file mode 100644
index 0000000..77a658b
--- /dev/null
+++ b/tests/tw_repro/test_issue_295.py
@@ -0,0 +1,67 @@
+# pylint: disable=invalid-name
+# pylint: disable=missing-docstring
+# pylint: disable=unused-variable
+
+import textwrap
+import unittest
+from typing import Optional  # pylint: disable=unused-import
+
+import icontract
+import tests.error
+
+
+class TestNoDBCRegression(unittest.TestCase):
+    def test_subclass_invariant_does_not_affect_base(self) -> None:
+        # NOTE: This is a reproduction of
+        # https://github.com/Parquery/icontract/issues/295
+        #
+        # The invariant of the derived class must not "slip into" the base class
+        # if neither ``icontract.DBC`` nor ``icontract.DBCMeta`` is used.
+
+        @icontract.invariant(lambda: True)
+        class Base:
+            def __repr__(self) -> str:
+                return "an instance of {}".format(self.__class__.__name__)
+
+        @icontract.invariant(lambda: False)
+        class Derived(Base):
+            pass
+
+        # ``Base`` must remain satisfiable as only its own (true) invariant applies.
+        instance = Base()
+        self.assertIsInstance(instance, Base)
+
+        # ``Derived`` must violate its own invariant.
+        violation_error = None  # type: Optional[icontract.ViolationError]
+        try:
+            _ = Derived()
+        except icontract.ViolationError as err:
+            violation_error = err
+
+        self.assertIsNotNone(violation_error)
+        self.assertEqual(
+            textwrap.dedent("""False: self was an instance of Derived"""),
+            tests.error.wo_mandatory_location(str(violation_error)),
+        )
+
+    def test_subclass_invariant_does_not_affect_siblings(self) -> None:
+        # NOTE: Sibling classes must not be affected by an invariant defined in
+        # a sibling either (same root cause as the base-class contamination).
+
+        @icontract.invariant(lambda: True)
+        class Base:
+            pass
+
+        @icontract.invariant(lambda: False)
+        class DerivedA(Base):
+            pass
+
+        @icontract.invariant(lambda: True)
+        class DerivedB(Base):
+            pass
+
+        # ``DerivedB`` must only observe its own (true) invariant.
+        _ = DerivedB()
+
+        # The base must still be instantiable.
+        _ = Base()
