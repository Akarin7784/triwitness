diff --git a/tests/tw_repro/test_issue_2380.py b/tests/tw_repro/test_issue_2380.py
new file mode 100644
index 0000000..3c42c19
--- /dev/null
+++ b/tests/tw_repro/test_issue_2380.py
@@ -0,0 +1,38 @@
+"""Reproducer for: Comments moving bug when using import aliases.
+
+See the issue: when a ``from`` import has an alias, is too long for a single
+line and carries a comment (e.g. a ``mypy`` ``# type: ignore`` comment) at the
+end of the ``from ... import (`` line, isort incorrectly moves that comment down
+onto the alias line.
+
+Expected: no change, the comment stays on the ``from`` line because that is the
+line mypy actually complains about.
+"""
+
+import isort
+
+INPUT = (
+    "from a_long_name_to_enforce.splitting_across.two_lines import ("
+    "  # type: ignore[attr-defined]\n"
+    "    a_random_attribute as renamed_random_attribute,\n"
+    ")\n"
+)
+
+
+def test_comment_stays_on_from_line_with_alias_issue_2380():
+    assert isort.code(INPUT, profile="black") == INPUT
+
+
+def test_comment_stays_on_from_line_with_alias_issue_2380_check_code():
+    assert isort.check_code(INPUT, profile="black", show_diff=True)
+
+
+def test_comment_on_alias_line_stays_on_alias_line_issue_2380():
+    """A comment physically on the alias line must remain on the alias line."""
+    source = (
+        "from com.my_lovely_company.my_lovely_team.my_lovely_project."
+        "my_lovely_component import (\n"
+        "    MyLovelyCompanyTeamProjectComponent as component,  # DRY\n"
+        ")\n"
+    )
+    assert isort.code(source, profile="black") == source
