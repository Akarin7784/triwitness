@@ -0,0 +1,45 @@
+from tests.dialects.test_dialect import Validator
+
+
+class TestBigQueryAIForecastIssue(Validator):
+    dialect = "bigquery"
+
+    def test_ai_forecast_tvf_parses(self):
+        # The exact statement from the issue must parse without a ParseError
+        self.parse_one(
+            'SELECT * FROM AI.FORECAST(TABLE citibike_trips, data_col => "num_trips", timestamp_col => "date", horizon => 30)'
+        )
+
+    def test_ai_forecast_tvf_roundtrip_double_quotes(self):
+        # BigQuery normalizes double-quoted strings to single quotes, so the
+        # equivalent, round-trippable SQL is expected here
+        self.validate_identity(
+            "SELECT * FROM AI.FORECAST(TABLE citibike_trips, data_col => 'num_trips', timestamp_col => 'date', horizon => 30)"
+        )
+
+    def test_ai_forecast_tvf_identity(self):
+        self.validate_identity(
+            "SELECT * FROM AI.FORECAST(TABLE mydataset.mytable, data_col => 'num_trips', timestamp_col => 'date', horizon => 30)"
+        )
+
+    def test_ai_forecast_tvf_minimal(self):
+        self.validate_identity(
+            "SELECT * FROM AI.FORECAST(TABLE mydataset.mytable, timestamp_col => 'date')"
+        )
+
+    def test_ai_forecast_named_args_values(self):
+        ast = self.parse_one(
+            'SELECT * FROM AI.FORECAST(TABLE citibike_trips, data_col => "num_trips", timestamp_col => "date", horizon => 30)'
+        )
+        self.assertEqual(
+            ast.sql(dialect="bigquery"),
+            "SELECT * FROM AI.FORECAST(TABLE citibike_trips, data_col => 'num_trips', timestamp_col => 'date', horizon => 30)",
+        )
+
+    def test_ml_forecast_still_works(self):
+        self.validate_identity(
+            "SELECT * FROM ML.FORECAST(MODEL `mydataset.mymodel`, STRUCT(2 AS horizon))"
+        )
+        self.validate_identity(
+            "SELECT * FROM ML.FORECAST(MODEL `mydataset.mymodel`, TABLE `mydataset.mybqtable`, STRUCT(2 AS horizon, 4 AS confidence_level))"
+        )
