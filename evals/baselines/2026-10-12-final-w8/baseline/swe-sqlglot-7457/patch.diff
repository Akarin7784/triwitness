+    def _parse_forecast(self) -> exp.MLForecast:
+        # `AI.FORECAST` is a table-valued function, whereas `ML.FORECAST` expects a
+        # MODEL and a STRUCT of parameters, so we dispatch based on the namespace.
+        # https://cloud.google.com/bigquery/docs/reference/standard-sql/bigqueryml-syntax-ai-forecast
+        namespace = seq_get(self._tokens, self._index - 4)
+        if namespace and namespace.text.upper() == "AI":
