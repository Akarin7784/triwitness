diff --git a/tests/tw_repro/test_issue_2000.py b/tests/tw_repro/test_issue_2000.py
new file mode 100644
index 0000000..6fd5942
--- /dev/null
+++ b/tests/tw_repro/test_issue_2000.py
@@ -0,0 +1,87 @@
+"""Reproduction for: custom `tqdm_class` silently broken in non-TTY environments.
+
+Passing a custom `tqdm_class` to `hf_hub_download()` (and friends) must keep progress
+tracking working even when `sys.stderr.isatty()` is False (web servers, run_in_executor,
+Docker, subprocess, ...). Before the fix, `_get_progress_bar_context` passed
+`disable=is_tqdm_disabled(...)` (i.e. `None` in the common case) which lets tqdm
+auto-detect the TTY and set `disable=True`, making `update()` a no-op (`self.n` stays 0).
+"""
+
+import io
+import logging
+import sys
+from unittest.mock import Mock, patch
+
+import pytest
+from tqdm.auto import tqdm as base_tqdm
+
+from huggingface_hub.file_download import http_get
+from huggingface_hub.utils.tqdm import _get_progress_bar_context
+
+
+@pytest.fixture(autouse=True)
+def _force_non_tty_stderr():
+    """Simulate a non-TTY environment (web server / Docker / background thread)."""
+    fake_stderr = io.StringIO()
+    with patch.object(sys, "stderr", fake_stderr):
+        assert not sys.stderr.isatty()
+        yield fake_stderr
+
+
+class _CustomProgress(base_tqdm):
+    """Custom progress class used by users to track progress their own way."""
+
+    instances: "list[_CustomProgress]" = []
+
+    def __init__(self, *args, **kwargs):
+        kwargs.pop("name", None)  # `name` is an hf-specific kwarg not accepted by tqdm
+        super().__init__(*args, **kwargs)
+        self.updates: list[int] = []
+        _CustomProgress.instances.append(self)
+
+    def update(self, n=1):
+        super().update(n)
+        self.updates.append(n)
+
+
+def test_custom_tqdm_class_not_disabled_in_non_tty():
+    """A custom `tqdm_class` must not be auto-disabled based on TTY detection."""
+    context = _get_progress_bar_context(
+        desc="fake-file.bin",
+        log_level=logging.WARNING,  # -> `is_tqdm_disabled()` returns None (auto-detection)
+        total=100,
+        tqdm_class=_CustomProgress,
+    )
+    with context as progress:
+        assert progress.disable is False, "custom tqdm_class got disabled by TTY auto-detection"
+        progress.update(10)
+        progress.update(30)
+        assert progress.n == 40, f"progress bar total count not tracked: n={progress.n}"
+
+
+def test_http_get_custom_tqdm_class_progress_in_non_tty():
+    """End-to-end: `http_get(..., tqdm_class=...)` tracks progress in non-TTY env."""
+    _CustomProgress.instances = []
+
+    def _iter_content() -> "list[bytes]":
+        yield b"0" * 10
+        yield b"0" * 10
+
+    with patch("huggingface_hub.file_download.http_stream_backoff") as mock_stream_backoff:
+        mock_response = Mock()
+        mock_response.headers = {"Content-Length": "20"}
+        mock_response.iter_bytes.side_effect = [_iter_content()]
+        mock_stream_backoff.return_value.__enter__.return_value = mock_response
+        mock_stream_backoff.return_value.__exit__.return_value = None
+
+        temp_file = io.BytesIO()
+        http_get("fake_url", temp_file=temp_file, tqdm_class=_CustomProgress)
+
+    assert temp_file.getvalue() == b"0" * 20
+
+    # The custom progress bar created inside `http_get` must have tracked the download.
+    assert len(_CustomProgress.instances) == 1, "custom tqdm class was not instantiated"
+    bar = _CustomProgress.instances[0]
+    assert bar.total == 20
+    assert bar.updates, "update() never called on custom tqdm class"
+    assert bar.n == 20, f"custom tqdm class never tracked progress (n={bar.n}, disable={bar.disable})"
