diff --git a/tests/tw_repro/test_issue_192.py b/tests/tw_repro/test_issue_192.py
new file mode 100644
index 0000000..8998be5
--- /dev/null
+++ b/tests/tw_repro/test_issue_192.py
@@ -0,0 +1,119 @@
+"""Repro tests for: configurable memory context tag in AgentCoreMemorySessionManager.
+
+Issue: retrieved LTM is wrapped in a hardcoded XML tag. PR #271 renamed the tag to
+``<retrieved_memory>`` which is a breaking change; the rename must be reverted so the
+default tag is ``user_context`` again, and a configurable ``context_tag`` parameter on
+``AgentCoreMemoryConfig`` lets users opt into another tag (e.g. ``retrieved_memory``).
+"""
+
+from unittest.mock import Mock, patch
+
+import pytest
+from strands.hooks import MessageAddedEvent
+
+from bedrock_agentcore.memory.integrations.strands.config import (
+    AgentCoreMemoryConfig,
+    RetrievalConfig,
+)
+from bedrock_agentcore.memory.integrations.strands.session_manager import (
+    AgentCoreMemorySessionManager,
+)
+
+
+def _make_manager(context_tag=None):
+    """Build a session manager with mocked clients (mirrors existing test fixtures)."""
+    retrieval_config = {
+        "user_preferences/{actorId}/": RetrievalConfig(top_k=5, relevance_score=0.3),
+    }
+    kwargs = {}
+    if context_tag is not None:
+        kwargs["context_tag"] = context_tag
+    config = AgentCoreMemoryConfig(
+        memory_id="test-memory-123",
+        session_id="test-session-456",
+        actor_id="test-actor-789",
+        retrieval_config=retrieval_config,
+        **kwargs,
+    )
+
+    mock_memory_client = Mock()
+    mock_memory_client.retrieve_memories.return_value = [
+        {"content": {"text": "User prefers dark mode"}},
+    ]
+
+    with patch(
+        "bedrock_agentcore.memory.integrations.strands.session_manager.MemoryClient",
+        return_value=mock_memory_client,
+    ):
+        with patch("boto3.Session") as mock_boto_session:
+            mock_session = Mock()
+            mock_session.region_name = "us-west-2"
+            mock_session.client.return_value = Mock()
+            mock_boto_session.return_value = mock_session
+            with patch(
+                "strands.session.repository_session_manager.RepositorySessionManager.__init__",
+                return_value=None,
+            ):
+                manager = AgentCoreMemorySessionManager(config)
+    return manager
+
+
+def test_config_context_tag_defaults_to_user_context():
+    """Default context_tag must be 'user_context' to preserve backwards compatibility."""
+    config = AgentCoreMemoryConfig(
+        memory_id="mem-123",
+        session_id="sess-456",
+        actor_id="actor-789",
+    )
+    assert config.context_tag == "user_context"
+
+
+def test_config_context_tag_is_configurable():
+    """context_tag can be overridden, e.g. to the more semantic 'retrieved_memory'."""
+    config = AgentCoreMemoryConfig(
+        memory_id="mem-123",
+        session_id="sess-456",
+        actor_id="actor-789",
+        context_tag="retrieved_memory",
+    )
+    assert config.context_tag == "retrieved_memory"
+
+
+def test_default_injection_uses_user_context_tag():
+    """With no explicit context_tag, injected memory is wrapped in <user_context>."""
+    manager = _make_manager()
+
+    mock_agent = Mock()
+    mock_agent.messages = [{"role": "user", "content": [{"text": "What are my preferences?"}]}]
+    event = MessageAddedEvent(
+        agent=mock_agent,
+        message={"role": "user", "content": [{"text": "What are my preferences?"}]},
+    )
+    manager.retrieve_customer_context(event)
+
+    content = mock_agent.messages[-1]["content"]
+    assert len(content) == 2
+    assert "<user_context>" in content[0]["text"]
+    assert "</user_context>" in content[0]["text"]
+    assert "User prefers dark mode" in content[0]["text"]
+    # original query stays last (prefill fix preserved)
+    assert content[1]["text"] == "What are my preferences?"
+
+
+def test_custom_context_tag_injection():
+    """An explicit context_tag is used to wrap the injected memory."""
+    manager = _make_manager(context_tag="retrieved_memory")
+
+    mock_agent = Mock()
+    mock_agent.messages = [{"role": "user", "content": [{"text": "What are my preferences?"}]}]
+    event = MessageAddedEvent(
+        agent=mock_agent,
+        message={"role": "user", "content": [{"text": "What are my preferences?"}]},
+    )
+    manager.retrieve_customer_context(event)
+
+    content = mock_agent.messages[-1]["content"]
+    assert "<retrieved_memory>" in content[0]["text"]
+    assert "</retrieved_memory>" in content[0]["text"]
+    assert "<user_context>" not in content[0]["text"]
+    assert content[1]["text"] == "What are my preferences?"
