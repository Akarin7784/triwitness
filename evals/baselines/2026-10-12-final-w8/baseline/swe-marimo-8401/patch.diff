+# Copyright 2026 Marimo. All rights reserved.
+"""Reproduction for: caching fails with
+"The scope does not contain a valid 'app' instance."
+
+When a `@mo.cache` decorated function is defined in a cell that is executed
+with an *external* cell id (e.g. a nested/embedded app, as used by the VS Code
+extension), the decorator cannot build its base block eagerly. At call time it
+falls back to resolving the app from the local scope; if `app` is not present
+there, marimo logs a warning and caching silently fails.
+"""
+
+from __future__ import annotations
+
+from marimo._ast.cell_id import is_external_cell_id
+from marimo._runtime.runtime import Kernel
+from tests.conftest import ExecReqProvider
+
+WARNING = "does not contain a valid 'app' instance"
+
+
+class TestExternalCacheScope:
+    async def test_external_cache_has_no_warning_and_hits(
+        self, k: Kernel, exec_req: ExecReqProvider
+    ) -> None:
+        # A nested app gets a unique (external) cell-id prefix; the cells of
+        # that app thus run with external cell ids.
+        await k.run(
+            [
+                exec_req.get("import marimo as mo\ninner = mo.App()"),
+                exec_req.get(
+                    """
+                    @inner.cell
+                    def _():
+                        import marimo as mo2
+                        calls = []
+                        @mo2.cache
+                        def slow(n):
+                            calls.append(1)
+                            return n
+                        a = slow(1)
+                        b = slow(1)
+                        return a, b, calls
+                    """
+                ),
+            ]
+        )
+
+        # Grab the (external) cell id / code of the nested app's cell and run
+        # it directly, as the marimo language server would.
+        cell_id = list(k.globals["inner"]._cell_manager.cell_ids())[0]
+        assert is_external_cell_id(cell_id)
+        code = k.globals["inner"]._cell_manager._cell_data[cell_id].code
+        await k.run([exec_req.get_with_id(cell_id, code)])
+
+        # The "scope does not contain a valid 'app' instance" warning should not
+        # be emitted.
+        assert WARNING not in k.stderr.messages, k.stderr
+        # And the (pure) cached function should only be executed once.
+        assert k.globals["calls"] == [1]
