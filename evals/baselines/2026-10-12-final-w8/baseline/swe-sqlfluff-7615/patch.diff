--- /dev/null
+++ b/tests/tw_repro/test_issue_7469.py
@@ -0,0 +1,62 @@
+"""Reproduction test for the placeholder-templater / RF03 fix corruption.
+
+Issue: "Table alias is prefixed to placeholder param".
+
+When using the ``placeholder`` templater with ``param_style = colon`` on a
+postgres statement containing a postgres cast (``::``), running ``fix`` with
+the default rule set corrupts the source by prefixing the table alias onto the
+placeholder, e.g. ``:colname`` becomes ``mt.:colname``::
+
+    with mysel as (select * from mytable mt
+    where mt.colname = :colname :: text
+    )
+    select * from mysel ms;
+
+The placeholder represents a *value* (a bind parameter), not a column, so the
+alias must never be prefixed to it.
+"""
+
+from sqlfluff.core import FluffConfig, Linter
+
+SQL = """with mysel as (select * from mytable mt
+where mt.colname = :colname :: text
+)
+select * from mysel ms;
+"""
+
+CORRUPT = "mt.:colname"
+
+
+def _fix(sql: str) -> str:
+    config = FluffConfig(
+        overrides={
+            "dialect": "postgres",
+            "templater": "placeholder",
+        },
+        configs={"templater": {"placeholder": {"param_style": "colon"}}},
+    )
+    linter = Linter(config=config)
+    result = linter.lint_string(sql, fix=True)
+    fixed, _ = result.fix_string()
+    return fixed
+
+
+def test_placeholder_not_qualified_by_alias():
+    """The alias must not be prefixed to a placeholder param."""
+    fixed = _fix(SQL)
+    assert "mt.:colname" not in fixed, (
+        "Placeholder param was corrupted by prefixing the table alias:\n" + fixed
+    )
+    # The placeholder itself must be left intact in the source.
+    assert ":colname" in fixed
+
+
+def test_placeholder_source_unchanged_by_fix():
+    """The source (aside from layout/aliasing fixes) keeps the bare placeholder.
+
+    The bind parameter ``:colname`` must remain an unqualified placeholder in
+    the source, i.e. it must not have ``mt.`` inserted in front of it.
+    """
+    fixed = _fix(SQL)
+    assert "= :colname" in fixed
+    assert "mt.:colname" not in fixed
