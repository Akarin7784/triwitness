diff --git a/tests/tw_repro/test_issue_2359.py b/tests/tw_repro/test_issue_2359.py
new file mode 100644
index 0000000..cd770c2
--- /dev/null
+++ b/tests/tw_repro/test_issue_2359.py
@@ -0,0 +1,18 @@
+"""Repro for issue: comments moving bug when using import aliases.
+
+A ``mypy`` comment placed on the ``from ... import (`` line of a long aliased
+import must stay on that line instead of being moved down onto the alias line.
+"""
+
+import isort
+
+INPUT = (
+    "from a_long_name_to_enforce.splitting_across.two_lines import (  # type: ignore[attr-defined]\n"
+    "    a_random_attribute as renamed_random_attribute,\n"
+    ")\n"
+)
+
+
+def test_comment_not_moved_for_aliased_multiline_import_issue_2359():
+    assert isort.check_code(INPUT, profile="black", show_diff=True) is True
+    assert isort.code(INPUT, profile="black") == INPUT
diff --git a/tests/unit/test_regressions.py b/tests/unit/test_regressions.py
index 8484c6e..eea3a8c 100644
--- a/tests/unit/test_regressions.py
+++ b/tests/unit/test_regressions.py
@@ -1898,3 +1898,19 @@ def test_unrecoverable_exception_on_valid_input_ending_with_backslash_issue_1893
     https://github.com/PyCQA/isort/issues/1893
     """
     assert isort.code("import os #\\") == "import os  # \\\n"
+
+
+def test_comment_not_moved_for_aliased_multiline_import_issue_2359():
+    """Ensure a comment on a multi-line aliased ``from`` import stays on the
+    ``from ... import (`` line instead of being moved onto the alias line.
+
+    See: https://github.com/PyCQA/isort/issues/2359
+    """
+    test_input = (
+        "from a_long_name_to_enforce.splitting_across.two_lines import (  "
+        "# type: ignore[attr-defined]\n"
+        "    a_random_attribute as renamed_random_attribute,\n"
+        ")\n"
+    )
+    assert isort.check_code(test_input, profile="black", show_diff=True) is True
+    assert isort.code(test_input, profile="black") == test_input
