diff --git a/tests/tw_repro/test_issue_script_persistent_cache.py b/tests/tw_repro/test_issue_script_persistent_cache.py
new file mode 100644
index 0000000..4b36d82
--- /dev/null
+++ b/tests/tw_repro/test_issue_script_persistent_cache.py
@@ -0,0 +1,80 @@
+# Copyright 2024 Marimo. All rights reserved.
+
+"""Repro for: running script with persistent cache raises BlockException if
+there is other code in the cell.
+
+See https://github.com/marimo-team/marimo/issues (script mode + persistent_cache
++ trailing code in the same cell).
+
+The bug: in script mode (SourcePosition present) compiled cells use *file
+absolute* line numbers at runtime, while `_save` located the `with` block using
+*cell relative* line numbers. The mismatch made the transformer pick the wrong
+statement and raise a misleading `BlockException`.
+"""
+
+from __future__ import annotations
+
+import marimo
+from marimo._ast.transformers import BlockException
+
+
+def test_script_mode_cache_with_trailing_code() -> None:
+    """In script mode a persistent_cache block followed by other code in the
+    same cell must not raise BlockException."""
+    app = marimo.App()
+    # NOTE: not anonymous; this exercises the SourcePosition (script) path.
+    assert app._anonymous_file is False
+
+    @app.cell
+    def __() -> tuple[object]:
+        import marimo as mo
+        return (mo,)
+
+    @app.function
+    def compute(x, y):
+        return x + y
+
+    @app.cell
+    def _(mo) -> tuple[int, int]:
+        from tests._save.loaders.mocks import MockLoader
+
+        _loader = MockLoader()
+        with mo.persistent_cache("random", _loader=_loader):
+            Y = compute(1, 2)
+
+        # trailing code in the same cell as the cache block
+        X = 7
+        assert X == 7
+        return X, Y
+
+    try:
+        app.run()
+    except BlockException as e:  # pragma: no cover - this is the bug
+        raise AssertionError(
+            "persistent_cache with trailing code in the same cell raised "
+            f"BlockException: {e}"
+        ) from None
+
+
+def test_script_mode_cache_hit_with_trailing_code() -> None:
+    """On a cache *hit*, trailing code in the same cell must still execute
+    (the `_body_start` comparison must use cell-relative line numbers)."""
+    app = marimo.App()
+    assert app._anonymous_file is False
+
+    @app.cell
+    def _() -> tuple[int]:
+        from marimo._save.save import persistent_cache
+        from tests._save.loaders.mocks import MockLoader
+
+        with persistent_cache(
+            name="one", _loader=MockLoader(data={"Y": 9})
+        ) as cache:
+            Y = 100
+
+        # trailing code must run, not be skipped by the cache hit
+        X = 7
+        assert X == 7, "trailing code after a cache hit was skipped!"
+        return X, Y, cache
+
+    app.run()
