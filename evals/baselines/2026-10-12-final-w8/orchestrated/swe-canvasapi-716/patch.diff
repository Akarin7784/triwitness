diff --git a/tests/tw_repro/test_issue_obj_or_str.py b/tests/tw_repro/test_issue_obj_or_str.py
new file mode 100644
index 0000000..265b70f
--- /dev/null
+++ b/tests/tw_repro/test_issue_obj_or_str.py
@@ -0,0 +1,62 @@
+"""Repro for: `obj_or_str` improperly rejects strings.
+
+`obj_or_str` is expected to behave like `obj_or_id`, but for `str` instead of
+`int`: when the caller passes a plain string it must be returned unchanged,
+instead of being rejected with a TypeError.
+"""
+
+import unittest
+
+import requests_mock
+
+from canvasapi import Canvas
+from canvasapi.feature import FeatureFlag
+from canvasapi.user import User
+from canvasapi.util import obj_or_str
+from tests import settings
+from tests.util import register_uris
+
+
+@requests_mock.Mocker()
+class TestObjOrStrStr(unittest.TestCase):
+    def setUp(self):
+        self.canvas = Canvas(settings.BASE_URL, settings.API_KEY)
+
+    # obj_or_str() must return a plain str unchanged.
+    def test_obj_or_str_str(self, m):
+        self.assertEqual(obj_or_str("epub_export", "name", (User,)), "epub_export")
+        self.assertIsInstance(obj_or_str("epub_export", "name", (User,)), str)
+
+    # Account.get_feature_flag() accepts a feature name string.
+    def test_account_get_feature_flag_str(self, m):
+        register_uris({"account": ["get_by_id", "get_feature_flag"]}, m)
+        account = self.canvas.get_account(1)
+
+        feature_flag = account.get_feature_flag("epub_export")
+
+        self.assertIsInstance(feature_flag, FeatureFlag)
+        self.assertEqual(feature_flag.feature, "epub_export")
+
+    # Course.get_feature_flag() accepts a feature name string.
+    def test_course_get_feature_flag_str(self, m):
+        register_uris({"course": ["get_by_id", "get_feature_flag"]}, m)
+        course = self.canvas.get_course(1)
+
+        feature_flag = course.get_feature_flag("epub_export")
+
+        self.assertIsInstance(feature_flag, FeatureFlag)
+        self.assertEqual(feature_flag.feature, "epub_export")
+
+    # User.get_feature_flag() accepts a feature name string.
+    def test_user_get_feature_flag_str(self, m):
+        register_uris({"user": ["get_by_id", "get_feature_flag"]}, m)
+        user = self.canvas.get_user(1)
+
+        feature_flag = user.get_feature_flag("high_contrast")
+
+        self.assertIsInstance(feature_flag, FeatureFlag)
+        self.assertEqual(feature_flag.feature, "high_contrast")
+
+
+if __name__ == "__main__":
+    unittest.main()
