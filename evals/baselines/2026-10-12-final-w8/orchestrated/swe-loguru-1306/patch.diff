@@ -0,0 +1,76 @@
+"""Reproduction for "Support for FORCE_COLOR" (https://force-color.org/).
+
+FORCE_COLOR must force color output to be enabled by default (when ``colorize`` is not
+provided), even for non-TTY streams and regardless of heuristics such as ``TERM=dumb``.
+The ``NO_COLOR`` variable still takes precedence over ``FORCE_COLOR``.
+"""
+
+import os
+import sys
+
+import pytest
+
+from loguru import logger
+from loguru._colorama import should_colorize
+
+from ..conftest import StreamIsattyFalse, StreamIsattyTrue, parse
+
+
+@pytest.fixture(autouse=True)
+def clear_environment():
+    env = os.environ.copy()
+    os.environ.clear()
+    yield
+    os.environ.update(env)
+
+
+@pytest.mark.parametrize("patched", ["__stdout__", "__stderr__", "stdout", "stderr", ""])
+def test_honor_force_color_standard(monkeypatch, patched):
+    stream = StreamIsattyFalse()
+    with monkeypatch.context() as context:
+        context.setitem(os.environ, "FORCE_COLOR", "1")
+        context.setattr(sys, patched, stream, raising=False)
+        assert should_colorize(stream) is True
+
+
+def test_honor_force_color_even_with_dumb_term(monkeypatch):
+    stream = StreamIsattyFalse()
+    with monkeypatch.context() as context:
+        context.setitem(os.environ, "FORCE_COLOR", "1")
+        context.setitem(os.environ, "TERM", "dumb")
+        assert should_colorize(stream) is True
+
+
+def test_no_color_takes_precedence_over_force_color(monkeypatch):
+    stream = StreamIsattyTrue()
+    with monkeypatch.context() as context:
+        context.setitem(os.environ, "NO_COLOR", "1")
+        context.setitem(os.environ, "FORCE_COLOR", "1")
+        assert should_colorize(stream) is False
+
+
+def test_force_color_when_stream_is_not_a_tty(monkeypatch):
+    stream = StreamIsattyFalse()
+    with monkeypatch.context() as context:
+        context.setitem(os.environ, "FORCE_COLOR", "1")
+        logger.add(stream, format="<blue>{message}</blue>", colorize=None)
+        logger.debug("Message")
+        assert stream.getvalue() == parse("<blue>Message</blue>\n")
+
+
+def test_force_color_does_not_override_explicit_colorize_false(monkeypatch):
+    stream = StreamIsattyFalse()
+    with monkeypatch.context() as context:
+        context.setitem(os.environ, "FORCE_COLOR", "1")
+        logger.add(stream, format="<blue>{message}</blue>", colorize=False)
+        logger.debug("Message")
+        assert stream.getvalue() == "Message\n"
+
+
+def test_force_color_does_not_affect_file_sink(monkeypatch, tmp_path):
+    with monkeypatch.context() as context:
+        context.setitem(os.environ, "FORCE_COLOR", "1")
+        logger.add(tmp_path / "file.log", format="<blue>{message}</blue>")
+        logger.debug("Message")
+
+    assert (tmp_path / "file.log").read_text() == "Message\n"
