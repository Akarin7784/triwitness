diff --git a/tests/tw_repro/test_issue_191.py b/tests/tw_repro/test_issue_191.py
new file mode 100644
index 0000000..b7e9b93
--- /dev/null
+++ b/tests/tw_repro/test_issue_191.py
@@ -0,0 +1,113 @@
+"""Repro for issue: configurable memory context tag in AgentCoreMemorySessionManager.
+
+The core prefill fix (#191/#271) is present in the repo, but the XML tag wrapping
+retrieved memory is hardcoded to ``<retrieved_memory>``. The issue asks for a
+configurable ``context_tag`` on ``AgentCoreMemoryConfig`` defaulting to
+``user_context`` (backwards compatible) with opt-in custom tags.
+"""
+
+from unittest.mock import Mock, patch
+
+from strands.hooks import MessageAddedEvent
+from strands.types.session import Session, SessionType
+
+from bedrock_agentcore.memory.integrations.strands.config import AgentCoreMemoryConfig, RetrievalConfig
+from bedrock_agentcore.memory.integrations.strands.session_manager import AgentCoreMemorySessionManager
+
+
+def _create_manager(config, mock_memory_client):
+    with (
+        patch(
+            "bedrock_agentcore.memory.integrations.strands.session_manager.MemoryClient",
+            return_value=mock_memory_client,
+        ),
+        patch("boto3.Session") as mock_boto_session,
+        patch("strands.session.repository_session_manager.RepositorySessionManager.__init__", return_value=None),
+    ):
+        mock_session = Mock()
+        mock_session.region_name = "us-west-2"
+        mock_session.client.return_value = Mock()
+        mock_boto_session.return_value = mock_session
+
+        manager = AgentCoreMemorySessionManager(config)
+        manager.session_id = config.session_id
+        manager.session = Session(session_id=config.session_id, session_type=SessionType.AGENT)
+        return manager
+
+
+def _mock_memory_client():
+    client = Mock()
+    client.create_event.return_value = {"eventId": "event_123456"}
+    client.list_events.return_value = []
+    client.retrieve_memories.return_value = [{"content": {"text": "User prefers dark mode"}}]
+    client.gmcp_client = Mock()
+    client.gmdp_client = Mock()
+    return client
+
+
+def _retrieval_config():
+    return {
+        "user_preferences/{actorId}/": RetrievalConfig(top_k=5, relevance_score=0.3),
+    }
+
+
+def test_context_tag_default_value():
+    """AgentCoreMemoryConfig exposes context_tag defaulting to user_context."""
+    config = AgentCoreMemoryConfig(memory_id="mem-123", session_id="sess-456", actor_id="actor-789")
+    assert config.context_tag == "user_context"
+
+
+def test_context_tag_custom_value():
+    """context_tag can be customized and is stored verbatim."""
+    config = AgentCoreMemoryConfig(
+        memory_id="mem-123", session_id="sess-456", actor_id="actor-789", context_tag="retrieved_memory"
+    )
+    assert config.context_tag == "retrieved_memory"
+
+
+def test_uses_default_user_context_tag():
+    """By default injected memory is wrapped in <user_context> (backwards compatible)."""
+    mock_memory_client = _mock_memory_client()
+    config = AgentCoreMemoryConfig(
+        memory_id="mem-123", session_id="sess-456", actor_id="actor-789", retrieval_config=_retrieval_config()
+    )
+    manager = _create_manager(config, mock_memory_client)
+
+    mock_agent = Mock()
+    mock_agent.messages = [{"role": "user", "content": [{"text": "What are my preferences?"}]}]
+    event = MessageAddedEvent(agent=mock_agent, message=mock_agent.messages[-1])
+
+    manager.retrieve_customer_context(event)
+
+    content = mock_agent.messages[-1]["content"]
+    assert len(content) == 2
+    assert "<user_context>" in content[0]["text"]
+    assert "</user_context>" in content[0]["text"]
+    assert "<retrieved_memory>" not in content[0]["text"]
+    # original query stays last
+    assert content[1]["text"] == "What are my preferences?"
+
+
+def test_uses_custom_context_tag():
+    """When configured, injected memory uses the custom tag."""
+    mock_memory_client = _mock_memory_client()
+    config = AgentCoreMemoryConfig(
+        memory_id="mem-123",
+        session_id="sess-456",
+        actor_id="actor-789",
+        retrieval_config=_retrieval_config(),
+        context_tag="retrieved_memory",
+    )
+    manager = _create_manager(config, mock_memory_client)
+
+    mock_agent = Mock()
+    mock_agent.messages = [{"role": "user", "content": [{"text": "What are my preferences?"}]}]
+    event = MessageAddedEvent(agent=mock_agent, message=mock_agent.messages[-1])
+
+    manager.retrieve_customer_context(event)
+
+    content = mock_agent.messages[-1]["content"]
+    assert "<retrieved_memory>" in content[0]["text"]
+    assert "</retrieved_memory>" in content[0]["text"]
+    assert "<user_context>" not in content[0]["text"]
+    assert content[1]["text"] == "What are my preferences?"
