+def test_update_failure_leaves_tmp_clean(
+    template_path: str,
+    tmp_path_factory: pytest.TempPathFactory,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """A failed update must not leave its temporary clone behind."""
+    from plumbum import ProcessExecutionError
+
+    tmp, dst = map(tmp_path_factory.mktemp, ["tmp", "dst"])
+    _git = git["-C", dst]
+    # Mock tmp dir to assert it ends up clean
+    monkeypatch.setattr("tempfile.tempdir", str(tmp))
+    run_copy(template_path, dst, vcs_ref="v1", quiet=True, defaults=True)
+    _git("init")
+    _git("add", "-A")
+    _git("commit", "-m", "Initial commit")
+    empty_dir(tmp)
+    with pytest.raises(ProcessExecutionError):
+        run_update(
+            dst, vcs_ref="does-not-exist", overwrite=True, defaults=True, quiet=True
+        )
+    empty_dir(tmp)
+
+
+def test_cleanup_hooks_run_after_failure(tmp_path: Path) -> None:
+    """A failing cleanup hook must not prevent the remaining hooks from running."""
+    from copier._main import Worker
+
+    worker = Worker(src_path=str(tmp_path / "src"), dst_path=tmp_path / "dst")
+    calls: list[str] = []
+
+    def failing_hook() -> None:
+        calls.append("failing")
+        raise OSError("boom")
+
+    def succeeding_hook() -> None:
+        calls.append("succeeding")
+
+    worker._cleanup_hooks.append(failing_hook)
+    worker._cleanup_hooks.append(succeeding_hook)
+    with pytest.raises(OSError):
+        worker._cleanup()
+    assert calls == ["failing", "succeeding"]
