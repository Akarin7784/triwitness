+@pytest.mark.unit
+def test_get_diagnostics_in_range_prefers_full_range():
+    """`fullRange` takes precedence over a truncated `range` when filtering."""
+    truncated = {
+        "range": {"start": {"line": 0}, "end": {"line": 0}},
+        "fullRange": {"start": {"line": 15}, "end": {"line": 15}},
+        "message": "inside",
+    }
+    both_outside = {
+        "range": {"start": {"line": 0}, "end": {"line": 0}},
+        "fullRange": {"start": {"line": 30}, "end": {"line": 30}},
+        "message": "outside",
+    }
+
+    result = get_diagnostics_in_range([truncated, both_outside], 10, 20)
+
+    messages = [d["message"] for d in result]
+    assert "inside" in messages
+    assert "outside" not in messages
+
+
+@pytest.mark.unit
+def test_get_diagnostics_in_range_falls_back_to_range():
+    """Diagnostics without `fullRange` are filtered by `range` (no regression)."""
+    diagnostics = [
+        {"range": {"start": {"line": 5}, "end": {"line": 5}}, "message": "before"},
+        {"range": {"start": {"line": 15}, "end": {"line": 15}}, "message": "inside"},
+        {"range": {"start": {"line": 25}, "end": {"line": 25}}, "message": "after"},
+    ]
+
+    result = get_diagnostics_in_range(diagnostics, 10, 20)
+
+    assert [d["message"] for d in result] == ["inside"]
