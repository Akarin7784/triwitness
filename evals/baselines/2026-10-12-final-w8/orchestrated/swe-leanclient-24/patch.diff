+def get_diagnostic_line_span(diag: dict) -> tuple[int, int]:
+    """Return the (start_line, end_line) span used for line-range filtering.
+
+    Prefers ``fullRange`` (the semantic span of the error) over ``range``
+    (the display range, which Lean may truncate to a different location).
+    Falls back to ``range`` when ``fullRange`` is absent.
+
+    Args:
+        diag (dict): A single LSP diagnostic.
+
+    Returns:
+        tuple[int, int]: Inclusive start and end line of the diagnostic.
+    """
+    diag_range = diag.get("fullRange") or diag.get("range") or {}
+    start = diag_range.get("start", {}).get("line", 0)
+    end = diag_range.get("end", {}).get("line", start)
+    return start, end
+
