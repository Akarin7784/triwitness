diff --git a/tests/tw_repro/test_issue_1.py b/tests/tw_repro/test_issue_1.py
new file mode 100644
index 0000000..97de5fc
--- /dev/null
+++ b/tests/tw_repro/test_issue_1.py
@@ -0,0 +1,60 @@
+"""Reproduction for: line range filtering ignores `fullRange`.
+
+Lean diagnostics carry two ranges: `range` (display range, possibly truncated)
+and `fullRange` (semantic span of the error). Both filtering helpers only look
+at `range`, so a diagnostic whose `range` was truncated outside the requested
+line range is wrongly dropped even though `fullRange` overlaps it.
+
+These tests exercise the two affected functions without needing a Lean server.
+"""
+
+import pytest
+
+from leanclient.file_manager import FileState
+from leanclient.utils import get_diagnostics_in_range
+
+
+@pytest.mark.unit
+def test_get_diagnostics_in_range_prefers_full_range():
+    """Truncated `range` outside the window must not hide `fullRange` inside it."""
+    truncated_but_inside = {
+        "range": {"start": {"line": 0}, "end": {"line": 0}},
+        "fullRange": {"start": {"line": 15}, "end": {"line": 15}},
+        "message": "inside",
+    }
+    both_outside = {
+        "range": {"start": {"line": 0}, "end": {"line": 0}},
+        "fullRange": {"start": {"line": 30}, "end": {"line": 30}},
+        "message": "outside",
+    }
+
+    result = get_diagnostics_in_range(
+        [truncated_but_inside, both_outside], 10, 20
+    )
+
+    messages = [d["message"] for d in result]
+    assert "inside" in messages
+    assert "outside" not in messages
+
+
+@pytest.mark.unit
+def test_filter_diagnostics_by_range_uses_full_range():
+    """FileState.filter_diagnostics_by_range must prefer `fullRange` too."""
+    diagnostics = [
+        {
+            "range": {"start": {"line": 0}, "end": {"line": 0}},
+            "fullRange": {"start": {"line": 15}, "end": {"line": 15}},
+            "message": "inside",
+        },
+        {
+            "range": {"start": {"line": 30}, "end": {"line": 30}},
+            "message": "only_range_outside",
+        },
+    ]
+
+    state = FileState(uri="file:///test.lean", content="test", diagnostics=diagnostics)
+    filtered = state.filter_diagnostics_by_range(10, 20)
+
+    messages = [d["message"] for d in filtered]
+    assert "inside" in messages
+    assert "only_range_outside" not in messages
