@@ -313,6 +318,24 @@ class _ProfileValueParser:
         base_profile.runner.update(runner)
         return base_profile
 
+    @staticmethod
+    def _parse_platform_refs(raw_info, section):
+        """ The [platform_requires]/[platform_tool_requires] entries must be exact references,
+        version ranges are not allowed, as they cannot be resolved against the platform
+        """
+        result = []
+        for line in raw_info.splitlines():
+            line = line.strip()
+            if not line or line.startswith("#"):
+                continue
+            ref = RecipeReference.loads(line)
+            version = str(ref.version)
+            if version and version[0] == "[" and version[-1] == "]":
+                raise ConanException(f"[{section}] '{line}': version ranges are not allowed, "
+                                     f"please use exact 'pkg/version' references")
+            result.append(ref)
+        return result
+
