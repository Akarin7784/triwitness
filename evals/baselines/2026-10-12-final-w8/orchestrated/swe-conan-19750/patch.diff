diff --git a/tests/tw_repro/test_issue_platform_requires_range.py b/tests/tw_repro/test_issue_platform_requires_range.py
new file mode 100644
index 0000000..78af946
--- /dev/null
+++ b/tests/tw_repro/test_issue_platform_requires_range.py
@@ -0,0 +1,49 @@
+"""
+Reproduction for: AssertionError when doing `conan install`
+(assert not require.version_range) when a [platform_requires] profile entry
+contains a version range instead of an exact reference.
+
+Expected behavior (acceptance criteria):
+- Entries in [platform_requires] / [platform_tool_requires] must be exact refs.
+- A version range must be rejected with a normal profile-reading error that
+  identifies the offending section and reference.
+- The CLI output must not expose `AssertionError` or an internal traceback.
+"""
+import pytest
+
+from conan.api.model import RecipeReference
+from conan.errors import ConanException
+from conan.internal.api.profile.profile_loader import _ProfileValueParser
+from conan.test.assets.genconanfile import GenConanfile
+from conan.test.utils.tools import TestClient
+
+
+def test_cli_install_platform_requires_range_no_assertionerror():
+    client = TestClient(light=True)
+    client.save({"conanfile.py": GenConanfile("pkg", "1.0").with_requires("dep/[>=1.0]"),
+                 "profile": "[platform_requires]\ndep/[>=1.0]"})
+    client.run("install . -pr=profile", assert_error=True)
+
+    assert "ERROR: Error reading 'profile' profile:" in client.out
+    assert "[platform_requires]" in client.out
+    assert "dep/[>=1.0]" in client.out
+    assert "AssertionError" not in client.out
+    assert "Traceback" not in client.out
+
+
+@pytest.mark.parametrize("section", ["platform_requires", "platform_tool_requires", "system_tools"])
+def test_profile_loader_rejects_ranges(section):
+    text = f"[{section}]\ntool/[>=1.0]"
+    with pytest.raises(ConanException) as exc:
+        _ProfileValueParser.get_profile(text)
+    msg = str(exc.value)
+    assert f"[{section}]" in msg
+    assert "tool/[>=1.0]" in msg
+    assert "range" in msg.lower()
+
+
+def test_profile_loader_accepts_exact_refs():
+    profile = _ProfileValueParser.get_profile(
+        "[platform_requires]\ndep/1.0\n[platform_tool_requires]\ntool/2.0")
+    assert profile.platform_requires[0] == RecipeReference.loads("dep/1.0")
+    assert profile.platform_tool_requires[0] == RecipeReference.loads("tool/2.0")
