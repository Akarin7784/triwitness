diff --git a/tests/test_lazy_commands.py b/tests/test_lazy_commands.py
index b9d6294..94aa752 100644
--- a/tests/test_lazy_commands.py
+++ b/tests/test_lazy_commands.py
@@ -590,3 +590,84 @@ def test_lazy_app_name_match_allows_resolution():
         assert resolved is test_module.subapp
     finally:
         del sys.modules["test_lazy_module"]
+
+
+def test_lazy_app_subapp_help_hides_help_version_flags(console):
+    """Lazily-registered App subapp must hide its own --help/--version flags.
+
+    Regression test: a subapp's --help/--version flags were removed from its own
+    help output (PR #363); lazy loading must behave the same as eager registration.
+    """
+    test_module = ModuleType("test_lazy_module")
+    subapp = App(name="greet")
+
+    @subapp.default
+    def greet(name: str):
+        """Greet a person by name."""
+        return name
+
+    test_module.subapp = subapp  # type: ignore[attr-defined]
+    sys.modules["test_lazy_module"] = test_module
+
+    try:
+        parent = App(name="App", result_action="return_value")
+        parent.command("test_lazy_module:subapp", name="greet")
+
+        with console.capture() as capture:
+            parent(["greet", "--help"], console=console)
+        output = capture.get()
+
+        assert "Display this message and exit." not in output
+        assert "Display application version." not in output
+        assert "Greet a person by name." in output
+        assert "NAME" in output
+
+        assert parent["greet"]["--help"].show is False
+        assert parent["greet"]["--version"].show is False
+
+        # Must match the equivalent eager registration exactly.
+        eager_subapp = App(name="greet")
+
+        @eager_subapp.default
+        def greet_eager(name: str):
+            """Greet a person by name."""
+            return name
+
+        parent_eager = App(name="App", result_action="return_value")
+        parent_eager.command(eager_subapp)
+
+        with console.capture() as capture_eager:
+            parent_eager(["greet", "--help"], console=console)
+        assert output == capture_eager.get()
+    finally:
+        del sys.modules["test_lazy_module"]
+
+
+def test_lazy_function_command_help_hides_help_version_flags(console):
+    """Lazily-registered function command must hide its wrapper's help/version flags."""
+    test_module = ModuleType("test_lazy_module")
+
+    def cmd(x):
+        """Test command documentation."""
+        return x
+
+    test_module.cmd = cmd  # type: ignore[attr-defined]
+    sys.modules["test_lazy_module"] = test_module
+
+    try:
+        parent = App(name="App", result_action="return_value")
+        parent.command("test_lazy_module:cmd", name="lazy")
+
+        with console.capture() as capture:
+            parent(["lazy", "--help"], console=console)
+        output = capture.get()
+
+        assert "Display this message and exit." not in output
+        assert "Display application version." not in output
+        assert "Test command documentation." in output
+        assert "X" in output
+
+        assert parent["lazy"]["--help"].show is False
+        assert parent["lazy"]["--version"].show is False
+    finally:
+        del sys.modules["test_lazy_module"]
diff --git a/tests/tw_repro/test_issue_lazy_subapp_help.py b/tests/tw_repro/test_issue_lazy_subapp_help.py
new file mode 100644
index 0000000..b90bfc1
--- /dev/null
+++ b/tests/tw_repro/test_issue_lazy_subapp_help.py
@@ -0,0 +1,94 @@
+"""Reproduction for: lazy command loader changes a subapp's ``--help`` output.
+
+When a subapp is registered eagerly (``app.command(subapp)``) the subapp's own
+``--help``/``--version`` commands are hidden from its help output (PR #363).
+When the same subapp is registered lazily (``app.command("mod:subapp")``) those
+flags leak back into the subapp's ``--help`` output.
+"""
+
+import sys
+from types import ModuleType
+
+from cyclopts import App
+
+MODULE_NAME = "test_tw_repro_lazy_module"
+
+
+def _make_module():
+    module = ModuleType(MODULE_NAME)
+    subapp = App(name="greet")
+
+    @subapp.default
+    def greet(name: str):
+        """Greet a person by name."""
+        return name
+
+    module.subapp = subapp  # type: ignore[attr-defined]
+
+    def cmd(x):
+        """Test command documentation."""
+        return x
+
+    module.cmd = cmd  # type: ignore[attr-defined]
+    return module
+
+
+def test_lazy_app_subapp_help_hides_help_version_flags(console):
+    """A lazily-registered App subapp must hide its own --help/--version flags."""
+    sys.modules[MODULE_NAME] = _make_module()
+    try:
+        parent = App(name="App", result_action="return_value")
+        parent.command(f"{MODULE_NAME}:subapp", name="greet")
+
+        with console.capture() as capture:
+            parent(["greet", "--help"], console=console)
+        out = capture.get()
+
+        assert "Display this message and exit." not in out
+        assert "Display application version." not in out
+        assert "Greet a person by name." in out
+        assert "NAME" in out
+
+        assert parent["greet"]["--help"].show is False
+        assert parent["greet"]["--version"].show is False
+
+        # Must match the eager registration output exactly.
+        subapp_eager = App(name="greet")
+
+        @subapp_eager.default
+        def greet_eager(name: str):
+            """Greet a person by name."""
+            return name
+
+        parent2 = App(name="App", result_action="return_value")
+        parent2.command(subapp_eager)
+
+        with console.capture() as capture2:
+            parent2(["greet", "--help"], console=console)
+        eager_out = capture2.get()
+
+        assert out == eager_out
+    finally:
+        del sys.modules[MODULE_NAME]
+
+
+def test_lazy_function_command_help_hides_help_version_flags(console):
+    """A lazily-registered function command must hide its wrapper's help/version flags."""
+    sys.modules[MODULE_NAME] = _make_module()
+    try:
+        parent = App(name="App", result_action="return_value")
+        parent.command(f"{MODULE_NAME}:cmd", name="lazy")
+
+        with console.capture() as capture:
+            parent(["lazy", "--help"], console=console)
+        out = capture.get()
+
+        assert "Display this message and exit." not in out
+        assert "Display application version." not in out
+        assert "Test command documentation." in out
+        assert "X" in out
+
+        assert parent["lazy"]["--help"].show is False
+        assert parent["lazy"]["--version"].show is False
+    finally:
+        del sys.modules[MODULE_NAME]
