         app.version = parent_app.version
 
 
+def _hide_help_version_commands(app: "App") -> None:
+    """Hide a subapp's own ``--help``/``--version`` commands.
+
+    A subapp's help/version flags should not be advertised in its own help
+    output; they are only relevant when the parent app displays its commands.
+    Shared by eager and lazy command registration so that both paths behave
+    identically.
+    """
+    for flag in chain(app.help_flags, app.version_flags):
+        app[flag].show = False
+
