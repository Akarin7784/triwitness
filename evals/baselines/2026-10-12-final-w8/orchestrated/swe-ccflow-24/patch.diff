index 0000000..783e3db
--- /dev/null
+++ b/tests/tw_repro/test_issue_1.py
@@ -0,0 +1,94 @@
+"""Repro for issue: "Ability to pass kwargs to CallableModel".
+
+Expected behavior: a CallableModel can be called directly with the kwargs of its
+context, i.e. ``m(a="foo")`` behaves like ``m(MyContext(a="foo"))``.
+"""
+
+from datetime import date
+from unittest import TestCase
+
+import pytest
+from pydantic import ValidationError
+
+from ccflow import CallableModel, ContextBase, DateContext, Flow, GenericResult, ResultBase
+
+
+class MyContext(ContextBase):
+    a: str
+
+
+class MyResult(ResultBase):
+    x: int
+    y: str
+
+
+class MyCallable(CallableModel):
+    i: int
+    ll: list = []
+
+    @Flow.call
+    def __call__(self, context: MyContext) -> MyResult:
+        return MyResult(x=self.i, y=context.a)
+
+
+class MyCallableParent(CallableModel):
+    my_callable: MyCallable
+
+    @Flow.call
+    def __call__(self, context: MyContext) -> MyResult:
+        return self.my_callable(context)
+
+    @Flow.deps
+    def __deps__(self, context: MyContext) -> list:
+        return [(self.my_callable, [MyContext(a="goodbye")])]
+
+
+class DateModel(CallableModel):
+    @Flow.call
+    def __call__(self, context: DateContext = "0d") -> GenericResult:
+        return context.date
+
+    @Flow.call
+    def foo(self, context: DateContext) -> GenericResult:
+        return context.date
+
+
+class TestIssue1(TestCase):
+    def test_call_kwargs(self):
+        m = MyCallable(i=5)
+        # kwargs of the context can be passed straight to the model
+        self.assertEqual(m(a="foo"), MyResult(x=5, y="foo"))
+        self.assertEqual(m(a="foo"), m(MyContext(a="foo")))
+        # explicit context still works
+        self.assertEqual(m(context=MyContext(a="foo")), MyResult(x=5, y="foo"))
+        self.assertEqual(m(MyContext(a="foo")), MyResult(x=5, y="foo"))
+
+    def test_call_kwargs_and_context_raises(self):
+        m = MyCallable(i=5)
+        with self.assertRaises(TypeError):
+            m(MyContext(a="foo"), a="foo")
+        with self.assertRaises(TypeError):
+            m(context=MyContext(a="foo"), a="foo")
+
+    def test_call_kwargs_validation_error(self):
+        m = MyCallable(i=5)
+        with self.assertRaises(ValidationError):
+            m(b="foo")
+
+    def test_kwargs_deps(self):
+        m = MyCallable(i=1)
+        n = MyCallableParent(my_callable=m)
+        self.assertEqual(n.__deps__(a="hello"), n.__deps__(MyContext(a="hello")))
+        self.assertEqual(n.__deps__(a="hello"), [(m, [MyContext(a="goodbye")])])
+
+    def test_kwargs_decorated_method(self):
+        model = DateModel()
+        self.assertEqual(model(date="2022-01-01"), GenericResult(value=date(2022, 1, 1)))
+        self.assertEqual(model.foo(date="2022-01-01"), GenericResult(value=date(2022, 1, 1)))
+        # existing behavior preserved
+        self.assertEqual(model("2022-01-01"), GenericResult(value=date(2022, 1, 1)))
+        self.assertEqual(model(), GenericResult(value=date.today()))
+
+
+if __name__ == "__main__":
+    pytest.main([__file__, "-q"])
