diff --git a/tests/tw_repro/test_issue_assign_and.py b/tests/tw_repro/test_issue_assign_and.py
new file mode 100644
index 0000000..da3be1e
--- /dev/null
+++ b/tests/tw_repro/test_issue_assign_and.py
@@ -0,0 +1,61 @@
+"""Repro for: Add Parsing for `Assignment AND` Token.
+
+Issue: the parser must handle the ``ASSIGN_AND`` (``&=``) token so that
+expressions using the ``&=`` operator can be parsed (and later code-generated).
+
+These tests fail on the original code with
+``SyntaxError: Unexpected token in variable declaration: ASSIGN_AND``.
+"""
+
+from crosstl.src.translator.lexer import Lexer
+import pytest
+from typing import List
+from crosstl.src.translator.parser import Parser
+from crosstl.src.translator.codegen.opengl_codegen import GLSLCodeGen
+
+CODE = """
+shader S {
+    vertex {
+        void main() {
+            int a = 1;
+            a &= 1;
+        }
+    }
+}
+"""
+
+
+def tokenize_code(code: str) -> List:
+    lexer = Lexer(code)
+    return lexer.tokens
+
+
+def parse_code(tokens: List):
+    parser = Parser(tokens)
+    return parser.parse()
+
+
+def test_assignment_and_operator():
+    # AC1: parsing a shader containing `&=` must not raise SyntaxError.
+    try:
+        tokens = tokenize_code(CODE)
+        ast = parse_code(tokens)
+    except SyntaxError:
+        pytest.fail("ASSIGN_AND parsing not implemented.")
+
+    # token stream contains ASSIGN_AND with text "&="
+    assert ("ASSIGN_AND", "&=") in tokens
+
+    # AC2: the &= statement is a BinaryOpNode whose op is the token *text* "&="
+    vertex_body = ast.vertex_section.functions[0].body
+    binaryops = [node for node in vertex_body if getattr(node, "op", None) == "&="]
+    assert binaryops, f"no BinaryOpNode with op '&=' found in {vertex_body}"
+    assert binaryops[0].op == "&="
+
+
+def test_assignment_and_operator_codegen():
+    # AC3: end-to-end codegen must emit `&=`.
+    tokens = tokenize_code(CODE)
+    ast = parse_code(tokens)
+    generated = GLSLCodeGen().generate(ast)
+    assert "&=" in generated
