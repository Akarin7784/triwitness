+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Reproduction for the ``allowed_host_paths`` symlink-escape vulnerability.
+
+Issue: ``ensure_valid_host_path`` only performs lexical normalization
+(``os.path.normpath``) and never resolves symbolic links.  An attacker can put
+a symlink inside a whitelisted prefix (e.g. ``/data/opensandbox/evil -> /``)
+and request a bind mount using the symlink path.  The lexical allowlist check
+passes, but Docker resolves the symlink at bind-mount time and exposes an
+arbitrary host path (the host root ``/`` in the worst case).
+
+Expected behaviour (per the issue): a host path that contains a symlink
+component must be rejected, using the shared error code
+``SandboxErrorCodes.INVALID_HOST_PATH`` (HTTP 400), and the error message must
+mention the symlink.
+
+These tests fail on the unpatched code because no symlink resolution happens.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+import tempfile
+from pathlib import Path
+from unittest.mock import MagicMock, patch
+
+import pytest
+from fastapi import HTTPException, status
+
+# Make the in-repo server package importable regardless of the pytest rootdir.
+_REPO_ROOT = Path(__file__).resolve().parents[2]
+_SERVER_ROOT = _REPO_ROOT / "server"
+for _p in (str(_SERVER_ROOT),):
+    if _p not in sys.path:
+        sys.path.insert(0, _p)
+
+# The server test-suite config lives under server/tests/testdata.  Point the
+# config loader at it before importing modules that read it eagerly.
+os.environ.setdefault(
+    "SANDBOX_CONFIG_PATH",
+    str(_SERVER_ROOT / "tests" / "testdata" / "config.toml"),
+)
+
+import docker  # noqa: E402
+
+# Prevent real Docker connections (mirrors server/tests/conftest.py).
+_mock_docker_client = MagicMock()
+_mock_docker_client.containers.list.return_value = []
+docker.from_env = lambda: _mock_docker_client  # type: ignore
+
+from opensandbox_server.api.schema import (  # noqa: E402
+    CreateSandboxRequest,
+    Host,
+    ImageSpec,
+    ResourceLimits,
+    Volume,
+)
+from opensandbox_server.config import (  # noqa: E402
+    AppConfig,
+    IngressConfig,
+    RuntimeConfig,
+    ServerConfig,
+    StorageConfig,
+)
+from opensandbox_server.services.constants import SandboxErrorCodes  # noqa: E402
+from opensandbox_server.services.validators import ensure_valid_host_path  # noqa: E402
+
+
+def _assert_rejected(exc_info: pytest.ExceptionInfo[HTTPException], path: str) -> None:
+    assert exc_info.value.status_code == status.HTTP_400_BAD_REQUEST
+    assert exc_info.value.detail["code"] == SandboxErrorCodes.INVALID_HOST_PATH
+    assert "symlink" in exc_info.value.detail["message"].lower()
+
+
+class TestEnsureValidHostPathSymlink:
+    """The shared validator must refuse paths that traverse a symlink."""
+
+    def test_symlink_component_to_root_rejected(self, tmp_path: Path) -> None:
+        """A symlink inside the allowlist pointing at ``/`` must be rejected.
+
+        This is the exact exploit from the issue: the allowlist prefix
+        ``tmp_path`` is legitimate, but ``tmp_path/evil`` is a symlink to the
+        host root, so a bind mount would expose ``/``.
+        """
+        evil = tmp_path / "evil"
+        try:
+            os.symlink("/", evil)
+        except (OSError, NotImplementedError) as exc:  # pragma: no cover
+            pytest.skip(f"symlinks unavailable on this platform: {exc}")
+
+        with pytest.raises(HTTPException) as exc_info:
+            ensure_valid_host_path(str(evil), [str(tmp_path)])
+
+        _assert_rejected(exc_info, str(evil))
+        # The offending component must be named in the message.
+        assert "evil" in exc_info.value.detail["message"]
+
+    def test_symlink_inside_allowed_prefix_rejected(self, tmp_path: Path) -> None:
+        """Any symlink component is rejected, even staying inside the allowlist.
+
+        The issue's FIX #1 states "reject any path that contains symlinks", so a
+        symlink whose target remains under the whitelisted prefix is rejected too.
+        """
+        real = tmp_path / "real"
+        real.mkdir()
+        link = tmp_path / "link"
+        try:
+            os.symlink(str(real), link)
+        except (OSError, NotImplementedError) as exc:  # pragma: no cover
+            pytest.skip(f"symlinks unavailable on this platform: {exc}")
+
+        with pytest.raises(HTTPException) as exc_info:
+            ensure_valid_host_path(str(link), [str(tmp_path)])
+
+        _assert_rejected(exc_info, str(link))
+
+    def test_realpath_escape_rejected(self) -> None:
+        """A realpath-resolved escape (simulated) is rejected as well.
+
+        Mirrors the standard already applied to PVC subPaths in
+        ``docker._validate_pvc_volume`` (``os.path.realpath(strict=True)``).
+        """
+        with patch(
+            "opensandbox_server.services.validators.os.path.realpath",
+            side_effect=lambda p, **kwargs: "/" if p == "/tmp/evil" else p,
+        ):
+            with pytest.raises(HTTPException) as exc_info:
+                ensure_valid_host_path("/tmp/evil", ["/tmp"])
+
+        _assert_rejected(exc_info, "/tmp/evil")
+
+    def test_legitimate_paths_still_allowed(self, tmp_path: Path) -> None:
+        """Normal and not-yet-existing real paths must not be over-blocked."""
+        assert ensure_valid_host_path(str(tmp_path), [str(tmp_path)]) is None
+        assert (
+            ensure_valid_host_path(str(tmp_path / "not-created-yet"), [str(tmp_path)])
+            is None
+        )
+
+    def test_legitimate_paths_still_allowed_without_allowlist(self, tmp_path: Path) -> None:
+        """Symlink detection must not break allowlist-free validation."""
+        assert ensure_valid_host_path(str(tmp_path)) is None
+
+
+def _app_config() -> AppConfig:
+    return AppConfig(
+        server=ServerConfig(),
+        runtime=RuntimeConfig(
+            type="docker", execd_image="ghcr.io/opensandbox/platform:latest"
+        ),
+        ingress=IngressConfig(mode="direct"),
+    )
+
+
+class TestDockerHostVolumeSymlinkEscape:
+    """End-to-end: a symlink host path must be rejected before Docker runs."""
+
+    @pytest.mark.asyncio
+    async def test_host_volume_symlink_escape_rejected(self) -> None:
+        mock_client = MagicMock()
+        mock_client.containers.list.return_value = []
+        mock_client.api.create_host_config.return_value = {}
+        mock_client.api.create_container.return_value = {"Id": "cid"}
+        mock_client.containers.get.return_value = MagicMock()
+
+        with tempfile.TemporaryDirectory() as tmpdir:
+            evil = os.path.join(tmpdir, "evil")
+            try:
+                os.symlink("/", evil)
+            except (OSError, NotImplementedError) as exc:  # pragma: no cover
+                pytest.skip(f"symlinks unavailable on this platform: {exc}")
+
+            cfg = _app_config()
+            cfg.storage = StorageConfig(allowed_host_paths=[tmpdir])
+
+            from opensandbox_server.services.docker import DockerSandboxService
+
+            with patch(
+                "opensandbox_server.services.docker.docker.from_env",
+                return_value=mock_client,
+            ):
+                service = DockerSandboxService(config=cfg)
+
+                request = CreateSandboxRequest(
+                    image=ImageSpec(uri="python:3.11"),
+                    timeout=120,
+                    resourceLimits=ResourceLimits(root={}),
+                    env={},
+                    metadata={},
+                    entrypoint=["python"],
+                    volumes=[
+                        Volume(
+                            name="workdir",
+                            host=Host(path=evil),
+                            mount_path="/mnt/work",
+                            read_only=False,
+                        )
+                    ],
+                )
+
+                with patch.object(service, "_ensure_image_available"), patch.object(
+                    service, "_prepare_sandbox_runtime"
+                ):
+                    with pytest.raises(HTTPException) as exc_info:
+                        await service.create_sandbox(request)
+
+            _assert_rejected(exc_info, evil)
+            mock_client.api.create_container.assert_not_called()
