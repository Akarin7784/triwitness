+def _first_symlink_component(path: str) -> Optional[str]:
+    """
+    Return the first path component that is a symbolic link, if any.
+
+    Symbolic links are dangerous for allowlisted host bind mounts: the runtime
+    (Docker, kubelet) resolves them when performing the mount, so a symlink
+    living inside an allowed prefix can redirect the mount to an arbitrary host
+    path — including the host root ``/``.  Callers must reject any path for
+    which this helper reports a component.
+
+    The check is intentionally strict and mirrors the ``os.path.realpath(...,
+    strict=True)`` standard already applied to PVC subPaths: a symlink whose
+    target stays inside the allowlist is rejected too, so administrators must
+    whitelist the *real* path of their storage root.
+
+    Args:
+        path: Host path to inspect.
+
+    Returns:
+        The offending component name when some intermediate component is a
+        symbolic link, otherwise ``None``.  Never raises: unreadable or
+        non-existent components simply stop the walk and count as "no symlink"
+        (the path itself is still validated lexically by the caller).
+    """
+    if not path:
+        return None
+
+    # 1. Walk each component and lstat it.  ``lstat`` does not follow the final
+    #    symlink, so a symlink can be detected even when its target is missing.
+    #    Use a portable split so Windows-style paths ("D:/sandbox-mnt/ReMe")
+    #    are handled even when the server runs on POSIX (where os.lstat would
+    #    raise for such a path — treated below as "no symlink").
+    drive, tail = os.path.splitdrive(path)
+    root = drive + os.sep if drive else os.sep
+
+    current = root
+    for part in tail.replace("\\", "/").split("/"):
+        if not part:
+            continue
+        current = os.path.join(current, part)
+        try:
+            st = os.lstat(current)
+        except OSError:
+            # Component missing or unreadable — stop walking; there is nothing
+            # more we can stat, and a not-yet-created path is legitimate.
+            break
+        if stat.S_ISLNK(st.st_mode):
+            return part
+
+    # 2. POSIX-only cross-check: compare the fully resolved path with the
+    #    lexically normalized one.  This catches symlink traversal even when an
+    #    intermediate component could not be individually stat-ed and also works
+    #    when ``os.path.realpath`` is patched (matching the PVC validation
+    #    standard).  Guarded to native absolute POSIX paths so non-native paths
+    #    such as "D:/sandbox-mnt/ReMe" are not falsely rejected.
+    if os.name != "nt" and os.path.isabs(path):
+        try:
+            resolved = os.path.realpath(path)
+        except OSError:
+            resolved = path
+        if os.path.normpath(resolved) != os.path.normpath(path):
+            return path
+
+    return None
+
+
