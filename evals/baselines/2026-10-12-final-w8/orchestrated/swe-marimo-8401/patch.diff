@@ -0,0 +1,54 @@
+# Copyright 2026 Marimo. All rights reserved.
+"""Repro for: caching fails with "The scope does not contain a valid 'app' instance."
+
+When a cell runs with a cell id that carries a UUID prefix (e.g. cells of an
+App created while a runtime context is installed -- which is the case in the
+VS Code extension), `mo.cache` used to treat the cell as "external" and fall
+back to recovering the notebook graph from the definition scope. Plain
+notebook cells have no `app` in scope, so a warning was emitted and caching
+broke.
+"""
+
+from __future__ import annotations
+
+from uuid import uuid4
+
+import pytest
+
+from marimo._runtime.runtime import Kernel
+from tests.conftest import ExecReqProvider
+
+
+@pytest.mark.asyncio
+async def test_cache_in_external_cell_id(
+    k: Kernel, exec_req: ExecReqProvider
+) -> None:
+    # Cell id with a UUID prefix => "external" cell id.
+    cell_id = f"{uuid4()}Hbol"
+    await k.run(
+        [
+            exec_req.get_with_id(
+                cell_id,
+                """
+                import marimo as mo
+
+                @mo.cache
+                def slow():
+                    import time
+                    time.sleep(0.01)
+                    return "Done sleeping!"
+
+                first = slow()
+                second = slow()
+                """,
+            )
+        ]
+    )
+
+    assert "does not contain a valid 'app' instance" not in k.stderr.messages
+    assert not k.stderr.messages, k.stderr
+    assert k.globals["first"] == "Done sleeping!"
+    assert k.globals["second"] == "Done sleeping!"
+    # The second call must be served from cache.
+    assert k.globals["slow"].misses == 1
+    assert k.globals["slow"].hits == 1
