index 64b6042..a3cba8a 100644
--- a/sqlglot/parsers/bigquery.py
+++ b/sqlglot/parsers/bigquery.py
@@ -82,6 +82,45 @@ def _build_json_strip_nulls(args: list) -> exp.JSONStripNulls:
     return expression
 
 
+def _build_ai_scalar(
+    expr_type: type[E],
+    positional_keys: t.Sequence[str],
+    named_aliases: t.Mapping[str, str] | None = None,
+) -> t.Callable:
+    aliases = {k.upper(): v for k, v in (named_aliases or {}).items()}
+
+    def _builder(args: list) -> E:
+        positional = iter(positional_keys)
+        kwargs: t.Dict[str, exp.Expression] = {}
+        extra: t.List[exp.Expression] = []
+
+        for arg in args:
+            if isinstance(arg, exp.Kwarg):
+                # Named arguments are stored as the raw exp.Kwarg, mirroring exp.AIForecast,
+                # so that generation can re-emit "name => value". Documented named forms of the
+                # leading positional argument (e.g. "prompt") are mapped onto the canonical key
+                # so the expression validates, while the raw Kwarg is kept for round tripping.
+                name = arg.this.name
+                key = aliases.get(name.upper(), name)
+                if key in expr_type.arg_types:
+                    kwargs[key] = arg
+                else:
+                    # Unknown named arguments are collected so they're neither dropped nor
+                    # rejected, keeping the previous (generic) round trip behavior intact.
+                    extra.append(arg)
+            else:
+                key = next(positional, None)
+                if key:
+                    kwargs[key] = arg
+
+        if extra:
+            kwargs["expressions"] = extra
+
+        return expr_type(**kwargs)
+
+    return _builder
+
