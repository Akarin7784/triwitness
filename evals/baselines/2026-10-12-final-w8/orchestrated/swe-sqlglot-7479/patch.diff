diff --git a/tests/tw_repro/test_issue_ai_scalars.py b/tests/tw_repro/test_issue_ai_scalars.py
new file mode 100644
index 0000000..691a645
--- /dev/null
+++ b/tests/tw_repro/test_issue_ai_scalars.py
@@ -0,0 +1,76 @@
+"""Repro for: richer typed handling for BigQuery AI.* scalar functions.
+
+Locks the behavior named in the Issue:
+  - AI.EMBED / AI.SIMILARITY / AI.GENERATE parse into richer typed AST nodes
+    (exp.AIEmbed / exp.AISimilarity / exp.AIGenerate) instead of the generic
+    Dot(Anonymous) representation.
+  - Round trip is preserved for the documented scalar forms.
+"""
+
+from sqlglot import expressions as exp
+from sqlglot import parse_one
+
+CASES = (
+    ("SELECT AI.EMBED('hello')", exp.AIEmbed),
+    ("SELECT AI.SIMILARITY('a', 'b')", exp.AISimilarity),
+    ("SELECT AI.GENERATE('Write a haiku')", exp.AIGenerate),
+)
+
+
+def _inner_func(sql: str) -> exp.Expr | None:
+    node = parse_one(sql, dialect="bigquery").expressions[0]
+    return node.expression if isinstance(node, exp.Dot) else None
+
+
+def test_typed_nodes_are_produced():
+    for sql, klass in CASES:
+        fn = _inner_func(sql)
+        assert isinstance(fn, klass), f"{sql} -> expected {klass.__name__}, got {type(fn).__name__}"
+
+
+def test_no_anonymous_fallback():
+    for sql, klass in CASES:
+        ast = parse_one(sql, dialect="bigquery")
+        assert ast.find(exp.Anonymous) is None, f"{sql} still contains exp.Anonymous"
+        assert ast.find(klass) is not None
+
+
+def test_roundtrip_preserved():
+    for sql, _ in CASES:
+        assert parse_one(sql, dialect="bigquery").sql(dialect="bigquery") == sql
+
+
+def test_named_arguments_roundtrip():
+    sql = (
+        "SELECT AI.GENERATE(prompt => 'Write a haiku', connection_id => 'us.conn', "
+        "endpoint_id => 'gemini-2.5-flash', request_type => 'SHARED', "
+        "model_params => PARSE_JSON('{\"temperature\": 0.5}'))"
+    )
+    ast = parse_one(sql, dialect="bigquery")
+    assert ast.find(exp.AIGenerate) is not None
+    assert ast.find(exp.Anonymous) is None
+    assert ast.sql(dialect="bigquery") == sql
+
+    sql = "SELECT AI.EMBED('hello', connection_id => 'us.conn', endpoint_id => 'text-embedding-005')"
+    ast = parse_one(sql, dialect="bigquery")
+    assert ast.find(exp.AIEmbed) is not None
+    assert ast.sql(dialect="bigquery") == sql
+
+    sql = "SELECT AI.SIMILARITY('a', 'b', connection_id => 'us.conn', endpoint_id => 'text-embedding-005')"
+    ast = parse_one(sql, dialect="bigquery")
+    assert ast.find(exp.AISimilarity) is not None
+    assert ast.sql(dialect="bigquery") == sql
+
+
+def test_unknown_named_arguments_are_not_dropped():
+    # Valid SQL that round-tripped via the generic node before the patch must not lose
+    # arguments now that typed nodes are used.
+    sql = "SELECT AI.EMBED('x', distance_type => 'COSINE')"
+    ast = parse_one(sql, dialect="bigquery")
+    assert ast.find(exp.AIEmbed) is not None
+    assert ast.sql(dialect="bigquery") == sql
+
+    sql = "SELECT AI.GENERATE('p', connection_id => 'c', foo => 1)"
+    ast = parse_one(sql, dialect="bigquery")
+    assert ast.find(exp.AIGenerate) is not None
+    assert "foo => 1" in ast.sql(dialect="bigquery")
