+    def _ai_scalar_sql(self, expression: exp.Func, name: str) -> str:
+        # The "AI." prefix is supplied by the surrounding exp.Dot wrapper, so emit the
+        # bare function name. Positional arguments come first, then named arguments
+        # (stored as raw exp.Kwarg values) in a deterministic order.
+        positional = []
+        for key in ("this", "expression"):
+            if key in expression.arg_types:
+                positional.append(expression.args.get(key))
+
+        named = [
+            expression.args.get(key)
+            for key in expression.arg_types
+            if key not in ("this", "expression", "expressions")
+        ]
+
+        # Any named arguments not covered by the canonical keys are preserved as-is so
+        # valid input previously handled by the generic node is never dropped.
+        extra = expression.args.get("expressions") or []
+
+        return self.func(name, *positional, *named, *extra)
+
+    def aiembed_sql(self, expression: exp.AIEmbed) -> str:
+        return self._ai_scalar_sql(expression, "EMBED")
+
+    def aisimilarity_sql(self, expression: exp.AISimilarity) -> str:
+        return self._ai_scalar_sql(expression, "SIMILARITY")
+
+    def aigenerate_sql(self, expression: exp.AIGenerate) -> str:
+        return self._ai_scalar_sql(expression, "GENERATE")
