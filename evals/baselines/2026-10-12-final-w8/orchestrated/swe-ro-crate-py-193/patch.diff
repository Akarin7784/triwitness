diff --git a/tests/tw_repro/test_issue_nested_props_without_id.py b/tests/tw_repro/test_issue_nested_props_without_id.py
new file mode 100644
index 0000000..ac30b3a
--- /dev/null
+++ b/tests/tw_repro/test_issue_nested_props_without_id.py
@@ -0,0 +1,67 @@
+# Reproduction tests for the issue:
+# "Setting/Accessing nested properties on entities without @id"
+#
+# A dict value without "@id" must not be silently written to an entity
+# (the crate would then be unreadable by this same library), but reading
+# such a value from an existing crate must be forgiving.
+
+import json
+
+import pytest
+
+from rocrate.rocrate import ROCrate
+from rocrate.model import Person
+
+
+def test_set_nested_property_without_id():
+    crate = ROCrate()
+    bad = {"@type": "CreativeWork", "name": "CC0",
+           "url": "https://spdx.org/licenses/CC0-1.0"}
+    with pytest.raises(ValueError, match="@id"):
+        crate.root_dataset["license"] = bad
+    # the failed assignment must not have polluted the entity
+    assert "license" not in crate.root_dataset
+    # list-valued assignment with a bare dict is rejected too
+    with pytest.raises(ValueError, match="@id"):
+        crate.root_dataset["author"] = ["Alice", {"@type": "CreativeWork"}]
+    assert "author" not in crate.root_dataset
+    # append_to is rejected as well, without side effects
+    with pytest.raises(ValueError, match="@id"):
+        crate.root_dataset.append_to("license", {"@type": "CreativeWork"})
+    assert "license" not in crate.root_dataset
+    # a proper reference still works
+    crate.root_dataset["license"] = {"@id": "https://spdx.org/licenses/CC0-1.0"}
+    assert crate.root_dataset["license"] == "https://spdx.org/licenses/CC0-1.0"
+
+
+def test_properties_with_nested_dict_without_id():
+    crate = ROCrate()
+    with pytest.raises(ValueError, match="@id"):
+        crate.add(Person(crate, "#joe", properties={"license": {"@type": "CreativeWork"}}))
+    # a reference is fine
+    crate.add(Person(crate, "#joe2", properties={"license": {"@id": "#lic"}}))
+
+
+def test_get_nested_property_without_id(tmpdir):
+    metadata_file_name = 'ro-crate-metadata.json'
+    license_ = {"@type": "CreativeWork", "name": "CC0",
+                "url": "https://spdx.org/licenses/CC0-1.0"}
+    metadata = {
+        "@context": "https://w3id.org/ro/crate/1.1/context",
+        "@graph": [
+            {"@id": "ro-crate-metadata.json",
+             "@type": "CreativeWork",
+             "about": {"@id": "./"},
+             "conformsTo": {"@id": "https://w3id.org/ro/crate/1.1"}},
+            {"@id": "./",
+             "@type": "Dataset",
+             "license": license_},
+        ]
+    }
+    crate_dir = tmpdir / "inline_crate"
+    crate_dir.mkdir()
+    with open(crate_dir / metadata_file_name, "wt") as f:
+        json.dump(metadata, f, indent=4)
+    crate = ROCrate(crate_dir)
+    # reading must be forgiving: return the raw value
+    assert crate.root_dataset["license"] == license_
