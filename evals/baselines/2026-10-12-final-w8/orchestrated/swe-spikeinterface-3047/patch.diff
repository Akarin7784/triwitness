+@pytest.mark.parametrize("format", ["binary_folder", "zarr"])
+def test_select_units_after_load(tmp_path, dataset, format):
+    # https://github.com/SpikeInterface/spikeinterface issue: select_units fails after load_sorting_analyzer
+    # because the extension "info.json" (importing provenance) was loaded into extension.data
+    recording, sorting = dataset
+
+    if format == "zarr":
+        folder = tmp_path / "analyzer_select_units_after_load.zarr"
+    else:
+        folder = tmp_path / "analyzer_select_units_after_load"
+
+    sorting_analyzer = create_sorting_analyzer(sorting, recording, format=format, folder=folder)
+    sorting_analyzer.compute(["random_spikes", "waveforms", "templates"])
+
+    loaded_analyzer = load_sorting_analyzer(folder=folder)
+    loaded_ext = loaded_analyzer.get_extension("templates")
+
+    # the metadata keys must not leak into the extension data
+    assert "info" not in loaded_ext.data
+    assert "params" not in loaded_ext.data
+    assert "average" in loaded_ext.data
+    # but the importing provenance is still accessible on the extension
+    assert loaded_ext.importing_provenance is not None
+
+    selected_unit_ids = sorting.unit_ids[::2]
+    new_analyzer = loaded_analyzer.select_units(unit_ids=selected_unit_ids)
+
+    assert np.array_equal(new_analyzer.unit_ids, selected_unit_ids)
+
+    keep_unit_indices = np.flatnonzero(np.isin(loaded_analyzer.unit_ids, selected_unit_ids))
+    expected_average = loaded_ext.data["average"][keep_unit_indices, :, :]
+    new_average = new_analyzer.get_extension("templates").data["average"]
+    assert new_average.shape[0] == len(selected_unit_ids)
+    assert np.allclose(np.asarray(new_average), expected_average)
+
+
