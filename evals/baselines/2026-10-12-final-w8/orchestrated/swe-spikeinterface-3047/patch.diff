--- /dev/null
+++ b/src/spikeinterface/core/tests/tw_repro/test_issue_repro_select_units_after_load.py
@@ -0,0 +1,62 @@
+"""
+Repro for: `select_units` fails in `SortingAnalyzer` after using `load_sorting_analyzer`.
+
+After saving a SortingAnalyzer to a `binary_folder` and reloading it, the extension data
+loaded from disk wrongly contains the `info` key coming from `info.json` written by
+`AnalyzerExtension._save_importing_provenance`. When selecting units, the unit-index array
+is applied to every data key, which raises:
+    TypeError: unhashable type: 'numpy.ndarray'
+"""
+
+import numpy as np
+import pytest
+
+import spikeinterface.core as si
+
+
+@pytest.fixture(scope="module")
+def dataset():
+    recording, sorting = si.generate_ground_truth_recording(
+        durations=[10.0],
+        sampling_frequency=16000.0,
+        num_channels=4,
+        num_units=4,
+        generate_sorting_kwargs=dict(firing_rates=10.0, refractory_period_ms=4.0),
+        noise_kwargs=dict(noise_levels=5.0, strategy="tile_pregenerated"),
+        seed=2205,
+    )
+    return recording, sorting
+
+
+@pytest.mark.parametrize("format", ["binary_folder", "zarr"])
+def test_select_units_after_load(tmp_path, dataset, format):
+    recording, sorting = dataset
+
+    if format == "zarr":
+        folder = tmp_path / "analyzer.zarr"
+    else:
+        folder = tmp_path / "analyzer"
+
+    analyzer = si.create_sorting_analyzer(sorting, recording, format=format, folder=folder)
+    analyzer.compute(["random_spikes", "waveforms", "templates"])
+
+    loaded = si.load_sorting_analyzer(folder=folder)
+
+    # AC2: metadata keys must not leak into `data`
+    assert "info" not in loaded.get_extension("templates").data
+    assert "params" not in loaded.get_extension("templates").data
+    assert "average" in loaded.get_extension("templates").data
+
+    selected_unit_ids = sorting.unit_ids[::2]
+
+    # AC1: this used to raise `TypeError: unhashable type: 'numpy.ndarray'` for binary_folder
+    new_analyzer = loaded.select_units(unit_ids=selected_unit_ids)
+
+    assert np.array_equal(new_analyzer.unit_ids, selected_unit_ids)
+
+    # AC3: template array sliced by unit index
+    keep_unit_indices = np.flatnonzero(np.isin(loaded.unit_ids, selected_unit_ids))
+    expected_average = loaded.get_extension("templates").data["average"][keep_unit_indices, :, :]
+    obtained_average = new_analyzer.get_extension("templates").data["average"]
+    assert obtained_average.shape[0] == len(selected_unit_ids)
+    assert np.allclose(np.asarray(obtained_average), expected_average)
