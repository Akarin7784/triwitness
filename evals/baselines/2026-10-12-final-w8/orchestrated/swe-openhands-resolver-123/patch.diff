+"""Reproduction tests for the issue:
+
+"When a branch already exists, use a new branch name with a -try2, -try3, ...
+suffix instead of failing to push."
+
+These tests fail on the original implementation, which hard-codes the branch
+name as ``openhands-fix-issue-<n>``.
+"""
+
+import os
+import tempfile
+from unittest.mock import patch, MagicMock, call
+
+import pytest
+
+from openhands_resolver.send_pull_request import send_pull_request
+from openhands_resolver.resolver_output import GithubIssue
+
+
+@pytest.fixture
+def mock_output_dir():
+    with tempfile.TemporaryDirectory() as temp_dir:
+        repo_path = os.path.join(temp_dir, "repo")
+        os.makedirs(repo_path)
+        os.system(f"git init {repo_path}")
+        readme_path = os.path.join(repo_path, "README.md")
+        with open(readme_path, "w") as f:
+            f.write("hello world")
+        os.system(f"git -C {repo_path} add README.md")
+        os.system(f"git -C {repo_path} commit -m 'Initial commit'")
+        yield temp_dir
+
+
+@pytest.fixture
+def mock_github_issue():
+    return GithubIssue(
+        number=42,
+        title="Test Issue",
+        owner="test-owner",
+        repo="test-repo",
+        body="Test body",
+    )
+
+
+def _response(status_code, json_body=None):
+    mock = MagicMock()
+    mock.status_code = status_code
+    mock.json.return_value = json_body if json_body is not None else {}
+    return mock
+
+
+@patch("subprocess.run")
+@patch("requests.get")
+def test_branch_name_when_branch_already_exists(
+    mock_get, mock_run, mock_github_issue, mock_output_dir
+):
+    """When the default branch name already exists, append -try2."""
+    repo_path = os.path.join(mock_output_dir, "repo")
+
+    # 1) default branch lookup, 2) branch openhands-fix-issue-42 exists,
+    # 3) branch openhands-fix-issue-42-try2 does not exist
+    mock_get.side_effect = [
+        _response(200, {"default_branch": "main"}),
+        _response(200, {}),
+        _response(404, {}),
+    ]
+
+    mock_run.side_effect = [
+        MagicMock(returncode=0),  # git checkout -b
+        MagicMock(returncode=0),  # git push
+    ]
+
+    result = send_pull_request(
+        github_issue=mock_github_issue,
+        github_token="test-token",
+        github_username="test-user",
+        patch_dir=repo_path,
+        pr_type="branch",
+    )
+
+    checkout_call, push_call = mock_run.call_args_list
+    assert checkout_call == call(
+        f"git -C {repo_path} checkout -b openhands-fix-issue-42-try2",
+        shell=True,
+        capture_output=True,
+        text=True,
+    )
+    assert (
+        f"{repo_path} push https://test-user:test-token@github.com/"
+        f"test-owner/test-repo.git openhands-fix-issue-42-try2" in push_call[0][0]
+    )
+    assert (
+        result
+        == "https://github.com/test-owner/test-repo/compare/"
+        "openhands-fix-issue-42-try2?expand=1"
+    )
+
+
+@patch("subprocess.run")
+@patch("requests.post")
+@patch("requests.get")
+def test_branch_name_when_branch_already_exists_pr_pr_type(
+    mock_get, mock_post, mock_run, mock_github_issue, mock_output_dir
+):
+    """PR head must use the new branch name too."""
+    repo_path = os.path.join(mock_output_dir, "repo")
+
+    mock_get.side_effect = [
+        _response(200, {"default_branch": "main"}),
+        _response(200, {}),
+        _response(404, {}),
+    ]
+    mock_post.return_value.json.return_value = {
+        "html_url": "https://github.com/test-owner/test-repo/pull/1"
+    }
+    mock_run.side_effect = [
+        MagicMock(returncode=0),
+        MagicMock(returncode=0),
+    ]
+
+    send_pull_request(
+        github_issue=mock_github_issue,
+        github_token="test-token",
+        github_username="test-user",
+        patch_dir=repo_path,
+        pr_type="ready",
+    )
+
+    post_data = mock_post.call_args[1]["json"]
+    assert post_data["head"] == "openhands-fix-issue-42-try2"
+    assert post_data["base"] == "main"
+
+
+@patch("subprocess.run")
+@patch("requests.get")
+def test_branch_name_multiple_tries(
+    mock_get, mock_run, mock_github_issue, mock_output_dir
+):
+    """When -try2 also exists, increment to -try3."""
+    repo_path = os.path.join(mock_output_dir, "repo")
+
+    mock_get.side_effect = [
+        _response(200, {"default_branch": "main"}),
+        _response(200, {}),  # openhands-fix-issue-42 exists
+        _response(200, {}),  # openhands-fix-issue-42-try2 exists
+        _response(404, {}),  # openhands-fix-issue-42-try3 does not exist
+    ]
+    mock_run.side_effect = [
+        MagicMock(returncode=0),
+        MagicMock(returncode=0),
+    ]
+
+    result = send_pull_request(
+        github_issue=mock_github_issue,
+        github_token="test-token",
+        github_username="test-user",
+        patch_dir=repo_path,
+        pr_type="branch",
+    )
+
+    checkout_call = mock_run.call_args_list[0]
+    assert checkout_call == call(
+        f"git -C {repo_path} checkout -b openhands-fix-issue-42-try3",
+        shell=True,
+        capture_output=True,
+        text=True,
+    )
+    assert "openhands-fix-issue-42-try3?expand=1" in result
+
+
+@patch("subprocess.run")
+@patch("requests.get")
+def test_branch_name_when_branch_does_not_exist(
+    mock_get, mock_run, mock_github_issue, mock_output_dir
+):
+    """Regression: branch name unchanged when it does not exist."""
+    repo_path = os.path.join(mock_output_dir, "repo")
+
+    mock_get.side_effect = [
+        _response(200, {"default_branch": "main"}),
+        _response(404, {}),  # branch does not exist
+    ]
+    mock_run.side_effect = [
+        MagicMock(returncode=0),
+        MagicMock(returncode=0),
+    ]
+
+    result = send_pull_request(
+        github_issue=mock_github_issue,
+        github_token="test-token",
+        github_username="test-user",
+        patch_dir=repo_path,
+        pr_type="branch",
+    )
+
+    assert mock_get.call_count == 2
+    checkout_call = mock_run.call_args_list[0]
+    assert checkout_call == call(
+        f"git -C {repo_path} checkout -b openhands-fix-issue-42",
+        shell=True,
+        capture_output=True,
+        text=True,
+    )
+    assert "openhands-fix-issue-42?expand=1" in result
