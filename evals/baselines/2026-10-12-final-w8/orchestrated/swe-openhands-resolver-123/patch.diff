+def _branch_exists(base_url: str, branch_name: str, headers: dict) -> bool:
+    """Return True if the given branch already exists in the remote repository."""
+    response = requests.get(f"{base_url}/branches/{branch_name}", headers=headers)
+    return response.status_code == 200
+
+
+def _get_unique_branch_name(
+    base_url: str, base_branch_name: str, headers: dict, default_branch: str
+) -> str:
+    """Find a branch name that does not exist yet.
+
+    If ``base_branch_name`` already exists (e.g. a previous attempt to solve
+    this issue failed and left the branch behind), append ``-try2``, ``-try3``,
+    ... until an unused branch name is found.
+    """
+    branch_name = base_branch_name
+    try_number = 1
+    while branch_name == default_branch or _branch_exists(
+        base_url, branch_name, headers
+    ):
+        try_number += 1
+        branch_name = f"{base_branch_name}-try{try_number}"
+    return branch_name
+
+
