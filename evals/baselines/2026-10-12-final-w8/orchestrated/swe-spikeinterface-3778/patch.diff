--- /dev/null
+++ b/tests/tw_repro/test_issue_aggregate_units_string_props.py
@@ -0,0 +1,48 @@
+"""
+Repro for: `aggregate_units` doesn't propagate properties when string lengths don't match.
+
+numpy encodes the maximum string length in the dtype (``<U4`` vs ``<U2``), so a strict
+dtype comparison in ``UnitsAggregationSorting.__init__`` silently drops properties that
+only differ in string width.
+"""
+
+import numpy as np
+
+from spikeinterface.core import aggregate_units, generate_sorting
+
+
+def test_aggregate_units_propagates_string_properties_with_different_lengths():
+    sorting1 = generate_sorting(num_units=2)
+    sorting1.set_property("chris_label", ["good"] * sorting1.get_num_units())
+    sorting2 = generate_sorting(num_units=3)
+    sorting2.set_property("chris_label", ["ok"] * sorting2.get_num_units())
+
+    # sanity check: the two properties really have different string widths
+    assert sorting1.get_property("chris_label").dtype != sorting2.get_property("chris_label").dtype
+    assert sorting1.get_property("chris_label").dtype.kind == "U"
+    assert sorting2.get_property("chris_label").dtype.kind == "U"
+
+    sorting_agg = aggregate_units([sorting1, sorting2])
+
+    assert "chris_label" in sorting_agg.get_property_keys()
+    values = sorting_agg.get_property("chris_label")
+    assert values.dtype.kind == "U"
+    assert list(values) == ["good", "good", "ok", "ok", "ok"]
+
+
+def test_aggregate_units_propagates_ks_labels_like_case():
+    # kilk sorting by group where one group only contains "mua" (shorter string) entries
+    sorting1 = generate_sorting(num_units=2)
+    sorting1.set_property("KS_labels", ["mua"] * sorting1.get_num_units())
+    sorting2 = generate_sorting(num_units=2)
+    sorting2.set_property("KS_labels", ["good"] * sorting2.get_num_units())
+
+    sorting_agg = aggregate_units([sorting1, sorting2])
+    assert "KS_labels" in sorting_agg.get_property_keys()
+    assert list(sorting_agg.get_property("KS_labels")) == ["mua", "mua", "good", "good"]
+    assert np.array_equal(sorting_agg.get_property("KS_labels").dtype.kind, "U")
+
+
+if __name__ == "__main__":
+    test_aggregate_units_propagates_string_properties_with_different_lengths()
+    test_aggregate_units_propagates_ks_labels_like_case()
