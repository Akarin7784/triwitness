+            slot = rotation[index]
+            if slot in candidates:
+                return index, slot
+        # Should not happen: every slot in ``stats`` comes from ``pqueues``,
+        # whose keys are kept in sync with ``_slot_rotation``.
+        slot = min(candidates)
+        return self._slot_rotation.index(slot), slot
