diff --git a/tests/tw_repro/test_issue_5267.py b/tests/tw_repro/test_issue_5267.py
new file mode 100644
index 0000000..c9f201a
--- /dev/null
+++ b/tests/tw_repro/test_issue_5267.py
@@ -0,0 +1,110 @@
+"""Reproduction for: DownloaderAwarePriorityQueue starves request slots when
+all candidate slots report the same active-download count.
+
+``pop()`` must use a fair round-robin tie-breaker among slots with equal
+active-download counts instead of always picking the first (lexicographically
+smallest / insertion-first) slot.
+
+Observable through ``request.meta[Downloader.DOWNLOAD_SLOT]``.
+"""
+
+from unittest.mock import Mock
+
+from scrapy.core.downloader import Downloader
+from scrapy.http.request import Request
+from scrapy.pqueues import DownloaderAwarePriorityQueue
+from scrapy.spiders import Spider
+from scrapy.squeues import FifoMemoryQueue
+from scrapy.utils.test import get_crawler
+from tests.test_scheduler import MockDownloader
+
+
+def make_queue() -> DownloaderAwarePriorityQueue:
+    crawler = get_crawler(Spider)
+    crawler.engine = Mock(downloader=MockDownloader())
+    return DownloaderAwarePriorityQueue.from_crawler(
+        crawler=crawler,
+        downstream_queue_cls=FifoMemoryQueue,
+        key="foo/bar",
+    )
+
+
+def push_slot(queue: DownloaderAwarePriorityQueue, slot: str, count: int) -> None:
+    for index in range(count):
+        request = Request(f"https://example.org/{slot}/{index}")
+        request.meta[Downloader.DOWNLOAD_SLOT] = slot
+        queue.push(request)
+
+
+def popped_slots(
+    queue: DownloaderAwarePriorityQueue, count: int
+) -> list[str]:
+    slots = []
+    for _ in range(count):
+        request = queue.pop()
+        assert request is not None
+        slots.append(request.meta[Downloader.DOWNLOAD_SLOT])
+    return slots
+
+
+def test_round_robin_two_slots():
+    queue = make_queue()
+    try:
+        push_slot(queue, "a", 2)
+        push_slot(queue, "b", 2)
+
+        assert popped_slots(queue, 4) == ["a", "b", "a", "b"]
+        assert queue.pop() is None
+    finally:
+        queue.close()
+
+
+def test_round_robin_three_slots():
+    queue = make_queue()
+    try:
+        push_slot(queue, "a", 2)
+        push_slot(queue, "b", 2)
+        push_slot(queue, "c", 2)
+
+        assert popped_slots(queue, 6) == ["a", "b", "c", "a", "b", "c"]
+        assert queue.pop() is None
+    finally:
+        queue.close()
+
+
+def test_round_robin_continues_after_slot_removed():
+    queue = make_queue()
+    try:
+        push_slot(queue, "a", 1)
+        push_slot(queue, "b", 2)
+        push_slot(queue, "c", 1)
+
+        # 'a' is emptied and removed on the first pop; the rotation must
+        # continue from the removed slot's position (i.e. 'b'), not restart
+        # from the first slot.
+        assert popped_slots(queue, 4) == ["a", "b", "c", "b"]
+        assert queue.pop() is None
+    finally:
+        queue.close()
+
+
+def test_round_robin_active_counts_take_precedence():
+    """Slots with a higher active count must still be skipped."""
+    crawler = get_crawler(Spider)
+    downloader = MockDownloader()
+    crawler.engine = Mock(downloader=downloader)
+    queue = DownloaderAwarePriorityQueue.from_crawler(
+        crawler=crawler,
+        downstream_queue_cls=FifoMemoryQueue,
+        key="foo/bar",
+    )
+    try:
+        push_slot(queue, "a", 2)
+        push_slot(queue, "b", 2)
+        downloader.increment("a")
+        downloader.increment("a")
+
+        # Active counts are fixed by the mock, so 'b' stays preferred.
+        assert popped_slots(queue, 4) == ["b", "b", "a", "a"]
+    finally:
+        queue.close()
