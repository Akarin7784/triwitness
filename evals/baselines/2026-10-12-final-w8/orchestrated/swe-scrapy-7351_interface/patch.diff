+    def _select_slot(self, stats: list[tuple[int, str]]) -> tuple[int, str]:
+        """Return the ``(rotation index, slot)`` to use next.
+
+        Among the slots with the lowest number of active downloads, the one
+        that comes first in the round-robin rotation order is selected.
+
+        This method only reads :attr:`_rotation_index`; advancing it is the
+        caller's responsibility.
