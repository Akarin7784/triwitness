+
+
+def test_legend_outside_keeps_interior_ticklabels_share_labels():
+    """
+    An outside legend on an interior subplot must not hide that subplot's y tick
+    labels when only labels are shared (figure-level ``sharey='labs'``). The
+    filled legend panel is created before it is marked hidden, so it must not
+    promote the effective sharing level of the axes it sits next to.
+    """
+    fig, axs = uplt.subplots(ncols=3, sharey="labs")
+    axs[-1].set_visible(False)
+    for ax in axs[:-1]:
+        ax.plot([0, 1], [0, 1], label="line")
+    axs[-2].legend(loc="r")
+    fig.canvas.draw()
+    assert axs[0]._is_ticklabel_on("labelleft")
+    assert axs[-2]._is_ticklabel_on("labelleft")
+
+
+def test_legend_outside_keeps_interior_ticklabels_share_labels_transposed():
+    """
+    Transposed (row) variant: an outside legend on an interior subplot must not
+    hide that subplot's x tick labels when only labels are shared.
+    """
+    fig, axs = uplt.subplots(nrows=3, sharex="labs")
+    axs[-1].set_visible(False)
+    for ax in axs[:-1]:
+        ax.plot([0, 1], [0, 1], label="line")
+    axs[-2].legend(loc="b")
+    fig.canvas.draw()
+    assert axs[0]._is_ticklabel_on("labelbottom")
+    assert axs[-2]._is_ticklabel_on("labelbottom")
+
+
+def test_legend_inside_keeps_interior_ticklabels_control():
+    """
+    Control case: an inside legend creates no panel, so the interior subplot
+    keeps its y tick labels.
+    """
+    fig, axs = uplt.subplots(ncols=3, sharey="labs")
+    axs[-1].set_visible(False)
+    for ax in axs[:-1]:
+        ax.plot([0, 1], [0, 1], label="line")
+    axs[-2].legend(loc="lr")
+    fig.canvas.draw()
+    assert axs[0]._is_ticklabel_on("labelleft")
+    assert axs[-2]._is_ticklabel_on("labelleft")
