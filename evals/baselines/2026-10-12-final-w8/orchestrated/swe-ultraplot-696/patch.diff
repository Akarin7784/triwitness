+"""
+Reproduction for the issue "Adding a legend to right of plot can remove
+y-axis tick labels".
+
+When a legend is placed *outside* the axes (``loc='r'``), UltraPlot creates a
+new panel for it.  With a figure-level sharing level of 1 (``sharey='labs'``)
+interior subplots must still show their y tick labels, but the (later hidden)
+legend panel promotes the interior axes to sharing level 3 and the figure
+border masking then switches the interior tick labels off.
+
+These tests use the snippets from the issue verbatim.
+"""
+
+import ultraplot as uplt
+
+
+def test_legend_outside_keeps_interior_ticklabels_share_labels():
+    """Legend on the right of the middle axes must not hide its y labels."""
+    fig, axs = uplt.subplots(ncols=3, sharey="labs")
+    axs[-1].set_visible(False)
+    for ax in axs[:-1]:
+        ax.plot([0, 1], [0, 1], label="line")
+    axs[-2].legend(loc="r")
+    fig.canvas.draw()
+    assert axs[0]._is_ticklabel_on("labelleft")
+    assert axs[-2]._is_ticklabel_on("labelleft")
+
+
+def test_legend_outside_keeps_interior_ticklabels_share_labels_transposed():
+    """Transposed (row) variant of the same scenario."""
+    fig, axs = uplt.subplots(nrows=3, sharex="labs")
+    axs[-1].set_visible(False)
+    for ax in axs[:-1]:
+        ax.plot([0, 1], [0, 1], label="line")
+    axs[-2].legend(loc="b")
+    fig.canvas.draw()
+    assert axs[0]._is_ticklabel_on("labelbottom")
+    assert axs[-2]._is_ticklabel_on("labelbottom")
+
+
+def test_legend_inside_keeps_interior_ticklabels_control():
+    """Control case: inside legend creates no panel, labels stay on."""
+    fig, axs = uplt.subplots(ncols=3, sharey="labs")
+    axs[-1].set_visible(False)
+    for ax in axs[:-1]:
+        ax.plot([0, 1], [0, 1], label="line")
+    axs[-2].legend(loc="lr")
+    fig.canvas.draw()
+    assert axs[0]._is_ticklabel_on("labelleft")
+    assert axs[-2]._is_ticklabel_on("labelleft")
