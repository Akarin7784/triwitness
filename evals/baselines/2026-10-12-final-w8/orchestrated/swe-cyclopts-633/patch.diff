index 0000000..cf78622
--- /dev/null
+++ b/tests/tw_repro/test_issue_382.py
@@ -0,0 +1,67 @@
+"""Reproduction for: duplicate negative shown in help for a ``bool | None`` parameter.
+
+Issue: ``Parameter.get_negatives`` concatenated the negatives of each union member
+without de-duplicating, so ``Annotated[bool | None, Parameter(negative="--negative")]``
+produced ``("--negative", "--negative")`` and the help panel displayed the negative twice.
+"""
+
+from textwrap import dedent
+from typing import Annotated, Optional
+
+import pytest
+
+from cyclopts import Parameter
+from cyclopts.argument import ArgumentCollection
+from cyclopts.help import DefaultFormatter, create_parameter_help_panel
+
+pytestmark = pytest.mark.usefixtures("console")
+
+
+@pytest.mark.parametrize("type_", [bool | None, Optional[bool], list[str] | None, Optional[list[str]]])
+def test_parameter_get_negatives_union_none_custom_negative(type_):
+    p = Parameter(negative="--yesnt-foo", name=("--foo", "--bar"))
+    assert ("--yesnt-foo",) == p.get_negatives(type_)
+
+
+def test_parameter_get_negatives_union_none_prefix_collision():
+    # bool -> negative_bool ("no-" default), None -> negative_none ("no-") => duplicate.
+    p = Parameter(name="--foo", negative_none="no-")
+    assert ("--no-foo",) == p.get_negatives(bool | None)
+
+
+def test_help_format_group_parameters_bool_none_custom_negative(console, default_function_groups):
+    def cmd(
+        *,
+        foo: Annotated[bool | None, Parameter(negative="--yesnt-foo", help="Docstring for foo.")] = None,
+    ):
+        pass
+
+    argument_collection = ArgumentCollection._from_callable(cmd, None, parse_docstring=True)
+
+    with console.capture() as capture:
+        group = argument_collection.groups[0]
+        group_argument_collection = argument_collection.filter_by(group=group)
+        panel = create_parameter_help_panel(group, group_argument_collection, "restructuredtext")
+        formatter = DefaultFormatter()
+        rendered = formatter._render_panel(panel, console, console.options)
+        console.print(rendered)
+
+    actual = capture.get()
+    expected = dedent(
+        """\
+        ╭─ Parameters ───────────────────────────────────────────────────────╮
+        │ --foo --yesnt-foo  Docstring for foo.                              │
+        ╰────────────────────────────────────────────────────────────────────╯
+        """
+    )
+    assert actual.count("--yesnt-foo") == 1
+    assert actual == expected
+
+
+def test_parameter_union_none_negative_parse(app, assert_parse_args):
+    @app.default
+    def f(param: Annotated[bool | None, Parameter(negative="--negative")] = None):
+        pass
+
+    assert_parse_args(f, "--negative", False)
+    assert_parse_args(f, "--param", True)
