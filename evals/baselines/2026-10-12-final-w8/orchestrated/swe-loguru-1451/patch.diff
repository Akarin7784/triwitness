+    logger.add(writer, format="{extra[key]} {message}")
+    logger.bind(key="v").info("Hello")
+
+    assert writer.read() == "v Hello\n"
diff --git a/tests/tw_repro/test_issue_1.py b/tests/tw_repro/test_issue_1.py
new file mode 100644
index 0000000..1727072
--- /dev/null
+++ b/tests/tw_repro/test_issue_1.py
@@ -0,0 +1,61 @@
+"""Reproduction for: improve feedback for invalid format keys in format strings.
+
+Issue: referencing a non-existent record key in a ``format`` string results in a
+bare ``KeyError('nonexistent')`` with no actionable guidance and no list of the
+available record keys.
+"""
+
+import pytest
+
+from loguru import logger
+
+AVAILABLE_KEYS = ("elapsed", "exception", "extra", "file", "level", "message")
+
+
+@pytest.fixture
+def writer():
+    class Writer:
+        def __init__(self):
+            self._output = ""
+
+        def write(self, message):
+            self._output += message
+
+        def read(self):
+            return self._output
+
+    return Writer()
+
+
+def test_missing_key_is_named_with_catch_false(writer):
+    logger.remove()
+    logger.add(writer, format="{nonexistent}\n", catch=False)
+
+    with pytest.raises(KeyError) as excinfo:
+        logger.info("Hello world")
+
+    message = str(excinfo.value)
+    assert "nonexistent" in message
+    assert "logger.bind" in message
+    assert "extra[key]" in message
+    for key in AVAILABLE_KEYS:
+        assert key in message
+    assert writer.read() == ""
+
+
+def test_enhanced_diagnostic_visible_with_catch_true(writer, capsys):
+    logger.remove()
+    logger.add(writer, format="{nonexistent}\n", catch=True)
+
+    logger.info("Hello world")  # must not raise
+
+    out, err = capsys.readouterr()
+    assert out == ""
+    assert err.startswith("--- Logging error in Loguru Handler #0 ---")
+    assert err.rstrip().endswith("--- End of logging error ---")
+    assert "nonexistent" in err
+    assert "logger.bind" in err
+    assert "extra[key]" in err
+    for key in AVAILABLE_KEYS:
+        assert key in err
+    assert writer.read() == ""
