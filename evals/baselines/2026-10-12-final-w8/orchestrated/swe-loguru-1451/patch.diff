+
+def test_invalid_format_key_with_catch_true(writer, capsys):
+    logger.add(writer, format="{nonexistent}", catch=True)
+
+    logger.info("Hello world")
+
+    out, err = capsys.readouterr()
+    assert out == ""
+    assert err.startswith("--- Logging error in Loguru Handler #0 ---")
+    assert err.rstrip().endswith("--- End of logging error ---")
+    assert "nonexistent" in err
+    assert "logger.bind" in err
+    assert "extra[key]" in err
+    for key in ("elapsed", "exception", "extra", "file", "level", "message"):
+        assert key in err
+    assert writer.read() == ""
+
+
+def test_invalid_format_key_does_not_affect_other_handlers(capsys):
+    logger.add(lambda _: None, format="{nonexistent}", catch=True)
+    good = []
+    logger.add(good.append, format="{message}")
+
+    logger.info("Hello")
+
+    assert "".join(good) == "Hello\n"
+
+
+def test_format_with_key_added_by_patcher(writer):
+    logger.add(writer, format="{custom} {message}")
+    logger.patch(lambda record: record.update(custom="X")).info("Y")
+
+    assert writer.read() == "X Y\n"
+
+
