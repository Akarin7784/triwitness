+def _is_wholly_templated(ref: ObjectReferenceSegment) -> bool:
+    """Return True if every raw segment of ``ref`` comes from templated code.
+
+    Such references (e.g. a ``:colname`` placeholder parameter) are entirely
+    generated by the templater. They are not diagnosable column references and
+    cannot be safely qualified, so they should be ignored by this rule. Any
+    reference with at least one literal raw segment (e.g. ``{{ "foo" }}.b``) is
+    still processed as before.
+    """
+    raw_segments = ref.raw_segments
+    if not raw_segments:
+        return False
+    return all(seg.is_templated for seg in raw_segments)
+
+
 def _check_references(
     table_aliases: list[AliasInfo],
     standalone_aliases: list[BaseSegment],
@@ -187,6 +202,19 @@ def _check_references(
     # Check all the references that we have.
     seen_ref_types: set[str] = set()
     for ref in references:
+        # Skip references which are wholly generated by the templater (e.g. a
+        # placeholder parameter such as `:colname`). These are not diagnosable
+        # column references and cannot be safely qualified - attempting to
+        # "fix" them would leak the table alias into the source file, right in
+        # front of the placeholder parameter (see issue #7326).
+        if _is_wholly_templated(ref):
+            continue
+        # Skip unqualified wildcard references (i.e. `*`). They shouldn't count
+        # towards the set of "seen" reference types, otherwise a `SELECT *`
+        # would make any qualified reference in the same statement look
+        # inconsistent.
+        if not ref.is_qualified() and ref.is_type("wildcard_identifier"):
+            continue
         this_ref_type: str = ref.qualification()
