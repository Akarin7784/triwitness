diff --git a/tests/tw_repro/test_issue_cp01.py b/tests/tw_repro/test_issue_cp01.py
new file mode 100644
index 0000000..458e5c7
--- /dev/null
+++ b/tests/tw_repro/test_issue_cp01.py
@@ -0,0 +1,61 @@
+"""Repro test for CP01 issue: table alias prefixed to placeholder param.
+
+Issue: with the placeholder templater in ``colon`` param style, a reference
+which is *entirely* generated by the templater (e.g. ``:colname``) is still
+treated by RF03 (references.consistent) as a real column reference.  Because
+RF03 then decides that reference is inconsistent with the other, qualified
+reference in the query, it produces a fix anchored on the templated segment,
+which leaks the table alias (``mt.``) into the *source* file, immediately
+before the placeholder parameter::
+
+    where mt.colname = mt.:colname :: text
+
+The expected behaviour is that the query is reported as clean and left as-is
+(the templated parameter is not a decidably-qualifiable column reference).
+"""
+
+from sqlfluff.core import FluffConfig, Linter
+
+ISSUE_SQL = (
+    "with mysel as (select * from mytable mt\n"
+    "where mt.colname = :colname :: text\n"
+    ")\n"
+    "select * from mysel ms;\n"
+)
+
+CONFIG = """
+[sqlfluff]
+templater = placeholder
+dialect = postgres
+rules = RF03
+
+[sqlfluff:templater:placeholder]
+param_style = colon
+
+[sqlfluff:rules:references.consistent]
+single_table_references = consistent
+"""
+
+
+def _linter() -> Linter:
+    return Linter(config=FluffConfig.from_string(CONFIG))
+
+
+def test_rf03_no_violation_on_templated_placeholder_param():
+    """RF03 must not flag a templated placeholder parameter as inconsistent."""
+    result = _linter().lint_string(ISSUE_SQL)
+    rf03 = [v for v in result.violations if v.rule_code() == "RF03"]
+    assert not rf03, (
+        "RF03 unexpectedly reported a violation involving the placeholder "
+        "parameter: " + "; ".join(str(v) for v in rf03)
+    )
+
+
+def test_fix_does_not_leak_alias_into_source():
+    """Applying fixes must not insert the table alias before the param."""
+    fixed_sql, _ = _linter().lint_string(ISSUE_SQL, fix=True).fix_string()
+    assert "mt.:colname" not in fixed_sql, (
+        "The table alias was prefixed to the placeholder param:\n" + fixed_sql
+    )
+    # The placeholder itself must survive untouched.
+    assert ":colname" in fixed_sql
