@@ -0,0 +1,87 @@
+"""Reproduction for the MI Claims API issue.
+
+Expected behavior (from the Issue):
+- MSAL with Managed Identity exposes a claims API (keyword argument) on
+  ``ManagedIdentityClient.acquire_token_for_client``.
+- When claims are present in the token request, the token cache MUST be
+  bypassed so that a fresh token is acquired (CAE requirement).
+- The MSI v1 endpoint is unchanged, i.e. claims must NOT be sent to the
+  endpoint itself.
+
+On the original code all of these fail with
+``TypeError: acquire_token_for_client() got an unexpected keyword argument 'claims'``.
+"""
+import unittest
+
+try:
+    from unittest.mock import patch
+except ImportError:  # Python 2
+    from mock import patch
+
+import requests
+
+from tests.http_client import MinimalResponse
+from tests.test_mi import ClientTestCase
+from msal import ManagedIdentityClient
+
+
+AT_RESPONSE = '{"access_token": "AT", "expires_in": "3600", "resource": "R"}'
+CLAIMS = '{"access_token": {"nbf": {"essential": true}}}'
+
+
+class ClaimsTestCase(ClientTestCase):
+    """Reuses ClientTestCase.setUp() to build a system-assigned MI client."""
+
+    def _prime_cache(self, app):
+        with patch.object(app._http_client, "get", return_value=MinimalResponse(
+            status_code=200,
+            text=AT_RESPONSE,
+        )) as mocked_http:
+            result = app.acquire_token_for_client(resource="R")
+            self.assertEqual("AT", result.get("access_token"), "Should get an AT")
+            return mocked_http, mocked_http.call_count
+
+    def test_claims_should_bypass_cache(self):
+        mocked_http, call_count = self._prime_cache(self.app)
+        self.assertCacheStatus(self.app)
+        with patch.object(self.app._http_client, "get", return_value=MinimalResponse(
+            status_code=200,
+            text=AT_RESPONSE,
+        )) as mocked_http_2:
+            result = self.app.acquire_token_for_client(resource="R", claims=CLAIMS)
+            self.assertEqual("AT", result.get("access_token"), "Should get an AT")
+            self.assertEqual(
+                1, mocked_http_2.call_count,
+                "Claims present: cache should be bypassed and a new HTTP request made")
+
+    def test_no_claims_should_still_use_cache(self):
+        mocked_http, call_count = self._prime_cache(self.app)
+        with patch.object(self.app._http_client, "get", return_value=MinimalResponse(
+            status_code=200,
+            text=AT_RESPONSE,
+        )) as mocked_http_2:
+            result = self.app.acquire_token_for_client(resource="R")
+            self.assertEqual("AT", result.get("access_token"), "Should get an AT")
+            self.assertEqual(
+                0, mocked_http_2.call_count,
+                "No claims: the cached AT should still be used")
+
+    def test_claims_should_not_be_sent_to_endpoint(self):
+        with patch.object(self.app._http_client, "get", return_value=MinimalResponse(
+            status_code=200,
+            text=AT_RESPONSE,
+        )) as mocked_http:
+            self.app.acquire_token_for_client(resource="R", claims=CLAIMS)
+            mocked_http.assert_called()
+            for call in mocked_http.call_args_list:
+                kwargs = call[1]
+                self.assertNotIn(
+                    "claims", kwargs.get("params", {}) or {},
+                    "Claims should not be sent to the MSI v1 endpoint")
+                self.assertNotIn(
+                    "claims", kwargs.get("data", {}) or {},
+                    "Claims should not be sent to the MSI v1 endpoint")
+
+
+if __name__ == "__main__":
+    unittest.main()
