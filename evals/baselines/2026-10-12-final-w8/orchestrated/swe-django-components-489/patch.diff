@@ -0,0 +1,68 @@
+"""
+Reproduction for: template_loader blocks on STATICFILES_DIRS if there are tuples
+
+Django natively allows `(prefix, path)` tuples in `STATICFILES_DIRS`
+(https://docs.djangoproject.com/en/3.2/ref/settings/#std-setting-STATICFILES_DIRS).
+The component `Loader.get_dirs()` assumed every entry was a plain str/Path and
+crashed with `TypeError: expected str, bytes or os.PathLike object, not tuple`
+while trying to resolve the dirs.
+"""
+
+from pathlib import Path
+
+from django.template.engine import Engine
+from django.test import override_settings
+
+# isort: off
+from tests.django_test_setup import settings  # noqa: F401
+from tests.testutils import BaseTestCase
+
+# isort: on
+
+from django_components.template_loader import Loader
+
+
+def get_dirs():
+    return Loader(Engine.get_default()).get_dirs()
+
+
+class TestStaticFilesDirsTuples(BaseTestCase):
+    def test_get_dirs_with_tuple_entry(self):
+        """The second element of a (prefix, path) pair is used as the dir."""
+        with override_settings(
+            BASE_DIR=Path(__file__).resolve().parent.parent,
+            STATICFILES_DIRS=[("downloads", "components")],
+        ):
+            dirs = get_dirs()
+
+        self.assertEqual(
+            sorted(dirs),
+            sorted([Path(__file__).resolve().parent.parent / "components"]),
+        )
+
+    def test_get_dirs_with_mixed_entries(self):
+        """Plain str/Path entries keep working alongside tuple entries."""
+        with override_settings(
+            BASE_DIR=Path(__file__).resolve().parent.parent,
+            STATICFILES_DIRS=["components/relative_file", ("downloads", "components")],
+        ):
+            dirs = get_dirs()
+
+        self.assertEqual(
+            sorted(dirs),
+            sorted(
+                [
+                    Path(__file__).resolve().parent.parent / "components" / "relative_file",
+                    Path(__file__).resolve().parent.parent / "components",
+                ]
+            ),
+        )
+
+    def test_get_dirs_with_tuple_and_nonexistent_dir(self):
+        """Exact snippet from the issue must not crash and should match nothing."""
+        with override_settings(
+            STATICFILES_DIRS=[("downloads", "/opt/webfiles/stats")],
+        ):
+            dirs = get_dirs()
+
+        self.assertEqual(dirs, [])
