+                self.x = value
+
+            def __repr__(self) -> str:
+                return "an instance of {}".format(self.__class__.__name__)
+
+        @icontract.invariant(lambda self: self.x != 42)
+        class Derived(Base):
+            pass
+
+        class Sibling(Base):
+            pass
+
+        # The sibling class must not be affected by the invariant of the derived class.
+        Sibling().set_x(42)
