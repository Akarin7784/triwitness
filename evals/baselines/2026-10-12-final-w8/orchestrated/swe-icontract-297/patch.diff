         )
 
+    def test_additional_invariant_in_child_does_not_affect_base(self) -> None:
+        # NOTE (mristin):
+        # This is a regression test for:
+        # https://github.com/Parquery/icontract/issues/295
+        @icontract.invariant(lambda self: self.x > 0)
+        class Base(icontract.DBC):
+            def __init__(self) -> None:
+                self.x = 10
+
+            def set_x(self, value: int) -> None:
+                self.x = value
+
+            def __repr__(self) -> str:
+                return "an instance of {}".format(self.__class__.__name__)
+
+        @icontract.invariant(lambda self: self.x != 42)
+        class Derived(Base):
+            pass
+
+        # The base class must not be affected by the invariant of the derived class.
+        Base().set_x(42)
+
+        self.assertEqual(1, len(Base.__invariants_on_call__))  # type: ignore
+        self.assertEqual(2, len(Derived.__invariants__))  # type: ignore
+
+        # The derived class still enforces its own invariant.
+        violation_error = None  # type: Optional[icontract.ViolationError]
+        try:
+            Derived().set_x(42)
+        except icontract.ViolationError as err:
+            violation_error = err
+
+        self.assertIsNotNone(violation_error)
+        self.assertEqual(
+            textwrap.dedent(
+                """\
+                self.x != 42:
+                self was an instance of Derived
+                self.x was 42"""
+            ),
+            tests.error.wo_mandatory_location(str(violation_error)),
+        )
+
+        # ... and the invariant inherited from the base class.
+        violation_error = (
+            None
+        )  # type: Optional[icontract.ViolationError]  # type: ignore
+        try:
+            Derived().set_x(-1)
+        except icontract.ViolationError as err:
+            violation_error = err
+
+        self.assertIsNotNone(violation_error)
+        self.assertEqual(
+            textwrap.dedent(
+                """\
+                self.x > 0:
+                self was an instance of Derived
+                self.x was -1"""
+            ),
+            tests.error.wo_mandatory_location(str(violation_error)),
+        )
+
+    def test_additional_invariant_in_child_does_not_affect_sibling(self) -> None:
+        # NOTE (mristin):
