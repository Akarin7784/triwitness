diff --git a/tests/tw_repro/test_issue_295.py b/tests/tw_repro/test_issue_295.py
new file mode 100644
index 0000000..e1a3b5c
--- /dev/null
+++ b/tests/tw_repro/test_issue_295.py
@@ -0,0 +1,111 @@
+"""Reproduce https://github.com/Parquery/icontract/issues/295.
+
+The invariants of a derived class must not affect the base class nor its siblings.
+"""
+# pylint: disable=invalid-name
+# pylint: disable=missing-docstring
+
+import textwrap
+import unittest
+from typing import Optional
+
+import icontract
+import tests.error
+
+
+class TestIssue295(unittest.TestCase):
+    def test_invariant_of_subclass_does_not_affect_base(self) -> None:
+        @icontract.invariant(lambda: True)
+        class Base:
+            def __repr__(self) -> str:
+                return "an instance of {}".format(self.__class__.__name__)
+
+        @icontract.invariant(lambda: False)
+        class Derived(Base):  # pylint: disable=unused-variable
+            pass
+
+        # Base must be unaffected by the invariant introduced in ``Derived``.
+        _ = Base()
+
+        violation_error = None  # type: Optional[icontract.ViolationError]
+        try:
+            _ = Derived()
+        except icontract.ViolationError as err:
+            violation_error = err
+
+        self.assertIsNotNone(violation_error)
+        self.assertEqual(
+            textwrap.dedent("""False: self was an instance of Derived"""),
+            tests.error.wo_mandatory_location(str(violation_error)),
+        )
+
+        self.assertIn("__invariants__", Derived.__dict__)
+        self.assertEqual(1, len(Base.__invariants__))  # type: ignore
+
+    def test_invariant_of_subclass_does_not_affect_base_dbc(self) -> None:
+        @icontract.invariant(lambda self: self.x > 0)
+        class Base(icontract.DBC):
+            def __init__(self) -> None:
+                self.x = 10
+
+            def set_x(self, value: int) -> None:
+                self.x = value
+
+            def __repr__(self) -> str:
+                return "an instance of {}".format(self.__class__.__name__)
+
+        @icontract.invariant(lambda self: self.x != 42)
+        class Derived(Base):
+            pass
+
+        class Sibling(Base):
+            pass
+
+        # Neither the base class nor the sibling class is affected by the Derived
+        # invariant.
+        Base().set_x(42)
+        Sibling().set_x(42)
+
+        violation_error = None  # type: Optional[icontract.ViolationError]
+        try:
+            Derived().set_x(42)
+        except icontract.ViolationError as err:
+            violation_error = err
+
+        self.assertIsNotNone(violation_error)
+        self.assertEqual(
+            textwrap.dedent(
+                """\
+                self.x != 42:
+                self was an instance of Derived
+                self.x was 42"""
+            ),
+            tests.error.wo_mandatory_location(str(violation_error)),
+        )
+
+        # The derived class still enforces the inherited invariant.
+        violation_error = (
+            None
+        )  # type: Optional[icontract.ViolationError]  # type: ignore
+        try:
+            Derived().set_x(-1)
+        except icontract.ViolationError as err:
+            violation_error = err
+
+        self.assertIsNotNone(violation_error)
+        self.assertEqual(
+            textwrap.dedent(
+                """\
+                self.x > 0:
+                self was an instance of Derived
+                self.x was -1"""
+            ),
+            tests.error.wo_mandatory_location(str(violation_error)),
+        )
+
+        self.assertEqual(1, len(Base.__invariants_on_call__))  # type: ignore
+        self.assertEqual(2, len(Derived.__invariants__))  # type: ignore
+
+
+if __name__ == "__main__":
+    unittest.main()
