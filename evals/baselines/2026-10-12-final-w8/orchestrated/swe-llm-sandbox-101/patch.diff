diff --git a/tests/tw_repro/test_issue_artifact_session_timeout.py b/tests/tw_repro/test_issue_artifact_session_timeout.py
new file mode 100644
index 0000000..7bd7a5e
--- /dev/null
+++ b/tests/tw_repro/test_issue_artifact_session_timeout.py
@@ -0,0 +1,98 @@
+# ruff: noqa: SLF001, PLR2004
+
+"""Reproduction for: ArtifactSandboxSession does not allow timeouts greater than 30 seconds.
+
+Expected behaviour (from the issue): ArtifactSandboxSession timeout parameters behave
+the same as SandboxSession, i.e. a configured ``execution_timeout``/``default_timeout``
+greater than 30 seconds is honoured instead of being capped at a hard-coded 30.
+
+Strategy: build a REAL ``ArtifactSandboxSession`` (real ``SandboxDockerSession`` +
+real language handler) with Docker mocked out, patch ``_execute_with_timeout`` on the
+underlying session to capture the effective timeout, and assert it equals the configured
+value rather than 30.
+"""
+
+from unittest.mock import MagicMock, patch
+
+from llm_sandbox.session import ArtifactSandboxSession
+
+
+def _make_artifact_session(**kwargs: object) -> ArtifactSandboxSession:
+    return ArtifactSandboxSession(lang="python", **kwargs)
+
+
+def _run_and_capture_timeout(
+    session: ArtifactSandboxSession,
+    *,
+    run_kwargs: dict | None = None,
+    enable_plotting: bool | None = None,
+) -> float | None:
+    base = session._session
+    base.container = MagicMock()
+    base.is_open = True
+
+    if enable_plotting is not None:
+        session.enable_plotting = enable_plotting
+
+    with (
+        patch.object(base, "install"),
+        patch.object(base, "copy_to_runtime"),
+        patch.object(base, "execute_commands"),
+        patch.object(base, "_execute_with_timeout") as mock_exec,
+        patch.object(base.language_handler, "extract_plots", return_value=[]),
+    ):
+        mock_exec.return_value = MagicMock(exit_code=0, stdout="output", stderr="")
+        session.run("print('hello')", **(run_kwargs or {}))
+
+        assert mock_exec.call_args is not None
+        # timeout is passed as a keyword in BaseSession.run
+        return mock_exec.call_args.kwargs.get("timeout")
+
+
+@patch("llm_sandbox.docker.docker.from_env")
+def test_artifact_session_honors_execution_timeout(mock_from_env: MagicMock) -> None:
+    """execution_timeout > 30 must be used, not the hard-coded 30."""
+    session = _make_artifact_session(default_timeout=300.0, execution_timeout=120.0)
+    assert _run_and_capture_timeout(session, enable_plotting=True) == 120.0
+
+
+@patch("llm_sandbox.docker.docker.from_env")
+def test_artifact_session_falls_back_to_default_timeout(mock_from_env: MagicMock) -> None:
+    """When execution_timeout is unset, default_timeout is used."""
+    session = _make_artifact_session(default_timeout=300.0)
+    assert _run_and_capture_timeout(session) == 300.0
+
+
+@patch("llm_sandbox.docker.docker.from_env")
+def test_artifact_session_explicit_timeout_overrides_config(mock_from_env: MagicMock) -> None:
+    """An explicit per-call timeout still overrides the session config."""
+    session = _make_artifact_session(execution_timeout=120.0)
+    assert _run_and_capture_timeout(session, run_kwargs={"timeout": 45.0}) == 45.0
+
+
+@patch("llm_sandbox.docker.docker.from_env")
+def test_artifact_session_no_hardcoded_30_forwarded(mock_from_env: MagicMock) -> None:
+    """The plotting path must not inject a literal 30 into the language handler."""
+    session = _make_artifact_session()
+    base = session._session
+    base.container = MagicMock()
+    base.is_open = True
+
+    with (
+        patch.object(base, "install"),
+        patch.object(base, "copy_to_runtime"),
+        patch.object(base, "execute_commands"),
+        patch.object(base, "_execute_with_timeout") as mock_exec,
+        patch.object(
+            base.language_handler,
+            "run_with_artifacts",
+            wraps=base.language_handler.run_with_artifacts,
+        ) as mock_run_with_artifacts,
+        patch.object(base.language_handler, "extract_plots", return_value=[]),
+    ):
+        mock_exec.return_value = MagicMock(exit_code=0, stdout="output", stderr="")
+        session.enable_plotting = True
+        session.run("print('hello')")
+
+    assert mock_run_with_artifacts.call_args is not None
+    assert mock_run_with_artifacts.call_args.kwargs.get("timeout") is None
