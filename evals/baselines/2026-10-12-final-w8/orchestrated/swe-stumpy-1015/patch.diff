diff --git a/tests/tw_repro/test_issue_motifs_max_matches_none.py b/tests/tw_repro/test_issue_motifs_max_matches_none.py
new file mode 100644
index 0000000..29f5028
--- /dev/null
+++ b/tests/tw_repro/test_issue_motifs_max_matches_none.py
@@ -0,0 +1,82 @@
+"""Repro for issue: `_motifs` max_matches=None bug.
+
+`stumpy.motifs(..., max_matches=None)` (and its non-normalized counterpart
+`stumpy.aamp_motifs(..., max_matches=None)`) should return *all* matches and
+must not raise ``TypeError: slice indices must be integers or None or have an
+__index__ method``.
+
+Before the fix, ``motifs()``/``aamp_motifs()`` prematurely converted
+``max_matches=None`` into ``np.inf`` which was then used as a slice index
+inside ``_motifs()``/``_aamp_motifs()``.
+"""
+
+import os
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+
+import naive
+import numpy as np
+import numpy.testing as npt
+
+import stumpy
+
+
+T = np.array([0.0, 1, 2, 2, 0, 1, 2, 2, 0, 0, 0, 0])
+M = 3
+
+
+def test_motifs_max_matches_none():
+    mp = naive.stump(T, M, row_wise=True)
+
+    ref_distances, ref_indices = stumpy.motifs(
+        T,
+        mp[:, 0].astype(np.float64),
+        max_matches=T.shape[0],
+        max_distance=np.inf,
+        cutoff=np.inf,
+    )
+
+    distances, indices = stumpy.motifs(
+        T,
+        mp[:, 0].astype(np.float64),
+        max_matches=None,
+        max_distance=np.inf,
+        cutoff=np.inf,
+    )
+
+    npt.assert_almost_equal(distances, ref_distances)
+    npt.assert_almost_equal(indices, ref_indices)
+
+    assert distances.shape[0] >= 1
+    assert indices.shape[0] >= 1
+    assert distances.shape[1] >= 1
+    assert indices.shape[1] >= 1
+
+
+def test_aamp_motifs_max_matches_none():
+    mp = naive.aamp(T, M, row_wise=True)
+
+    ref_distances, ref_indices = stumpy.aamp_motifs(
+        T,
+        mp[:, 0].astype(np.float64),
+        max_matches=T.shape[0],
+        max_distance=np.inf,
+        cutoff=np.inf,
+    )
+
+    distances, indices = stumpy.aamp_motifs(
+        T,
+        mp[:, 0].astype(np.float64),
+        max_matches=None,
+        max_distance=np.inf,
+        cutoff=np.inf,
+    )
+
+    npt.assert_almost_equal(distances, ref_distances)
+    npt.assert_almost_equal(indices, ref_indices)
+
+    assert distances.shape[0] >= 1
+    assert indices.shape[0] >= 1
+    assert distances.shape[1] >= 1
+    assert indices.shape[1] >= 1
