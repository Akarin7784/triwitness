+    """
+
+    def test_custom_tqdm_class_is_not_disabled_in_non_tty(self) -> None:
+        updates: list[tuple[int, int | None]] = []
+
+        class MyProgress(base_tqdm):
+            def __init__(self, *args, **kwargs):
+                kwargs.pop("name", None)
+                super().__init__(*args, **kwargs)
+
+            def update(self, n=1):
+                super().update(n)
+                updates.append((self.n, self.total))
