diff --git a/tests/tw_repro/test_issue_custom_tqdm_class_non_tty.py b/tests/tw_repro/test_issue_custom_tqdm_class_non_tty.py
new file mode 100644
index 0000000..e05b7ce
--- /dev/null
+++ b/tests/tw_repro/test_issue_custom_tqdm_class_non_tty.py
@@ -0,0 +1,134 @@
+"""Reproduction for: `tqdm_class` progress tracking silently broken in non-TTY environments.
+
+Passing a custom `tqdm_class` must mean "I want to track progress my way". It must not be
+silently disabled by tqdm's TTY auto-detection (`disable=None` + `sys.stderr.isatty()`),
+which is always False under pytest / web servers / background threads / Docker.
+"""
+
+import logging
+import unittest
+
+import pytest
+from pytest import CaptureFixture
+from tqdm.auto import tqdm as base_tqdm
+
+from huggingface_hub.utils.tqdm import _get_progress_bar_context
+
+
+class CapsysBaseTest(unittest.TestCase):
+    @pytest.fixture(autouse=True)
+    def capsys(self, capsys: CaptureFixture) -> None:
+        self.capsys = capsys
+
+
+class MyProgress(base_tqdm):
+    """A user-defined progress bar that tracks progress on its own."""
+
+    all_updates: list[tuple[int, int | None]] = []
+
+    def __init__(self, *args, **kwargs):
+        kwargs.pop("name", None)  # hf-specific kwarg
+        self.updates = []
+        super().__init__(*args, **kwargs)
+
+    def update(self, n=1):
+        super().update(n)
+        self.updates.append((self.n, self.total))
+        MyProgress.all_updates.append((self.n, self.total))
+
+    @classmethod
+    def reset(cls):
+        cls.all_updates = []
+
+
+class TestCustomTqdmClassNonTty(CapsysBaseTest):
+    def test_non_tty_environment_is_reproduced(self) -> None:
+        """Sanity check: the environment of this test is indeed a non-TTY one.
+
+        This is what makes the issue reproducible: tqdm's auto-detection kicks in when
+        `disable=None` and disables the bar.
+        """
+        # This is what makes the issue reproducible: tqdm's auto-detection (disable=None +
+        # `sys.stderr.isatty()`) disables the bar. This assertion would fail in a real TTY.
+        assert base_tqdm(total=1, disable=None).disable is True
+
+    def test_custom_tqdm_class_is_not_disabled(self) -> None:
+        bar = _get_progress_bar_context(
+            desc="file.bin",
+            log_level=logging.WARNING,
+            total=10,
+            tqdm_class=MyProgress,
+        )
+        assert bar.disable is False, "custom tqdm_class must not be silently disabled by TTY auto-detection"
+
+        for _ in range(5):
+            bar.update(1)
+
+        assert bar.n == 5
+        assert len(bar.updates) == 5
+        assert bar.updates[-1] == (5, 10)
+
+    def test_custom_tqdm_class_in_hf_hub_download(self) -> None:
+        """End-to-end through the public `hf_hub_download` code path, against a local HTTP
+        server, in a non-TTY process. This mirrors the issue's reproduction snippet: the
+        custom `update()` is called but used to leave `self.n` at 0."""
+        import hashlib
+        import http.server
+        import os
+        import socketserver
+        import tempfile
+        import threading
+
+        from huggingface_hub import hf_hub_download
+
+        MyProgress.reset()
+        payload = b"x" * 5000
+        sha = hashlib.sha256(payload).hexdigest()
+        commit = "0" * 40
+
+        class Handler(http.server.BaseHTTPRequestHandler):
+            def _write_headers(self):
+                self.send_response(200)
+                self.send_header("Content-Length", str(len(payload)))
+                self.send_header("X-Repo-Commit", commit)
+                self.send_header("X-Linked-Etag", f'"{sha}"')
+                self.send_header("ETag", f'"{sha}"')
+                self.end_headers()
+
+            def do_HEAD(self):
+                self._write_headers()
+
+            def do_GET(self):
+                self._write_headers()
+                self.wfile.write(payload)
+
+            def log_message(self, *args):  # silence
+                pass
+
+        with socketserver.TCPServer(("127.0.0.1", 0), Handler) as server:
+            port = server.server_address[1]
+            threading.Thread(target=server.serve_forever, daemon=True).start()
+            try:
+                with tempfile.TemporaryDirectory() as cache_dir:
+                    path = hf_hub_download(
+                        repo_id="fake/repo",
+                        filename="f.bin",
+                        cache_dir=cache_dir,
+                        endpoint=f"http://127.0.0.1:{port}",
+                        tqdm_class=MyProgress,
+                    )
+                    assert os.path.getsize(path) == len(payload)
+            finally:
+                server.shutdown()
+
+        assert MyProgress.all_updates, "custom update() was never called"
+        assert MyProgress.all_updates[-1][0] == len(payload), f"custom update() was a no-op: {MyProgress.all_updates}"
+
+    def test_default_progress_bar_still_auto_detected(self) -> None:
+        """Guardrail: without an explicit `tqdm_class`, the default behaviour is unchanged
+        (TTY auto-detection + `log_level=NOTSET` disabling)."""
+        bar = _get_progress_bar_context(desc="file.bin", log_level=logging.NOTSET, total=1)
+        assert bar.disable is True
+
+        bar = _get_progress_bar_context(desc="file.bin", log_level=logging.WARNING, total=1)
+        assert bar.disable is True  # non-TTY auto-detection still applies for the default class
