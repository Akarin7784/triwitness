+class TestCustomTqdmClassProgressBar(CapsysBaseTest):
+    """Regression tests for https://github.com/huggingface/huggingface_hub/issues/3663.
+
+    A user-provided `tqdm_class` must not be silently disabled by tqdm's TTY auto-detection
+    (`disable=None` + `sys.stderr.isatty()`), which is always `False` in non-TTY environments
