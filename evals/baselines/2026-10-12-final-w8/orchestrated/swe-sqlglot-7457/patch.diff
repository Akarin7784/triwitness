diff --git a/tests/tw_repro/test_issue_ai_forecast.py b/tests/tw_repro/test_issue_ai_forecast.py
new file mode 100644
index 0000000..036f9a2
--- /dev/null
+++ b/tests/tw_repro/test_issue_ai_forecast.py
@@ -0,0 +1,53 @@
+"""Reproduction for: BigQuery AI.FORECAST TVF syntax fails to parse.
+
+Issue: 'SELECT * FROM AI.FORECAST(TABLE citibike_trips, data_col => "num_trips",
+timestamp_col => "date", horizon => 30)' raises
+``sqlglot.errors.ParseError: Invalid expression / Unexpected token``.
+"""
+
+import unittest
+
+from sqlglot import exp
+
+from tests.dialects.test_dialect import Validator
+
+
+class TestBigQueryAIForecastIssue(Validator):
+    dialect = "bigquery"
+
+    def test_ai_forecast_tvf_parses(self):
+        # (a) the exact SQL from the Issue (double quotes are string literals in BigQuery)
+        #     must parse without raising, producing an AIForecast node.
+        sql = (
+            'SELECT * FROM AI.FORECAST(TABLE citibike_trips, data_col => "num_trips", '
+            'timestamp_col => "date", horizon => 30)'
+        )
+        ast = self.parse_one(sql)
+        self.assertIsNotNone(ast.find(exp.AIForecast))
+
+        # (b) round-trip: BigQuery normalizes double-quoted strings to single quotes.
+        self.validate_identity(
+            "SELECT * FROM AI.FORECAST(TABLE citibike_trips, data_col => 'num_trips', "
+            "timestamp_col => 'date', horizon => 30)"
+        )
+
+    def test_ai_forecast_subquery_and_extra_args(self):
+        self.validate_identity(
+            "SELECT * FROM AI.FORECAST((SELECT * FROM citibike_trips), data_col => 'num_trips', "
+            "timestamp_col => 'date', horizon => 30, confidence_level => 0.9)"
+        )
+
+    def test_ml_forecast_still_works(self):
+        # sanity: ML.FORECAST must keep behaving as before
+        ast = self.validate_identity(
+            "SELECT * FROM ML.FORECAST(MODEL `mydataset.mymodel`, STRUCT(2 AS horizon))"
+        )
+        self.assertIsNotNone(ast.find(exp.MLForecast))
+        self.validate_identity(
+            "SELECT * FROM ML.FORECAST(MODEL `mydataset.mymodel`, TABLE `mydataset.mybqtable`, "
+            "STRUCT(2 AS horizon, 4 AS confidence_level))"
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
